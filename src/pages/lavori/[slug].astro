---
// src/pages/lavori/[slug].astro — case study italiano, gemello di
// src/pages/en/work/[slug].astro ma con project.it e project.tagIt al posto
// di project.en e project.stack (niente nomi di tecnologie sul lato italiano,
// vedi task-11-brief.md). Le rotte generate sono un sottoinsieme di
// `projects`: solo i dieci progetti con una scheda vera (gli altri due,
// Paesello e il video generativo, vivono solo come righe in /lavori).
import BaseLayout from '../../layouts/BaseLayout.astro';
import StackChip from '../../components/StackChip.astro';
import { projects, getProject } from '../../data/projects';
import { site } from '../../data/site';
import { localizedPath } from '../../i18n/ui';
import { annoIt } from '../../lib/anno';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug } }));
}
const { slug } = Astro.params;
const project = getProject(slug!)!;
const c = project.it;
const path = `/lavori/${project.slug}`;
// I progetti `soloItaliano` (Portale ricambi, Grip) non hanno una rotta
// /en/work/[slug] (§10 della spec, fix in projects.ts): niente alternato
// inglese per le loro schede (task 1/bloccante).
const pathEn = project.soloItaliano ? undefined : `/work/${project.slug}`;
const t = site.it;
---
<BaseLayout title={`${project.name} — Alessandro Flaborea`} description={c.summary} lang="it" path={path} pathEn={pathEn} ogType="article" attiva="lavori">
  <article class="container case">
    {/* «Lavori selezionati» (t.caseStudy.back) è condiviso con la pagina
        inglese; qui la destinazione è /lavori, il cui h1 dice «Quello che
        ho costruito» — testo alla lettera da lì, non da t.caseStudy.back
        (task 8, revisione finale del ramo sito-italiano). */}
    <a class="back" href={localizedPath('it', '/lavori')}>← Quello che ho costruito</a>
    <p class="label">{c.area} · {project.role} · {annoIt(project.year)}</p>
    <h1>{project.name}</h1>
    <p class="lead muted">{c.summary}</p>
    <div class="chips">{project.tagIt.map((s) => <StackChip label={s} />)}</div>
    {/* Le due schede nuove (Portale ricambi, Grip) hanno un solo
        paragrafo di copy in testi.md: un campo lasciato vuoto in
        projects.ts salta la sua sezione invece di renderizzare
        un'intestazione senza corpo (correzione giro 1, task-11-report.md). */}
    {c.problem && <section><h2>{t.caseStudy.problem}</h2><p>{c.problem}</p></section>}
    {c.approach && <section><h2>{t.caseStudy.approach}</h2><p>{c.approach}</p></section>}
    {c.result && <section><h2>{t.caseStudy.result}</h2><p>{c.result}</p></section>}
    {(project.url || project.repo) && (
      <section class="links">
        {project.url && <a href={project.url} target="_blank" rel="noopener noreferrer">{t.workLiveLabel} ↗</a>}
        {project.repo && <a href={project.repo} target="_blank" rel="noopener noreferrer">{t.workCodeLabel} ↗</a>}
      </section>
    )}
    <!-- media (screenshot / video) va qui quando disponibile -->
  </article>
</BaseLayout>
<style>
  .case { max-width: 720px; padding-top: 6rem; padding-bottom: 4rem; }
  .case h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0.5rem 0; }
  .case .lead { font-size: 1.15rem; margin-bottom: 1rem; }
  .case .chips { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .case section { padding: 1.25rem 0; border-top: 1px solid var(--border); }
  .case h2 { font-size: 1.25rem; margin-bottom: 0.5rem; }
  .back { font-size: 0.85rem; color: var(--accent); }
  .links { display: flex; gap: 1.25rem; }
</style>
