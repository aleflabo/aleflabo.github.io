---
// src/pages/chi-sono.astro — rotta `/chi-sono`.
// Il corpo, con il suo stile, vive in CorpoChiSono.astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import CorpoChiSono from '../components/pagine/CorpoChiSono.astro';
import { chiSono } from '../data/chiSono';
import { testiChiSonoPagina } from '../data/chiSonoPagina';
import DaDoveViene from '../components/sezioni/DaDoveViene.astro';
import Territorio from '../components/sezioni/Territorio.astro';
import { daDoveViene } from '../data/home';
import { territorio } from '../data/territorio';
---

<BaseLayout
  title="Chi sono — Alessandro Flaborea"
  description={chiSono.paragrafi[0]}
  lang="it"
  path="/chi-sono"
  pathEn="/about"
  attiva="chi-sono"
>
  {/* Gli occhielli sovrascritti a `undefined` sono la potatura del primo giro:
      il perché sta in CorpoChiSono.astro, le stringhe restano nei dati. */}
  <CorpoChiSono lang="it" t={{ ...testiChiSonoPagina, labelComeLavoro: undefined, labelFuori: undefined }} chiSono={chiSono} hrefLavori="/lavori">
    <Fragment slot="dopo-biografia">
      <DaDoveViene {...daDoveViene} />
      <Territorio {...territorio.it} />
    </Fragment>
  </CorpoChiSono>
</BaseLayout>
