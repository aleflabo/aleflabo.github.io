---
// src/pages/chi-sono.astro — la biografia e le abitudini di lavoro (rotta `/chi-sono`).
// Misure e struttura alla lettera da tavole/ChiSono.dc.html; testo alla
// lettera da testi.md, sezione «/chi-sono» (task-13-brief.md). I paragrafi
// della biografia, «in breve» e le tre abitudini vengono da
// src/data/chiSono.ts (task 6): non riscritti qui. I paragrafi 1 e 2
// contengono riferimenti geografici (Udine, Svezia, Roma, Amsterdam): sono
// corretti, il vincolo «nessun riferimento geografico» riguarda il
// posizionamento commerciale, non la biografia — vedi la nota in
// chiSono.ts. L'etichetta «In breve» e il paragrafo «Fuori dal lavoro» non
// sono fra gli export di quel file e restano scritti qui, alla lettera
// dalla tavola — come già fa ComeLavoro.astro per il proprio testo nella
// home. Il riquadro della fotografia resta un segnaposto dichiarato
// (fondo #efece7, bordo tratteggiato) finché non c'è una foto vera. Il
// pulsante «Scarica il curriculum» resta inerte (`href="#"`): il PDF non è
// ancora collegato.
import BaseLayout from '../layouts/BaseLayout.astro';
import TestataPagina from '../components/TestataPagina.astro';
import { chiSono } from '../data/chiSono';
import { localizedPath } from '../i18n/ui';
---

<BaseLayout
  title="Chi sono — Alessandro Flaborea"
  description="Ho cominciato a Udine, con una laurea in informatica e sei mesi in Svezia che mi hanno tolto l'idea di restare fermo."
  lang="it"
  path="/chi-sono"
  attiva="chi-sono"
>
  <section class="biografia">
    <div class="container">
      <div class="griglia">
        <div class="colonna-foto">
          <div class="segnaposto-foto">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#8f8578" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-4.5-4.5L9 18"></path></svg>
            <p class="segnaposto-titolo">[ LA TUA FOTO ]</p>
            <p class="segnaposto-nota">Sguardo in camera, luce naturale, sfondo neutro. Niente giacca se non la porti mai: chi ti incontra poi deve riconoscerti.</p>
          </div>
          <div class="in-breve">
            <p class="label">In breve</p>
            {chiSono.inBreve.map((riga) => (
              <p class="riga-in-breve">{riga}</p>
            ))}
          </div>
        </div>

        <div class="colonna-bio"> <TestataPagina occhiello="Chi sono" titolo="Alessandro Flaborea" /><div class="paragrafi">
            {chiSono.paragrafi.map((p, i) => (
              <p class:list={['corpo', { primo: i === 0 }]}>{p}</p>
            ))}
          </div>
          <div class="cta-row">
            <a class="pulsante primaria" href={`${localizedPath('it', '/')}#parliamone`}>Prenota la mezza giornata diagnostica</a>
            <a class="pulsante secondaria" href="#">Scarica il curriculum</a>
            <a class="pulsante secondaria" href={localizedPath('it', '/lavori')}>Quello che ho costruito</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="abitudini">
    <div class="container">
      <p class="label">Come lavoro, in concreto</p>
      <h2 class="section-title">Abitudini che vale la pena sapere prima</h2>
      <div class="griglia-abitudini">
        {chiSono.abitudini.map((a) => (
          <div>
            <h3>{a.titolo}</h3>
            <p class="corpo">{a.testo}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="fuori-dal-lavoro">
    <div class="container">
      <p class="label">Fuori dal lavoro</p>
      <p class="corpo">Il filo che tiene insieme tutto è la curiosità, per problemi nuovi, posti nuovi e persone nuove. Mi ha portato da Udine a Roma e da Göteborg ad Amsterdam, e continua a decidere cosa costruisco nei fine settimana.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 24px;
  }

  /* --- biografia --- */
  .biografia {
    padding: 0;
  }
  .biografia .container {
    padding: 72px 24px 60px;
  }
  .griglia {
    display: grid;
    grid-template-columns: 340px minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }

  /* --- colonna foto --- */
  .segnaposto-foto {
    width: 100%;
    aspect-ratio: 4 / 5;
    background: #efece7;
    border: 1px dashed #b9b1a4;
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 24px;
    text-align: center;
  }
  .segnaposto-titolo {
    font-size: 13px;
    font-weight: 600;
    color: #6f6659;
    letter-spacing: 0.06em;
  }
  .segnaposto-nota {
    font-size: 12.5px;
    line-height: 1.55;
    color: #8f8578;
  }
  .in-breve {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-top: 1px solid var(--border);
    padding-top: 22px;
  }
  .riga-in-breve {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* --- colonna bio ---
     Qui TestataPagina porta solo occhiello/titolo/filetto: la
     «introduzione» del componente presuppone una sola frase, mentre qui
     la biografia sono cinque paragrafi con una gerarchia propria (il
     primo più grande, gli altri no) — non la stessa cosa, non passata
     come prop. Le misure di titolo e filetto restano quelle della tavola
     (42px, non i 46px del caso maggioritario; 28px invece di 30px),
     quindi restano come override sull'elemento reso dal componente. */
  .colonna-bio :global(h1) {
    margin-top: 20px;
    font-size: 42px;
    max-width: 20ch;
  }
  .colonna-bio :global(.divider) {
    margin: 28px 0;
  }
  .paragrafi {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 62ch;
  }
  .paragrafi .corpo {
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--text-muted);
  }
  .paragrafi .corpo.primo {
    font-size: 18px;
    line-height: 1.65;
    color: var(--text);
  }
  .cta-row {
    display: flex;
    gap: 14px;
    margin-top: 34px;
    flex-wrap: wrap;
  }
  .cta-row .primaria {
    background: var(--azione);
    color: var(--surface);
    font-size: 15px;
    font-weight: 600;
    padding: 14px 28px;
    border-radius: var(--radius);
  }
  .cta-row .secondaria {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 13px 24px;
  }

  /* --- abitudini --- */
  .abitudini {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding: 0;
  }
  .abitudini .container {
    padding: 64px 24px;
  }
  .section-title {
    font-size: 28px;
    margin-top: 18px;
    margin-bottom: 34px;
    max-width: 30ch;
  }
  .griglia-abitudini {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 34px;
  }
  .griglia-abitudini h3 {
    font-size: 19px;
  }
  .griglia-abitudini .corpo {
    margin-top: 12px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  /* --- fuori dal lavoro --- */
  .fuori-dal-lavoro {
    border-top: 1px solid var(--border);
    padding: 0;
  }
  .fuori-dal-lavoro .container {
    padding: 56px 24px;
  }
  .fuori-dal-lavoro .label {
    margin-bottom: 20px;
  }
  .fuori-dal-lavoro .corpo {
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 62ch;
  }

  @media (max-width: 640px) {
    .biografia .container {
      padding: 44px 20px 44px;
    }
    .griglia {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .colonna-foto {
      max-width: 280px;
    }
    .colonna-bio :global(h1) {
      font-size: 30px;
    }
    .paragrafi {
      max-width: none;
    }
    .paragrafi .corpo.primo {
      font-size: 16.5px;
    }
    .paragrafi .corpo {
      font-size: 15.5px;
    }
    .cta-row {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }
    .cta-row a {
      text-align: center;
    }
    .abitudini .container,
    .fuori-dal-lavoro .container {
      padding: 44px 20px;
    }
    .section-title {
      font-size: 24px;
      margin-bottom: 22px;
      max-width: none;
    }
    .griglia-abitudini {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    .fuori-dal-lavoro .corpo {
      max-width: none;
    }
  }
</style>
