---
// src/pages/chi-sono.astro — rotta `/chi-sono`.
// Il corpo, con il suo stile, vive in CorpoChiSono.astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import CorpoChiSono from '../components/pagine/CorpoChiSono.astro';
import { chiSono } from '../data/chiSono';
import { testiChiSonoPagina } from '../data/chiSonoPagina';
---

<BaseLayout
  title="Chi sono — Alessandro Flaborea"
  description={chiSono.paragrafi[0]}
  lang="it"
  path="/chi-sono"
  pathEn="/about"
  attiva="chi-sono"
>
  <CorpoChiSono lang="it" t={testiChiSonoPagina} chiSono={chiSono} hrefLavori="/lavori" />
</BaseLayout>
