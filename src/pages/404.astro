---
// src/pages/404.astro — la pagina che GitHub Pages serve per qualsiasi
// indirizzo che non esiste.
//
// **È una sola per tutto il sito.** GitHub Pages restituisce `/404.html` con
// stato 404 a prescindere dal percorso richiesto, quindi non può essercene una
// italiana e una inglese: questa parla italiano, che è la lingua canonica, e
// chiude con una riga in inglese per chi arrivava da `/en/`.
//
// La home aveva uno script che leggeva la lingua del browser e rimbalzava su
// `/en/` chi non aveva l'italiano davanti. Qui non c'era, perché avrebbe
// mandato altrove chi ha appena sbagliato indirizzo; dal 27 agosto 2026 non
// c'è più nemmeno lì — vedi il commento in LangSwitch.astro.
//
// Niente `<meta name="robots" content="noindex">`: GitHub Pages serve questo
// file con stato HTTP 404, ed è quello che i motori di ricerca guardano. Il
// meta servirebbe solo se la pagina rispondesse 200, e aggiungerlo avrebbe
// richiesto di toccare BaseLayout, che è condiviso con le altre trentaquattro.
import BaseLayout from '../layouts/BaseLayout.astro';
import { localizedPath } from '../i18n/ui';

const scorciatoie = [
  { testo: 'La home', href: localizedPath('it', '/') },
  { testo: 'I servizi', href: localizedPath('it', '/servizi') },
  { testo: 'I lavori', href: localizedPath('it', '/lavori') },
  { testo: 'Le note', href: localizedPath('it', '/note') },
];
---

<BaseLayout
  title="Pagina non trovata — Alessandro Flaborea"
  description="L'indirizzo cercato non esiste, o è cambiato."
  lang="it"
  path="/404"
  paginaErrore={true}
>
  <section class="quattroquattro">
    <div class="container">
      <div class="codice-box">
        <span class="codice mono">404<span class="riquadro" aria-hidden="true"><em class="mono">not_found · 1.00</em></span></span>
      </div>
      <div class="testo">
        <h1>Questa pagina non c'è</h1>
        <p class="intro">L'indirizzo potrebbe essere cambiato, oppure non è mai esistito. Da qui si riparte:</p>
        <ul class="scorciatoie">
          {scorciatoie.map((s) => (
            <li><a href={s.href}>{s.testo} <span class="freccia">&rarr;</span></a></li>
          ))}
        </ul>
        <p class="inglese" lang="en">
          This page doesn't exist. <a href={localizedPath('en', '/')}>Go to the English site &rarr;</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* La 404 del Laboratorio: «404» in mono con il riquadro di detection, come
     la foto della home (mockup, scheda «A · Pagine interne»). */
  .quattroquattro { padding: 0; border-bottom: 1px solid var(--filo); }
  .container {
    max-width: var(--maxw-lab);
    margin: 0 auto;
    border-inline: 1px solid var(--filo);
    padding: 64px 28px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px;
    align-items: center;
  }
  .codice { position: relative; display: inline-block; font-size: clamp(6rem, 16vw, 11rem); font-weight: 500; line-height: 0.85; letter-spacing: -0.06em; }
  .riquadro { position: absolute; inset: -6% -4%; border: 2px solid var(--rilevamento); }
  .riquadro em {
    position: absolute;
    top: -22px;
    left: -2px;
    background: var(--rilevamento-testo);
    color: var(--bianco);
    font-size: 0.6875rem;
    font-style: normal;
    letter-spacing: 0;
    padding: 3px 6px;
    white-space: nowrap;
  }
  h1 { font-size: 2rem; letter-spacing: -0.04em; }
  .intro { margin-top: 10px; color: var(--muto); }
  .scorciatoie { list-style: none; margin: 16px 0 0; padding: 0; border-top: 1px solid var(--filo); }
  .scorciatoie li { border-bottom: 1px solid var(--filo); }
  .scorciatoie a { display: block; padding: 12px 0; font-weight: 500; }
  .inglese { margin-top: 18px; font-size: 0.875rem; color: var(--muto); }
  @media (max-width: 820px) {
    .container { grid-template-columns: 1fr; padding: 48px 16px; }
  }
</style>
