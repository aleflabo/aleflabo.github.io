---
// src/pages/i-vostri-dati.astro — rotta `/i-vostri-dati`.
// Il corpo, con il suo stile, vive in CorpoDati.astro. Questa resta la
// pagina più delicata del sito: nessuna parola qui rafforza o ammorbidisce
// quanto scritto in dati.ts. Non è nel menu — si raggiunge dal piè di pagina
// e dalla FAQ — quindi <BaseLayout> non riceve `attiva`.
import BaseLayout from '../layouts/BaseLayout.astro';
import CorpoDati from '../components/pagine/CorpoDati.astro';
import {
  situazioniDati,
  rispostaCorta,
  quelloCheNonPossoGarantirvi,
  suQuestoHoLavoratoDavvero,
} from '../data/dati';
import { testiDatiPagina } from '../data/datiPagina';
---

<BaseLayout
  title="Che fine fanno i vostri dati — Alessandro Flaborea"
  description={rispostaCorta.intro}
  lang="it"
  path="/i-vostri-dati"
  pathEn="/your-data"
>
  <CorpoDati
    lang="it"
    t={testiDatiPagina}
    situazioniDati={situazioniDati}
    rispostaCorta={rispostaCorta}
    quelloCheNonPossoGarantirvi={quelloCheNonPossoGarantirvi}
    suQuestoHoLavoratoDavvero={suQuestoHoLavoratoDavvero}
  />
</BaseLayout>
