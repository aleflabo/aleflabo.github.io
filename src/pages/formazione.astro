---
// src/pages/formazione.astro — rotta `/formazione`.
// Il corpo, con il suo stile, vive in CorpoFormazione.astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import CorpoFormazione from '../components/pagine/CorpoFormazione.astro';
import { corsi, testiCorsi, riquadroAiAct, dettagliPratici, cosaResta, faqAiAct, strade } from '../data/formazione';
import { policy } from '../data/servizi';
import { testiFormazionePagina } from '../data/formazionePagina';
import { site } from '../data/site';
import { briciole, corso } from '../lib/datiStrutturati';
import { localizedPath } from '../i18n/ui';

// I corsi come `Course`. L'AI Act di febbraio 2025 rende la formazione
// un obbligo documentabile, quindi «corso AI obbligatorio» è una domanda che
// viene fatta davvero: dichiararli aiuta a farsi trovare da quella.
const dominio = Astro.site!.toString().replace(/\/$/, '');
const datiStrutturati = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: corsi.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: corso(dominio, { nome: c.nome, descrizione: c.livelli.map((l) => `${l.durata}: ${l.moduli.join('; ')}`).join(' · ') }),
    })),
  },
  briciole(dominio, [
    { nome: 'Home', percorso: localizedPath('it', '/') },
    { nome: 'Formazione', percorso: localizedPath('it', '/formazione') },
  ]),
];
---

<BaseLayout
  title="Formazione — Alessandro Flaborea"
  description={testiFormazionePagina.introduzione}
  lang="it"
  path="/formazione"
  pathEn="/training"
  attiva="formazione"
  datiStrutturati={datiStrutturati}
>
  {/* Gli occhielli sovrascritti a `undefined` sono la potatura del primo giro:
      il perché sta in CorpoFormazione.astro, le stringhe restano nei dati. */}
  <CorpoFormazione
    lang="it"
    t={{ ...testiFormazionePagina, labelOrganizza: undefined, labelCattedra: undefined, labelOnesta: undefined }}
    corsi={corsi}
    testiCorsi={testiCorsi}
    riquadroAiAct={riquadroAiAct}
    dettagliPratici={dettagliPratici}
    cosaResta={cosaResta}
    faqAiAct={faqAiAct}
    policy={policy}
    strade={strade}
    prenotaMezzora={site.it.prenotaMezzora ?? ''}
  />
</BaseLayout>
