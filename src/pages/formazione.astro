---
// src/pages/formazione.astro — i tre formati, il riquadro sull'AI Act e le
// tre strade (rotta `/formazione`).
// Testo alla lettera da tavole/Formazione.dc.html (testi.md, sezione
// «/formazione»). `formati`, `riquadroAiAct` e `strade` vengono da
// src/data/formazione.ts (task 6): non riscritti qui. I blocchi «Vengo
// dall'aula», «Che cosa questo corso non è» e «Chi sostiene il costo del
// corso» (titolo ed etichetta) non hanno un campo in quel file — restano
// scritti qui, alla lettera dalla tavola, come già fa ComeLavoro.astro
// per il proprio testo nella home.
import BaseLayout from '../layouts/BaseLayout.astro';
import { formati, riquadroAiAct, strade } from '../data/formazione';
import { localizedPath } from '../i18n/ui';
---

<BaseLayout
  title="Formazione — Alessandro Flaborea"
  description="In aula si lavora sui documenti dell'azienda e sui casi che capitano davvero. L'obiettivo è che ognuno esca con qualcosa che può mettere in pratica subito."
  lang="it"
  path="/formazione"
  attiva="formazione"
>
  <section class="intestazione">
    <div class="container">
      <p class="label">Formazione</p>
      <h1>Corsi che si usano il giorno dopo</h1>
      <div class="divider"></div>
      <p class="intro">In aula si lavora sui documenti dell'azienda e sui casi che capitano davvero. L'obiettivo è che ognuno esca con qualcosa che può mettere in pratica subito.</p>
    </div>
  </section>

  <section class="avviso-ai-act">
    <div class="container">
      <div class="riquadro">
        <p class="riquadro-label">{riquadroAiAct.titolo}</p>
        {riquadroAiAct.corpo.map((p, i) => (
          <p class:list={['riquadro-corpo', { muto: i > 0 }]}>{p}</p>
        ))}
        <a class="riquadro-link" href={localizedPath('it', riquadroAiAct.link.href)}>{riquadroAiAct.link.testo} <span class="freccia">&rarr;</span></a>
      </div>
    </div>
  </section>

  <section class="elenco-formati">
    <div class="container">
      <div class="schede">
        {formati.map((f) => (
          <div class="scheda formato">
            <div class="descrizione">
              <p class="eyebrow">{f.ore}</p>
              <h2>{f.nome}</h2>
              <p class="corpo">{f.corpo}</p>
            </div>
            <div class="dettagli">
              <div>
                <p class="dettaglio-etichetta">Per chi</p>
                <p class="dettaglio-valore">{f.perChi}</p>
              </div>
              <div>
                <p class="dettaglio-etichetta">Serve da voi</p>
                <p class="dettaglio-valore">{f.serveDaVoi}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="come-si-organizza">
    <div class="container">
      <p class="label">Come si organizza</p>
      <h2 class="section-title">Chi sostiene il costo del corso</h2>
      <div class="griglia-strade">
        {strade.map((s) => (
          <div>
            <h3>{s.titolo}</h3>
            <p class="corpo">{s.testo}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="aula-onesta">
    <div class="container">
      <div class="colonne">
        <div>
          <p class="label">Chi sale in cattedra</p>
          <h2 class="section-title">Vengo dall'aula</h2>
          <p class="corpo">Quattro anni come assistente alla didattica alla Sapienza, dal 2019 al 2023, durante il dottorato. Poi due anni a costruire software che le persone usano ogni giorno. In aula servono entrambe: la prima per riuscire a farsi capire, la seconda per insegnare cose che in azienda reggono.</p>
          <p class="corpo">Sono stato anche relatore invitato al Data Science Hub di Ferrari S.p.A.</p>
        </div>
        <div>
          <p class="label">Onestà</p>
          <h2 class="section-title">Che cosa questo corso non è</h2>
          <div class="righe">
            <p class="corpo">Non è un corso di programmazione. Si lavora sugli strumenti che esistono già e su come portarli nel lavoro di tutti i giorni. Scrivere codice e addestrare modelli è un percorso a parte.</p>
            <p class="corpo">Non ci sono formule pronte da copiare. Le liste di trucchi smettono di funzionare al primo cambio di modello, mentre aver capito come ragiona lo strumento resta.</p>
            <p class="corpo">Non arrivo con una percentuale di risparmio già scritta sulle slide. Prima di aver visto come lavorate sarebbe un numero inventato.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-azienda">
    <div class="container">
      <h2>Raccontami che azienda siete</h2>
      <p class="intro">Quante persone siete, cosa fate e chi userebbe questi strumenti. Da lì si capisce quale delle tre strade conviene.</p>
      <div class="pulsanti">
        <a class="pulsante primario" href={`${localizedPath('it', '/')}#parliamone`}>Prenota mezz'ora</a>
        <a class="pulsante secondario" href="#">WhatsApp</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 24px;
  }

  /* --- intestazione --- */
  .intestazione {
    padding: 0;
  }
  .intestazione .container {
    padding: 72px 24px 44px;
  }
  .intestazione h1 {
    margin-top: 20px;
    font-size: 46px;
    max-width: 24ch;
  }
  .intestazione .divider {
    margin: 30px 0;
  }
  .intestazione .intro {
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 62ch;
    text-wrap: pretty;
  }

  /* --- riquadro AI Act --- */
  .avviso-ai-act {
    padding: 0;
  }
  .avviso-ai-act .container {
    padding: 0 24px 56px;
  }
  .riquadro {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    padding: 30px 34px;
    max-width: 860px;
  }
  .riquadro-label {
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--azione);
    font-weight: 700;
  }
  .riquadro-corpo {
    margin-top: 14px;
    font-size: 16.5px;
    line-height: 1.65;
    color: var(--text);
  }
  .riquadro-corpo.muto {
    color: var(--text-muted);
  }
  .riquadro-link {
    display: inline-block;
    margin-top: 18px;
    font-size: 15px;
    font-weight: 600;
  }

  /* --- i tre formati --- */
  .elenco-formati {
    padding: 0;
  }
  .elenco-formati .container {
    padding: 0 24px 72px;
  }
  .schede {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .formato {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 34px;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 40px;
  }
  .formato .eyebrow {
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--azione);
    font-weight: 700;
  }
  .formato .descrizione h2 {
    font-size: 26px;
    margin-top: 12px;
  }
  .formato .descrizione .corpo {
    margin-top: 14px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-muted);
  }
  .formato .dettagli {
    border-left: 1px solid var(--border);
    padding-left: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .formato .dettaglio-etichetta {
    font-size: 11.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--azione);
    font-weight: 700;
  }
  .formato .dettaglio-valore {
    margin-top: 6px;
    font-size: 14.5px;
    line-height: 1.6;
  }

  /* --- come si organizza --- */
  .come-si-organizza {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding: 0;
  }
  .come-si-organizza .container {
    padding: 72px 24px;
  }
  .section-title {
    font-size: 30px;
    margin-top: 18px;
    margin-bottom: 34px;
    max-width: 26ch;
  }
  .griglia-strade {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  .griglia-strade h3 {
    font-size: 19px;
  }
  .griglia-strade .corpo {
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  /* --- vengo dall'aula / che cosa non è --- */
  .aula-onesta {
    border-top: 1px solid var(--border);
    padding: 0;
  }
  .aula-onesta .container {
    padding: 72px 24px;
  }
  .colonne {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
  }
  .colonne .section-title {
    font-size: 28px;
    margin-bottom: 0;
    max-width: 22ch;
  }
  .colonne .corpo {
    margin-top: 18px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-muted);
  }
  .colonne .righe {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 18px;
  }
  .colonne .righe .corpo {
    margin-top: 0;
  }

  /* --- raccontami che azienda siete --- */
  .cta-azienda {
    border-top: 1px solid var(--border);
    background: var(--accent);
    padding: 0;
  }
  .cta-azienda .container {
    padding: 60px 24px;
  }
  .cta-azienda h2 {
    font-size: 30px;
    color: var(--surface);
    max-width: 26ch;
  }
  .cta-azienda .intro {
    margin-top: 16px;
    font-size: 16px;
    line-height: 1.6;
    color: #cdd9e6;
    max-width: 56ch;
  }
  .pulsanti {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 30px;
    flex-wrap: wrap;
  }
  .pulsante.primario {
    background: var(--surface);
    color: var(--accent);
    font-size: 15px;
    font-weight: 600;
    padding: 14px 30px;
    border-radius: var(--radius);
  }
  .pulsante.secondario {
    font-size: 15px;
    color: var(--surface);
    border: 1px solid #6d8aa8;
    border-radius: var(--radius);
    padding: 13px 24px;
  }

  @media (max-width: 640px) {
    .intestazione .container {
      padding: 44px 20px 36px;
    }
    .intestazione h1 {
      margin-top: 16px;
      font-size: 32px;
      max-width: none;
      text-wrap: pretty;
    }
    .intestazione .divider {
      margin: 22px 0;
    }
    .intestazione .intro {
      font-size: 16px;
      max-width: none;
    }
    .avviso-ai-act .container {
      padding: 0 20px 40px;
    }
    .riquadro {
      padding: 24px 22px;
    }
    .elenco-formati .container {
      padding: 0 20px 48px;
    }
    .formato {
      grid-template-columns: 1fr;
      gap: 22px;
      padding: 26px 22px;
    }
    .formato .descrizione h2 {
      font-size: 23px;
    }
    .formato .dettagli {
      border-left: none;
      padding-left: 0;
      padding-top: 20px;
      border-top: 1px solid var(--border);
    }
    .come-si-organizza .container,
    .aula-onesta .container {
      padding: 48px 20px;
    }
    .section-title {
      font-size: 24px;
      margin-bottom: 24px;
      max-width: none;
    }
    .griglia-strade {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .colonne {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .colonne .section-title {
      font-size: 24px;
      max-width: none;
    }
    .cta-azienda .container {
      padding: 44px 20px;
    }
    .cta-azienda h2 {
      font-size: 24px;
      max-width: none;
    }
    .cta-azienda .intro {
      font-size: 15px;
      max-width: none;
    }
    .pulsanti {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }
    .pulsanti a {
      text-align: center;
    }
  }
</style>
