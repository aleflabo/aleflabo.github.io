---
// src/pages/note/[slug].astro — una nota per intero (rotta `/note/<slug>`).
//
// Prima di questa pagina le note erano righe che puntavano a `href="#"`:
// esisteva l'elenco, non l'articolo. Le rotte nascono dagli slug pubblicati
// su Sanity, quindi una nota tolta dallo Studio sparisce dal sito alla
// ricostruzione successiva invece di restare come pagina orfana.
//
// `pathEn` viene passato solo per le note tradotte: BaseLayout dichiara
// l'alternato e Nav mostra l'interruttore di lingua soltanto quando la
// gemella esiste davvero. Sulle altre, chi legge in inglese resta qui — è
// l'unica pagina che c'è.
import '../../styles/note.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TestataPagina from '../../components/TestataPagina.astro';
import CorpoNota from '../../components/CorpoNota.astro';
import { localizedPath } from '../../i18n/ui';
import { dataIt } from '../../lib/dataNota';
import { tradotta, tutteLeNote } from '../../lib/note';
import type { Nota } from '../../lib/note';

export async function getStaticPaths() {
  const note = await tutteLeNote();
  return note.map((nota) => ({ params: { slug: nota.slug }, props: { nota } }));
}

const { nota } = Astro.props as { nota: Nota };
---

<BaseLayout
  title={`${nota.titolo} — Alessandro Flaborea`}
  description={nota.sommario}
  lang="it"
  path={`/note/${nota.slug}`}
  pathEn={tradotta(nota) ? `/notes/${nota.slug}` : undefined}
  ogType="article"
  attiva="note"
>
  <div class="pagina-note">
  <section class="intestazione">
    <div class="container">
      <TestataPagina percorso="← /note" titolo={nota.titolo} />
      <p class="meta">
        <span class="data">{dataIt(nota.data)}</span>
        {nota.tag.map((t) => <span class="tag">{t}</span>)}
      </p>
    </div>
  </section>

  <section class="articolo">
    <div class="container">
      <p class="sommario">{nota.sommario}</p>
      <CorpoNota valore={nota.corpo} />
      <a class="indietro" href={localizedPath('it', '/note')}>Tutte le note <span class="freccia">&larr;</span></a>
    </div>
  </section>
  </div>
</BaseLayout>

