---
// src/pages/en/notes/[slug].astro — gemella inglese di
// src/pages/note/[slug].astro (rotta `/en/notes/<slug>`).
//
// Esiste **solo** per le note tradotte: `getStaticPaths` filtra su
// `tradotta()`, che pretende titolo, sommario e corpo inglesi tutti e tre.
// Una nota con il solo titolo tradotto produrrebbe una pagina che annuncia
// l'inglese e poi parla italiano; meglio nessuna pagina, e l'elenco inglese
// rimanda alla versione italiana marcata `lang="it"`.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TestataPagina from '../../../components/TestataPagina.astro';
import CorpoNota from '../../../components/CorpoNota.astro';
import { localizedPath } from '../../../i18n/ui';
import { dataEn } from '../../../lib/dataNota';
import { tradotta, tutteLeNote } from '../../../lib/note';
import type { Nota } from '../../../lib/note';

export async function getStaticPaths() {
  const note = await tutteLeNote();
  return note
    .filter(tradotta)
    .map((nota) => ({ params: { slug: nota.slug }, props: { nota } }));
}

const { nota } = Astro.props as { nota: Nota };
---

<BaseLayout
  title={`${nota.titoloEn} — Alessandro Flaborea`}
  description={nota.sommarioEn!}
  lang="en"
  path={`/notes/${nota.slug}`}
  pathIt={`/note/${nota.slug}`}
  ogType="article"
  attiva="notes"
>
  <section class="intestazione">
    <div class="container">
      <TestataPagina occhiello="Notes" titolo={nota.titoloEn!} />
      <p class="meta">
        <span class="data">{dataEn(nota.data)}</span>
        {nota.tag.map((t) => <span class="tag">{t}</span>)}
      </p>
    </div>
  </section>

  <section class="articolo">
    <div class="container">
      <p class="sommario">{nota.sommarioEn}</p>
      <CorpoNota valore={nota.corpoEn!} />
      <a class="indietro" href={localizedPath('en', '/notes')}>All notes <span class="freccia">&larr;</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 24px;
  }

  .intestazione {
    padding: 72px 0 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    margin-top: 18px;
    font-size: 14px;
    color: var(--text-muted);
  }

  .tag {
    padding: 3px 9px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
  }

  .articolo {
    padding: 32px 0 96px;
  }

  .sommario {
    max-width: 68ch;
    margin: 0 0 32px;
    font-size: 19px;
    line-height: 1.65;
    color: var(--text);
  }

  .indietro {
    display: inline-block;
    margin-top: 48px;
    font-size: 15px;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .intestazione {
      padding-top: 48px;
    }

    .articolo {
      padding-bottom: 64px;
    }
  }
</style>
