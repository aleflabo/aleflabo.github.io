---
// src/pages/en/your-data.astro — gemella inglese di
// src/pages/i-vostri-dati.astro (rotta `/en/your-data`).
import BaseLayout from '../../layouts/BaseLayout.astro';
import CorpoDati from '../../components/pagine/CorpoDati.astro';
import {
  situazioniDati,
  rispostaCorta,
  quelloCheNonPossoGarantirvi,
  suQuestoHoLavoratoDavvero,
} from '../../data/en/dati';
import { testiDatiPagina } from '../../data/en/datiPagina';
---

<BaseLayout
  title="Where your data ends up — Alessandro Flaborea"
  description={rispostaCorta.intro}
  lang="en"
  path="/your-data"
  pathIt="/i-vostri-dati"
>
  {/* Gli occhielli sovrascritti a `undefined` sono la potatura del primo giro:
      il perché sta in CorpoDati.astro, le stringhe restano nei dati. */}
  <CorpoDati
    lang="en"
    t={{ ...testiDatiPagina, labelOnesta: undefined, labelCredete: undefined }}
    situazioniDati={situazioniDati}
    rispostaCorta={rispostaCorta}
    quelloCheNonPossoGarantirvi={quelloCheNonPossoGarantirvi}
    suQuestoHoLavoratoDavvero={suQuestoHoLavoratoDavvero}
  />
</BaseLayout>
