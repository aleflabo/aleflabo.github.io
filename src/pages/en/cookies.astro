---
// src/pages/en/cookies.astro — gemella inglese di src/pages/cookie.astro
// (rotta `/en/cookies`, plurale come vuole testi-en.md).
import BaseLayout from '../../layouts/BaseLayout.astro';
import TestataPagina from '../../components/TestataPagina.astro';
import TestoLegale from '../../components/TestoLegale.astro';
import { cookie as testo } from '../../data/en/legale';
import { statistiche } from '../../data/analytics';
import { conStatistiche } from '../../lib/informativa';

// L'informativa segue l'interruttore in src/data/analytics.ts: se un
// giorno il sito conta le visite, questa pagina lo dice dallo stesso
// posto da cui lo script viene reso, non da una modifica a mano.
const p = conStatistiche(testo, 'en', statistiche);
---

<BaseLayout
  title="Cookies — Alessandro Flaborea"
  description={p.introduzione}
  lang="en"
  path="/cookies"
  pathIt="/cookie"
>
  <section class="pagina">
    <div class="container">
      <TestataPagina percorso="/en/cookies" titolo={p.titolo} />
      <TestoLegale sezioni={p.sezioni} aggiornamento={p.aggiornamento} introduzione={p.introduzione} etichettaIndice="Contents" />
    </div>
  </section>
</BaseLayout>

<style>
  .pagina { padding: 0; border-bottom: 1px solid var(--filo); }
  .container {
    max-width: var(--maxw-lab);
    margin: 0 auto;
    border-inline: 1px solid var(--filo);
    padding: 48px 28px 40px;
    display: grid;
    gap: 28px;
  }
  @media (max-width: 820px) { .container { padding: 28px 16px; } }
</style>
