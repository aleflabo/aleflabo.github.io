---
// src/pages/en/research.astro — gemella inglese di src/pages/ricerca.astro
// (rotta `/en/research`). Stesso corpo, testi inglesi.
import BaseLayout from '../../layouts/BaseLayout.astro';
import CorpoRicerca from '../../components/pagine/CorpoRicerca.astro';
import { pubblicazioni, numeriFascia } from '../../data/en/pubblicazioni';
import { ricerca } from '../../data/en/ricerca';
---

<BaseLayout
  title="Research — Alessandro Flaborea"
  description={ricerca.introduzione}
  lang="en"
  path="/research"
  pathIt="/ricerca"
  attiva="research"
>
  <CorpoRicerca lang="en" t={ricerca} pubblicazioni={pubblicazioni} numeriFascia={numeriFascia} />
</BaseLayout>
