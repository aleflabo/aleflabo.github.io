---
// src/pages/en/research.astro — gemella inglese di src/pages/ricerca.astro
// (rotta `/en/research`). Stesso corpo, testi inglesi.
import BaseLayout from '../../layouts/BaseLayout.astro';
import CorpoRicerca from '../../components/pagine/CorpoRicerca.astro';
import { pubblicazioni, numeriFascia } from '../../data/en/pubblicazioni';
import { ricerca } from '../../data/en/ricerca';
import { arxivDi, eUnaRivista } from '../../data/pubblicazioni';
import { briciole, pubblicazioniLd } from '../../lib/datiStrutturati';
import { localizedPath } from '../../i18n/ui';

// Gemello di src/pages/ricerca.astro. I titoli sono identici nelle due
// lingue, quindi la mappa degli arXiv è una sola (src/data/pubblicazioni.ts).
const dominio = Astro.site!.toString().replace(/\/$/, '');
const datiStrutturati = [
  pubblicazioniLd(
    dominio,
    pubblicazioni.map((p) => ({
      titolo: p.titolo,
      anno: p.anno,
      sede: p.sede,
      url: arxivDi(p.titolo),
      rivista: eUnaRivista(p.sede),
    })),
  ),
  briciole(dominio, [
    { nome: 'Home', percorso: localizedPath('en', '/') },
    { nome: 'Research', percorso: localizedPath('en', '/research') },
  ]),
];
---

<BaseLayout
  title="Research — Alessandro Flaborea"
  description={ricerca.introduzione}
  lang="en"
  path="/research"
  pathIt="/ricerca"
  attiva="research"
  datiStrutturati={datiStrutturati}
>
  <CorpoRicerca lang="en" t={ricerca} pubblicazioni={pubblicazioni} numeriFascia={numeriFascia} />
</BaseLayout>
