---
// src/pages/en/training.astro — gemella inglese di src/pages/formazione.astro
// (rotta `/en/training`).
import BaseLayout from '../../layouts/BaseLayout.astro';
import CorpoFormazione from '../../components/pagine/CorpoFormazione.astro';
import { corsi, testiCorsi, riquadroAiAct, dettagliPratici, cosaResta, faqAiAct, strade } from '../../data/en/formazione';
import { policy } from '../../data/en/servizi';
import { testiFormazionePagina } from '../../data/en/formazionePagina';
import { site } from '../../data/site';
import { briciole, corso } from '../../lib/datiStrutturati';
import { localizedPath } from '../../i18n/ui';

// Gemello di src/pages/formazione.astro.
const dominio = Astro.site!.toString().replace(/\/$/, '');
const datiStrutturati = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: corsi.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: corso(dominio, { nome: c.nome, descrizione: c.livelli.map((l) => `${l.durata}: ${l.moduli.join('; ')}`).join(' · ') }),
    })),
  },
  briciole(dominio, [
    { nome: 'Home', percorso: localizedPath('en', '/') },
    { nome: 'Training', percorso: localizedPath('en', '/training') },
  ]),
];
---

<BaseLayout
  title="Training — Alessandro Flaborea"
  description={testiFormazionePagina.introduzione}
  lang="en"
  path="/training"
  pathIt="/formazione"
  attiva="training"
  datiStrutturati={datiStrutturati}
>
  {/* Gli occhielli sovrascritti a `undefined` sono la potatura del primo giro:
      il perché sta in CorpoFormazione.astro, le stringhe restano nei dati. */}
  <CorpoFormazione
    lang="en"
    t={{ ...testiFormazionePagina, labelOrganizza: undefined, labelCattedra: undefined, labelOnesta: undefined }}
    corsi={corsi}
    testiCorsi={testiCorsi}
    riquadroAiAct={riquadroAiAct}
    dettagliPratici={dettagliPratici}
    cosaResta={cosaResta}
    faqAiAct={faqAiAct}
    policy={policy}
    strade={strade}
    prenotaMezzora={site.en.prenotaMezzora ?? ''}
  />
</BaseLayout>
