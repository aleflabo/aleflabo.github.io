---
// src/pages/en/training.astro — gemella inglese di src/pages/formazione.astro
// (rotta `/en/training`).
// Testo alla lettera da docs/superpowers/specs/2026-08-25-sito-italiano/
// testi-en.md, sezione «3. /en/training». `formati`, `riquadroAiAct` e
// `strade` vengono da src/data/en/formazione.ts (task 6, sito-inglese): non
// riscritti qui. I blocchi «Who's teaching», «What this course is not» e il
// titolo/etichetta di «Who pays for the course» non hanno un campo in
// quel file — restano scritti qui, alla lettera dalla tavola, come già fa
// la gemella italiana in formazione.astro.
//
// Il riquadro sull'AI Act mantiene lo stesso tono di fatto dell'italiano:
// si cita l'obbligo con la data, niente sanzioni, niente allarmismo — è
// una scelta esplicita del committente (task-6-brief.md) e il testo di
// riquadroAiAct.corpo già la rispetta.
//
// `riquadroAiAct.link.href` qui è già il percorso risolto verso l'inglese
// (`/en/your-data`, vedi il commento in data/en/formazione.ts), a
// differenza dell'italiano dove `formazione.ts` tiene l'href nudo e la
// pagina lo passa per `localizedPath('it', ...)`: qui niente
// `localizedPath`, altrimenti raddoppierebbe il prefisso `/en`.
import BaseLayout from '../../layouts/BaseLayout.astro';
import TestataPagina from '../../components/TestataPagina.astro';
import { formati, riquadroAiAct, strade } from '../../data/en/formazione';
import { localizedPath } from '../../i18n/ui';
import { site } from '../../data/site';

const prenotaMezzoraEn = site.en.prenotaMezzora ?? '';
---

<BaseLayout
  title="Training — Alessandro Flaborea"
  description="In the classroom we work on the company's own documents and on the cases that actually come up. The aim is that everyone leaves with something they can put into practice straight away."
  lang="en"
  path="/training"
  pathIt="/formazione"
  attiva="training"
>
  <section class="intestazione">
    <div class="container">
      <TestataPagina
        occhiello="Training"
        titolo="Courses you use the next day"
        introduzione="In the classroom we work on the company's own documents and on the cases that actually come up. The aim is that everyone leaves with something they can put into practice straight away."
      />
    </div>
  </section>

  <section class="avviso-ai-act">
    <div class="container">
      <div class="riquadro">
        <p class="riquadro-label">{riquadroAiAct.titolo}</p>
        {riquadroAiAct.corpo.map((p, i) => (
          <p class:list={['riquadro-corpo', { muto: i > 0 }]}>{p}</p>
        ))}
        <a class="riquadro-link" href={riquadroAiAct.link.href}>{riquadroAiAct.link.testo} <span class="freccia">&rarr;</span></a>
      </div>
    </div>
  </section>

  <section class="elenco-formati">
    <div class="container">
      <div class="schede">
        {formati.map((f) => (
          <div class="scheda formato">
            <div class="descrizione">
              <p class="eyebrow">{f.ore}</p>
              <h2>{f.nome}</h2>
              <p class="corpo">{f.corpo}</p>
            </div>
            <div class="dettagli">
              <div>
                <p class="dettaglio-etichetta">Who it's for</p>
                <p class="dettaglio-valore">{f.perChi}</p>
              </div>
              <div>
                <p class="dettaglio-etichetta">What you need to provide</p>
                <p class="dettaglio-valore">{f.serveDaVoi}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="come-si-organizza">
    <div class="container">
      <p class="label">How it gets organised</p>
      <h2 class="section-title">Who pays for the course</h2>
      <div class="griglia-strade">
        {strade.map((s) => (
          <div>
            <h3>{s.titolo}</h3>
            <p class="corpo">{s.testo}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="aula-onesta">
    <div class="container">
      <div class="colonne">
        <div>
          <p class="label">Who's teaching</p>
          <h2 class="section-title">I come from the classroom</h2>
          <p class="corpo">Four years as a teaching assistant at Sapienza, from 2019 to 2023, during the PhD. Then two years building software people use every day. In a classroom you need both: the first to manage to make yourself understood, the second to teach things that hold up inside a company.</p>
          <p class="corpo">I was also an invited speaker at Ferrari S.p.A.'s Data Science Hub.</p>
        </div>
        <div>
          <p class="label">Honesty</p>
          <h2 class="section-title">What this course is not</h2>
          <div class="righe">
            <p class="corpo">It isn't a programming course. We work on the tools that already exist and on how to bring them into everyday work. Writing code and training models is a separate path.</p>
            <p class="corpo">There are no ready-made formulas to copy. Lists of tricks stop working at the first change of model, while having understood how the tool reasons stays with you.</p>
            <p class="corpo">I don't turn up with a saving percentage already written on the slides. Before having seen how you work it would be a made-up number.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-azienda">
    <div class="container">
      <h2>Tell me what kind of company you are</h2>
      <p class="intro">How many of you there are, what you do and who would use these tools. From there we work out which of the three routes suits you.</p>
      <div class="pulsanti">
        <a class="pulsante primario" href={`${localizedPath('en', '/')}#parliamone`}>{prenotaMezzoraEn}</a>
        <a class="pulsante secondario" href="https://wa.me/393467202432" rel="noopener">WhatsApp</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 24px;
  }

  /* --- intestazione --- */
  .intestazione {
    padding: 0;
  }
  .intestazione .container {
    padding: 72px 24px 44px;
  }
  /* TestataPagina riproduce il caso maggioritario (22ch): qui la tavola
     vuole 24ch, uno scarto minore, quindi resta come override — solo da
     641px in su (vedi la nota gemella in services.astro: sotto i 640px
     ci pensa già il componente ad azzerare max-width). */
  @media (min-width: 641px) {
    .intestazione :global(h1) {
      max-width: 24ch;
    }
  }

  /* --- riquadro AI Act --- */
  .avviso-ai-act {
    padding: 0;
  }
  .avviso-ai-act .container {
    padding: 0 24px 56px;
  }
  .riquadro {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    padding: 30px 34px;
    max-width: 860px;
  }
  .riquadro-label {
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--azione);
    font-weight: 700;
  }
  .riquadro-corpo {
    margin-top: 14px;
    font-size: 16.5px;
    line-height: 1.65;
    color: var(--text);
  }
  .riquadro-corpo.muto {
    color: var(--text-muted);
  }
  .riquadro-link {
    display: inline-block;
    margin-top: 18px;
    font-size: 15px;
    font-weight: 600;
  }

  /* --- i tre formati --- */
  .elenco-formati {
    padding: 0;
  }
  .elenco-formati .container {
    padding: 0 24px 72px;
  }
  .schede {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .formato {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 34px;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 40px;
  }
  .formato .eyebrow {
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--azione);
    font-weight: 700;
  }
  .formato .descrizione h2 {
    font-size: 26px;
    margin-top: 12px;
  }
  .formato .descrizione .corpo {
    margin-top: 14px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-muted);
  }
  .formato .dettagli {
    border-left: 1px solid var(--border);
    padding-left: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .formato .dettaglio-etichetta {
    font-size: 11.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--azione);
    font-weight: 700;
  }
  .formato .dettaglio-valore {
    margin-top: 6px;
    font-size: 14.5px;
    line-height: 1.6;
  }

  /* --- come si organizza --- */
  .come-si-organizza {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding: 0;
  }
  .come-si-organizza .container {
    padding: 72px 24px;
  }
  .section-title {
    font-size: 30px;
    margin-top: 18px;
    margin-bottom: 34px;
    max-width: 26ch;
  }
  .griglia-strade {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  .griglia-strade h3 {
    font-size: 19px;
  }
  .griglia-strade .corpo {
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  /* --- vengo dall'aula / che cosa non è --- */
  .aula-onesta {
    border-top: 1px solid var(--border);
    padding: 0;
  }
  .aula-onesta .container {
    padding: 72px 24px;
  }
  .colonne {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
  }
  .colonne .section-title {
    font-size: 28px;
    margin-bottom: 0;
    max-width: 22ch;
  }
  .colonne .corpo {
    margin-top: 18px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-muted);
  }
  .colonne .righe {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 18px;
  }
  .colonne .righe .corpo {
    margin-top: 0;
  }

  /* --- raccontami che azienda siete --- */
  .cta-azienda {
    border-top: 1px solid var(--border);
    background: var(--accent);
    padding: 0;
  }
  .cta-azienda .container {
    padding: 60px 24px;
  }
  .cta-azienda h2 {
    font-size: 30px;
    color: var(--surface);
    max-width: 26ch;
  }
  .cta-azienda .intro {
    margin-top: 16px;
    font-size: 16px;
    line-height: 1.6;
    color: #cdd9e6;
    max-width: 56ch;
  }
  .pulsanti {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 30px;
    flex-wrap: wrap;
  }
  .pulsante.primario {
    background: var(--surface);
    color: var(--accent);
    font-size: 15px;
    font-weight: 600;
    padding: 14px 30px;
    border-radius: var(--radius);
  }
  .pulsante.secondario {
    font-size: 15px;
    color: var(--surface);
    border: 1px solid #6d8aa8;
    border-radius: var(--radius);
    padding: 13px 24px;
  }

  @media (max-width: 640px) {
    .intestazione .container {
      padding: 44px 20px 36px;
    }
    .avviso-ai-act .container {
      padding: 0 20px 40px;
    }
    .riquadro {
      padding: 24px 22px;
    }
    .elenco-formati .container {
      padding: 0 20px 48px;
    }
    .formato {
      grid-template-columns: 1fr;
      gap: 22px;
      padding: 26px 22px;
    }
    .formato .descrizione h2 {
      font-size: 23px;
    }
    .formato .dettagli {
      border-left: none;
      padding-left: 0;
      padding-top: 20px;
      border-top: 1px solid var(--border);
    }
    .come-si-organizza .container,
    .aula-onesta .container {
      padding: 48px 20px;
    }
    .section-title {
      font-size: 24px;
      margin-bottom: 24px;
      max-width: none;
    }
    .griglia-strade {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .colonne {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .colonne .section-title {
      font-size: 24px;
      max-width: none;
    }
    .cta-azienda .container {
      padding: 44px 20px;
    }
    .cta-azienda h2 {
      font-size: 24px;
      max-width: none;
    }
    .cta-azienda .intro {
      font-size: 15px;
      max-width: none;
    }
    .pulsanti {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }
    .pulsanti a {
      text-align: center;
    }
  }
</style>
