---
// src/pages/en/about.astro — gemella inglese di src/pages/chi-sono.astro
// (rotta `/en/about`).
// Testo alla lettera da docs/superpowers/specs/2026-08-25-sito-italiano/
// testi-en.md, sezione «6. /en/about». I cinque paragrafi della biografia,
// «In breve» e le tre abitudini vengono da src/data/en/chiSono.ts
// (task 6, sito-inglese): non riscritti qui.
//
// La tavola marca due versioni possibili della biografia (i cinque
// paragrafi riusati di `site.ts` → `en.about.body`, al presente, contro i
// cinque tradotti dall'italiano approvato) e segnala che si contraddicono.
// `src/data/en/chiSono.ts` ha già scelto la versione tradotta — è quella
// coerente col resto del sito inglese, che dice il ruolo Procedo concluso
// a metà 2026 — e questa pagina la usa da lì (task-8-brief.md, punto 4):
// non `en.about.body` di `site.ts`, che dice al presente cosa non è più
// vero.
//
// L'etichetta «In breve» e il paragrafo «Fuori dal lavoro» non sono fra
// gli export di quel file e restano scritti qui, alla lettera dalla
// tavola — come già fa la gemella italiana. Il riquadro della fotografia
// resta un segnaposto dichiarato, qui in inglese (fondo #efece7, bordo
// tratteggiato): nessuna immagine finta, nessun avatar generato, nessun
// servizio di segnaposto esterno. Il pulsante «Download my CV» resta
// inerte (`href="#"`): il PDF non è ancora collegato.
import BaseLayout from '../../layouts/BaseLayout.astro';
import TestataPagina from '../../components/TestataPagina.astro';
import { chiSono } from '../../data/en/chiSono';
import { localizedPath } from '../../i18n/ui';
---

<BaseLayout
  title="About — Alessandro Flaborea"
  description="I started in Udine, with a degree in computer science and six months in Sweden that took away any idea of staying put."
  lang="en"
  path="/about"
  pathIt="/chi-sono"
  attiva="about"
>
  <section class="biografia">
    <div class="container">
      <div class="griglia">
        <div class="colonna-foto">
          <div class="segnaposto-foto">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#8f8578" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-4.5-4.5L9 18"></path></svg>
            <p class="segnaposto-titolo">[ YOUR PHOTO ]</p>
          </div>
          <div class="in-breve">
            <p class="label">In brief</p>
            {chiSono.inBreve.map((riga) => (
              <p class="riga-in-breve">{riga}</p>
            ))}
          </div>
        </div>

        <div class="colonna-bio">
          <TestataPagina occhiello="About" titolo="Alessandro Flaborea" />
          <div class="paragrafi">
            {chiSono.paragrafi.map((p, i) => (
              <p class:list={['corpo', { primo: i === 0 }]}>{p}</p>
            ))}
          </div>
          <div class="cta-row">
            <a class="pulsante primaria" href={`${localizedPath('en', '/')}#parliamone`}>Book the diagnostic half-day</a>
            <a class="pulsante secondaria" href="/cv/Alessandro_Flaborea_Resume_en.pdf" download>Download my CV</a>
            <a class="pulsante secondaria" href={localizedPath('en', '/work')}>What I've built</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="abitudini">
    <div class="container">
      <p class="label">How I work, concretely</p>
      <h2 class="section-title">Habits worth knowing about first</h2>
      <div class="griglia-abitudini">
        {chiSono.abitudini.map((a) => (
          <div>
            <h3>{a.titolo}</h3>
            <p class="corpo">{a.testo}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="fuori-dal-lavoro">
    <div class="container">
      <p class="label">Outside work</p>
      <p class="corpo">The thread that holds it all together is curiosity, for new problems, new places and new people. It took me from Udine to Rome and from Gothenburg to Amsterdam, and it still decides what I build at weekends.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 24px;
  }

  /* --- biografia --- */
  .biografia {
    padding: 0;
  }
  .biografia .container {
    padding: 72px 24px 60px;
  }
  .griglia {
    display: grid;
    grid-template-columns: 340px minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }

  /* --- colonna foto --- */
  .segnaposto-foto {
    width: 100%;
    aspect-ratio: 4 / 5;
    background: #efece7;
    border: 1px dashed #b9b1a4;
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 24px;
    text-align: center;
  }
  .segnaposto-titolo {
    font-size: 13px;
    font-weight: 600;
    color: #6f6659;
    letter-spacing: 0.06em;
  }
  .in-breve {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-top: 1px solid var(--border);
    padding-top: 22px;
  }
  .riga-in-breve {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* --- colonna bio ---
     Qui TestataPagina porta solo occhiello/titolo/filetto: la
     «introduzione» del componente presuppone una sola frase, mentre qui
     la biografia sono cinque paragrafi con una gerarchia propria (il
     primo più grande, gli altri no) — non la stessa cosa, non passata
     come prop. Le misure di titolo e filetto della tavola, in desktop,
     non coincidono col caso maggioritario delle altre sei pagine (h1
     42px non 46px, max-width 20ch, filetto 28px non 30px) e restano
     come override — solo da 641px in su: sotto i 640px il componente
     azzera già margin-top/max-width dell'h1 e il margine del filetto
     ai suoi valori mobile, che qui coincidono con quelli della tavola
     (16px, none, 22px), quindi non serve toccarli di nuovo. Un override
     senza @media qui vincerebbe per specificità anche sotto i 640px,
     rompendo il mobile. Il font-size dell'h1 in mobile (30px invece di
     32px) resta invece un override mirato, più sotto. */
  @media (min-width: 641px) {
    .colonna-bio :global(h1) {
      margin-top: 20px;
      font-size: 42px;
      max-width: 20ch;
    }
    .colonna-bio :global(.divider) {
      margin: 28px 0;
    }
  }
  .paragrafi {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 62ch;
  }
  .paragrafi .corpo {
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--text-muted);
  }
  .paragrafi .corpo.primo {
    font-size: 18px;
    line-height: 1.65;
    color: var(--text);
  }
  .cta-row {
    display: flex;
    gap: 14px;
    margin-top: 34px;
    flex-wrap: wrap;
  }
  .cta-row .primaria {
    background: var(--azione);
    color: var(--surface);
    font-size: 15px;
    font-weight: 600;
    padding: 14px 28px;
    border-radius: var(--radius);
  }
  .cta-row .secondaria {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 13px 24px;
  }

  /* --- abitudini --- */
  .abitudini {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding: 0;
  }
  .abitudini .container {
    padding: 64px 24px;
  }
  .section-title {
    font-size: 28px;
    margin-top: 18px;
    margin-bottom: 34px;
    max-width: 30ch;
  }
  .griglia-abitudini {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 34px;
  }
  .griglia-abitudini h3 {
    font-size: 19px;
  }
  .griglia-abitudini .corpo {
    margin-top: 12px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  /* --- fuori dal lavoro --- */
  .fuori-dal-lavoro {
    border-top: 1px solid var(--border);
    padding: 0;
  }
  .fuori-dal-lavoro .container {
    padding: 56px 24px;
  }
  .fuori-dal-lavoro .label {
    margin-bottom: 20px;
  }
  .fuori-dal-lavoro .corpo {
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--text-muted);
    max-width: 62ch;
  }

  @media (max-width: 640px) {
    .biografia .container {
      padding: 44px 20px 44px;
    }
    .griglia {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .colonna-foto {
      max-width: 280px;
    }
    .colonna-bio :global(h1) {
      font-size: 30px;
    }
    .paragrafi {
      max-width: none;
    }
    .paragrafi .corpo.primo {
      font-size: 16.5px;
    }
    .paragrafi .corpo {
      font-size: 15.5px;
    }
    .cta-row {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }
    .cta-row a {
      text-align: center;
    }
    .abitudini .container,
    .fuori-dal-lavoro .container {
      padding: 44px 20px;
    }
    .section-title {
      font-size: 24px;
      margin-bottom: 22px;
      max-width: none;
    }
    .griglia-abitudini {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    .fuori-dal-lavoro .corpo {
      max-width: none;
    }
  }
</style>
