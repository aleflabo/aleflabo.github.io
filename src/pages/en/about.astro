---
// src/pages/en/about.astro — gemella inglese di src/pages/chi-sono.astro
// (rotta `/en/about`).
import BaseLayout from '../../layouts/BaseLayout.astro';
import CorpoChiSono from '../../components/pagine/CorpoChiSono.astro';
import { chiSono } from '../../data/en/chiSono';
import { testiChiSonoPagina } from '../../data/en/chiSonoPagina';
import DaDoveViene from '../../components/sezioni/DaDoveViene.astro';
import Territorio from '../../components/sezioni/Territorio.astro';
import { daDoveViene } from '../../data/en/home';
import { territorio } from '../../data/territorio';
---

<BaseLayout
  title="About — Alessandro Flaborea"
  description="I started in Udine, with a degree in computer science and six months in Sweden that took away any idea of staying put."
  lang="en"
  path="/about"
  pathIt="/chi-sono"
  attiva="about"
>
  {/* Gli occhielli sovrascritti a `undefined` sono la potatura del primo giro:
      il perché sta in CorpoChiSono.astro, le stringhe restano nei dati. */}
  <CorpoChiSono lang="en" t={{ ...testiChiSonoPagina, labelComeLavoro: undefined, labelFuori: undefined }} chiSono={chiSono} hrefLavori="/work">
    <Fragment slot="dopo-biografia">
      <DaDoveViene {...daDoveViene} />
      <Territorio {...territorio.en} />
    </Fragment>
  </CorpoChiSono>
</BaseLayout>
