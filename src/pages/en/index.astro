---
// src/pages/en/index.astro — la home inglese (rotta `/en/`).
//
// Gemella della home italiana (src/pages/index.astro), ma a sette sezioni
// invece di otto: manca <CosaCostruisco /> (task 11, home-visuale — vedi
// il commento più sotto, prima del montaggio). Gli altri sette componenti
// vengono da src/components/sezioni/, alimentati qui da src/data/en/home.ts
// invece che dalle costanti scritte a mano nella home italiana. Nessuna
// stringa nuova: tutto il testo viene da quel file (task 3, sito-inglese,
// verificato campo per campo contro le firme dei componenti —
// task-2-report.md).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Occhiello from '../../components/sezioni/Occhiello.astro';
import FasciaNumeri from '../../components/sezioni/FasciaNumeri.astro';
import IlProblema from '../../components/sezioni/IlProblema.astro';
import ComeLavoro from '../../components/sezioni/ComeLavoro.astro';
import LeProve from '../../components/sezioni/LeProve.astro';
import BloccoFormazione from '../../components/sezioni/BloccoFormazione.astro';
import Contatto from '../../components/sezioni/Contatto.astro';
import {
  occhiello,
  numeri,
  ilProblema,
  comeLavoro,
  leProve,
  bloccoFormazione,
  daDoveViene,
  contatto,
} from '../../data/en/home';
import { territorio } from '../../data/territorio';
import { ingaggi as ingaggiInglesi } from '../../data/en/servizi';
import { attivita } from '../../lib/datiStrutturati';

// Niente <CosaCostruisco /> qui (task 11, home-visuale): le otto stringhe
// della sezione italiana omonima (occhiello, titolo, intro, nodo.titolo,
// nodo.sottotitolo, ritorno, le due didascalie — vedi il commento sopra
// `cosaCostruisco` in src/pages/index.astro) non hanno un equivalente
// approvato in testi-en.md. Non è una dimenticanza: è la regola 2 del
// CLAUDE.md — un campo vuoto salta la sua sezione, non si allunga il
// testo per riempirla. Per aggiungerla servirebbe che il committente
// scrivesse (non traducesse) le otto frasi inglesi in testi-en.md, poi
// bastano import di CosaCostruisco, l'oggetto in src/data/en/home.ts e il
// montaggio qui sotto, sullo stesso modello dell'italiana.

// Titolo e descrizione della pagina: composti dai dati già approvati in
// home.ts, con la stessa regola della home italiana (src/pages/index.astro),
// non riscritti a mano. Nessuna parola nuova: solo composizione.
//
// - titolo  = "Alessandro Flaborea — " + occhiello.eyebrow
// - descrizione = occhiello.titolo, senza le barre verticali che lo spezzano
//   in tre parti per l'evidenziatore. La sostituzione va oltre un semplice
//   `replaceAll('|', '')`: quel titolo ha segmenti che si toccano senza
//   spazio da un lato (qui: una virgola subito dopo la seconda barra), quindi
//   togliere solo il carattere unirebbe le parole ("...is needed , and...").
//   Si sostituisce ogni barra con uno spazio, poi si toglie lo spazio
//   indesiderato prima della punteggiatura e si collassano eventuali spazi
//   doppi, per ottenere una frase leggibile.
const titoloPagina = `Alessandro Flaborea — ${occhiello.eyebrow}`;
// La sola composizione dava 66 caratteri, meno di metà della finestra utile
// in SERP, e non diceva da dove si lavora. La coda sul territorio è la stessa
// cosa che dice il blocco territorio dentro Contatto (task 6, home-visuale),
// resa in inglese.
const descrizionePagina = `${occhiello.titolo
  .replaceAll('|', ' ')
  .replace(/\s+([,.;:!?])/g, '$1')
  .replace(/\s+/g, ' ')
  .trim()} Based in Venice: on site across Veneto and Friuli, remotely everywhere else.`;

// --- Dati strutturati ---
// Gemello di quello della home italiana: `ProfessionalService` con i quattro
// modi di lavorare insieme e le aree servite, in inglese.
const dominio = Astro.site!.toString().replace(/\/$/, '');
const datiStrutturati = [
  attivita({
    site: dominio,
    lang: 'en',
    servizi: ingaggiInglesi.map((i) => ({ nome: i.nome, descrizione: i.corpo[0] })),
  }),
];
---

<BaseLayout
  title={titoloPagina}
  description={descrizionePagina}
  lang="en"
  path="/"
  pathIt="/"
  datiStrutturati={datiStrutturati}
>
  <Occhiello {...occhiello} />
  <FasciaNumeri numeri={numeri} daDoveViene={daDoveViene} />
  <IlProblema {...ilProblema} />
  <ComeLavoro {...comeLavoro} />
  <LeProve {...leProve} />
  <BloccoFormazione {...bloccoFormazione} introduzioni={[bloccoFormazione.introduzioni[1]]} />
  <Contatto {...contatto} territorio={territorio.en} />
</BaseLayout>
