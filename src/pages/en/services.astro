---
// src/pages/en/services.astro — gemella inglese di src/pages/servizi.astro
// (rotta `/en/services`).
// Testo alla lettera da docs/superpowers/specs/2026-08-25-sito-italiano/
// testi-en.md, sezione «2. /en/services». I dati dei quattro ingaggi, del
// FAQ e di «Who I'm not for» vengono da src/data/en/servizi.ts (task 6,
// sito-inglese): non riscritti qui. Il testo della fascia «How it starts»
// non è fra gli export di quel file (solo `ingaggi`, `faq`,
// `perChiNonSono`), quindi resta scritto qui, alla lettera dalla tavola —
// come già fa la gemella italiana in servizi.astro.
import BaseLayout from '../../layouts/BaseLayout.astro';
import TestataPagina from '../../components/TestataPagina.astro';
import SchedaIngaggio from '../../components/sezioni/SchedaIngaggio.astro';
import Faq from '../../components/sezioni/Faq.astro';
import { ingaggi, faq, perChiNonSono } from '../../data/en/servizi';
import { localizedPath } from '../../i18n/ui';
---

<BaseLayout
  title="Services — Alessandro Flaborea"
  description="You start with the first one. Each step stands on its own: you go on when the work calls for it, you can stop at any moment, and what has been done stays yours anyway."
  lang="en"
  path="/services"
  pathIt="/servizi"
  attiva="services"
>
  <section class="intestazione">
    <div class="container">
      <TestataPagina
        occhiello="Services"
        titolo="Four ways of working together"
        introduzione="You start with the first one. Each step stands on its own: you go on when the work calls for it, you can stop at any moment, and what has been done stays yours anyway."
      />
    </div>
  </section>

  <section class="elenco-ingaggi">
    <div class="container">
      <div class="schede">
        {ingaggi.map((ingaggio) => (
          <SchedaIngaggio
            ingaggio={ingaggio}
            etichettaPerChi="Who it's for"
            etichettaQuantoDura="How long"
            etichettaCosaResta="What you keep"
          />
        ))}
      </div>
      <a class="continua" href={localizedPath('en', '/work')}>The evidence: what I've built <span class="freccia">&rarr;</span></a>
    </div>
  </section>

  <section class="per-chi-non-sono">
    <div class="container">
      <p class="label">Honesty</p>
      <h2 class="section-title">Who I'm not for</h2>
      <div class="griglia">
        {perChiNonSono.map((riga) => (
          <p class="riga-testo">{riga}</p>
        ))}
      </div>
    </div>
  </section>

  <section class="domande">
    <div class="container">
      <p class="label">Questions</p>
      <h2 class="section-title">The ones I get asked almost every time</h2>
      <Faq domande={faq} />
    </div>
  </section>

  <section class="come-si-comincia">
    <div class="container">
      <h2>How it starts</h2>
      <p class="intro">You write me two lines about what you'd like to stop doing by hand and we talk for half an hour. If there's room to work together we meet in person; otherwise I tell you straight away, and if I know someone better suited I put you in touch.</p>
      <a class="pulsante cta" href={`${localizedPath('en', '/')}#parliamone`}>Let's talk, half an hour</a>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 24px;
  }

  /* --- intestazione --- */
  .intestazione {
    padding: 0;
  }
  .intestazione .container {
    padding: 72px 24px 44px;
  }
  /* TestataPagina riproduce il caso maggioritario (62ch): qui la tavola
     vuole 60ch, uno scarto minore, quindi resta come override — solo da
     641px in su, perché sotto i 640px il componente stesso azzera già
     max-width a "none" (@media nel componente): un override senza
     @media qui vincerebbe anche lì per specificità, sovrascrivendo
     quell'azzeramento e rompendo il mobile (bug trovato e corretto nel
     giro di correzioni 1, vedi task-1-report.md, ramo sito-italiano). */
  @media (min-width: 641px) {
    .intestazione :global(.intro) {
      max-width: 60ch;
    }
  }

  /* --- schede degli ingaggi --- */
  .elenco-ingaggi {
    padding: 0;
  }
  .elenco-ingaggi .container {
    padding: 0 24px 72px;
  }
  .schede {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .continua {
    display: inline-block;
    margin-top: 26px;
    font-size: 15px;
    font-weight: 600;
  }

  /* --- per chi non sono --- */
  .per-chi-non-sono {
    border-top: 1px solid var(--border);
    padding: 0;
  }
  .per-chi-non-sono .container {
    padding: 72px 24px;
  }
  .section-title {
    font-size: 32px;
    margin-top: 18px;
    margin-bottom: 30px;
    max-width: 24ch;
  }
  .griglia {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 44px;
    max-width: 900px;
  }
  .riga-testo {
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  /* --- domande --- */
  .domande {
    border-top: 1px solid var(--border);
    padding: 0;
  }
  .domande .container {
    padding: 72px 24px;
  }
  .domande .section-title {
    max-width: 30ch;
  }

  /* --- come si comincia --- */
  .come-si-comincia {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding: 0;
  }
  .come-si-comincia .container {
    padding: 64px 24px;
  }
  .come-si-comincia h2 {
    font-size: 28px;
    max-width: 24ch;
  }
  .come-si-comincia .intro {
    margin-top: 18px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 58ch;
    text-wrap: pretty;
  }
  .come-si-comincia .cta {
    display: inline-block;
    margin-top: 30px;
    background: var(--azione);
    color: var(--surface);
    font-size: 15px;
    font-weight: 600;
    padding: 14px 28px;
    border-radius: var(--radius);
  }

  @media (max-width: 640px) {
    .intestazione .container {
      padding: 44px 20px 36px;
    }
    .elenco-ingaggi .container {
      padding: 0 20px 48px;
    }
    .schede {
      gap: 18px;
    }
    .per-chi-non-sono .container,
    .domande .container {
      padding: 48px 20px;
    }
    .section-title {
      font-size: 26px;
      margin-bottom: 20px;
      max-width: none;
    }
    .griglia {
      grid-template-columns: 1fr;
      gap: 18px;
      max-width: none;
    }
    .come-si-comincia .container {
      padding: 44px 20px;
    }
    .come-si-comincia h2 {
      font-size: 24px;
      max-width: none;
    }
    .come-si-comincia .intro {
      font-size: 15.5px;
      max-width: none;
    }
    .come-si-comincia .cta {
      display: block;
      text-align: center;
    }
  }
</style>
