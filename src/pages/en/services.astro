---
// src/pages/en/services.astro — gemella inglese di src/pages/servizi.astro
// (rotta `/en/services`).
import BaseLayout from '../../layouts/BaseLayout.astro';
import CorpoServizi from '../../components/pagine/CorpoServizi.astro';
import { ingaggi, faq, perChiNonSono } from '../../data/en/servizi';
import { testiServiziPagina } from '../../data/en/serviziPagina';
import { briciole, faq as faqLd } from '../../lib/datiStrutturati';
import { localizedPath } from '../../i18n/ui';

// Gemello di src/pages/servizi.astro: stesse cinque domande, tradotte.
const dominio = Astro.site!.toString().replace(/\/$/, '');
const datiStrutturati = [
  faqLd(faq.map((d) => ({ domanda: d.domanda, risposta: d.risposta }))),
  briciole(dominio, [
    { nome: 'Home', percorso: localizedPath('en', '/') },
    { nome: 'Services', percorso: localizedPath('en', '/services') },
  ]),
];
---

<BaseLayout
  title="Services — Alessandro Flaborea"
  description={testiServiziPagina.introduzione}
  lang="en"
  path="/services"
  pathIt="/servizi"
  attiva="services"
  datiStrutturati={datiStrutturati}
>
  <CorpoServizi
    lang="en"
    t={testiServiziPagina}
    ingaggi={ingaggi}
    faq={faq}
    perChiNonSono={perChiNonSono}
    hrefLavori="/work"
  />
</BaseLayout>
