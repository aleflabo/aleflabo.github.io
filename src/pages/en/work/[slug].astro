---
// src/pages/en/work/[slug].astro — case study inglese, gemello di
// src/pages/lavori/[slug].astro ma con project.en e project.stack al posto
// di project.it e project.tagIt (lo stack RESTA sul lato inglese, vedi
// task-7-brief.md §2). Allineato alla gemella italiana in task 7,
// sito-inglese: `attiva="work"`, anno reso da `annoEn`, collegamento di
// ritorno che dice il titolo della pagina di destinazione (/en/work, il cui
// h1 è «What I've built»), come fa l'italiano con «Quello che ho costruito».
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StackChip from '../../../components/StackChip.astro';
import { projects, getProject } from '../../../data/projects';
import { site } from '../../../data/site';
import { annoEn } from '../../../lib/anno';
import { localizedPath } from '../../../i18n/ui';

export function getStaticPaths() {
  // I progetti `soloItaliano` (Portale ricambi, Tire Hub) non hanno un
  // testo inglese approvato (§10 della spec): niente rotta /en/work/[slug]
  // per loro (decisione nella revisione finale del ramo sito-italiano).
  return projects.filter((p) => !p.soloItaliano).map((p) => ({ params: { slug: p.slug } }));
}
const { slug } = Astro.params;
const project = getProject(slug!)!;
const c = project.en;
const path = `/work/${project.slug}`;
// La gemella italiana vive sotto /lavori, non /work: passarla esplicita
// evita che l'hreflang="it" punti a /work/[slug], che è solo un redirect
// verso /lavori/[slug] (task 1/bloccante).
const pathIt = `/lavori/${project.slug}`;
const t = site.en;
---
<BaseLayout title={`${project.name} — Alessandro Flaborea`} description={c.summary} lang="en" path={path} pathIt={pathIt} ogType="article" attiva="work">
  <article class="container case">
    <a class="back" href={localizedPath('en', '/work')}>← What I've built</a>
    <p class="label">{c.area} · {project.role} · {annoEn(project.year)}</p>
    <h1>{project.name}</h1>
    <p class="lead muted">{c.summary}</p>
    <div class="chips">{project.stack.map((s) => <StackChip label={s} />)}</div>
    <section><h2>{t.caseStudy.problem}</h2><p>{c.problem}</p></section>
    <section><h2>{t.caseStudy.approach}</h2><p>{c.approach}</p></section>
    <section><h2>{t.caseStudy.result}</h2><p>{c.result}</p></section>
    {(project.url || project.repo) && (
      <section class="links">
        {project.url && <a href={project.url} target="_blank" rel="noopener noreferrer">{t.workLiveLabel} ↗</a>}
        {project.repo && <a href={project.repo} target="_blank" rel="noopener noreferrer">{t.workCodeLabel} ↗</a>}
      </section>
    )}
    <!-- media (screenshots / video) goes here when available -->
  </article>
</BaseLayout>
<style>
  .case { max-width: 720px; padding-top: 6rem; padding-bottom: 4rem; }
  .case h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0.5rem 0; }
  .case .lead { font-size: 1.15rem; margin-bottom: 1rem; }
  .case .chips { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .case section { padding: 1.25rem 0; border-top: 1px solid var(--border); }
  .case h2 { font-size: 1.25rem; margin-bottom: 0.5rem; }
  .back { font-size: 0.85rem; color: var(--accent); }
  .links { display: flex; gap: 1.25rem; }
</style>
