---
// src/pages/servizi.astro — rotta `/servizi`.
// Il corpo, con il suo stile, vive in CorpoServizi.astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import CorpoServizi from '../components/pagine/CorpoServizi.astro';
import { ingaggi, faq, perChiNonSono } from '../data/servizi';
import { testiServiziPagina } from '../data/serviziPagina';
---

<BaseLayout
  title="Servizi — Alessandro Flaborea"
  description={testiServiziPagina.introduzione}
  lang="it"
  path="/servizi"
  pathEn="/services"
  attiva="servizi"
>
  <CorpoServizi
    lang="it"
    t={testiServiziPagina}
    ingaggi={ingaggi}
    faq={faq}
    perChiNonSono={perChiNonSono}
    hrefLavori="/lavori"
  />
</BaseLayout>
