---
// src/pages/servizi.astro — rotta `/servizi`.
// Il corpo, con il suo stile, vive in CorpoServizi.astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import CorpoServizi from '../components/pagine/CorpoServizi.astro';
import { ingaggi, faq, perChiNonSono } from '../data/servizi';
import { testiServiziPagina } from '../data/serviziPagina';
import { briciole, faq as faqLd } from '../lib/datiStrutturati';
import { localizedPath } from '../i18n/ui';

// Le cinque domande erano già in pagina, in `<h3>` con la risposta sotto:
// il formato che i motori generativi preferiscono, e non dichiarato. Il
// FAQPage nasce dallo stesso array che alimenta il componente, così la
// risposta letta e quella dichiarata non possono divergere.
const dominio = Astro.site!.toString().replace(/\/$/, '');
const datiStrutturati = [
  faqLd(faq.map((d) => ({ domanda: d.domanda, risposta: d.risposta }))),
  briciole(dominio, [
    { nome: 'Home', percorso: localizedPath('it', '/') },
    { nome: 'Servizi', percorso: localizedPath('it', '/servizi') },
  ]),
];
---

<BaseLayout
  title="Servizi — Alessandro Flaborea"
  description={testiServiziPagina.introduzione}
  lang="it"
  path="/servizi"
  pathEn="/services"
  attiva="servizi"
  datiStrutturati={datiStrutturati}
>
  <CorpoServizi
    lang="it"
    t={testiServiziPagina}
    ingaggi={ingaggi}
    faq={faq}
    perChiNonSono={perChiNonSono}
    hrefLavori="/lavori"
  />
</BaseLayout>
