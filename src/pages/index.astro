---
// src/pages/index.astro — la home italiana (rotta `/`).
import BaseLayout from '../layouts/BaseLayout.astro';
import Occhiello from '../components/it/Occhiello.astro';
import FasciaNumeri from '../components/it/FasciaNumeri.astro';
import IlProblema from '../components/it/IlProblema.astro';
import ComeLavoro from '../components/it/ComeLavoro.astro';
import LeProve from '../components/it/LeProve.astro';
import BloccoFormazione from '../components/it/BloccoFormazione.astro';
import DaDoveViene from '../components/it/DaDoveViene.astro';
import Contatto from '../components/it/Contatto.astro';
---

<BaseLayout
  title="Alessandro Flaborea — consulenza e formazione sull'intelligenza artificiale"
  description="Aiuto le aziende a capire dove serve l'intelligenza artificiale e poi la costruisco."
  lang="it"
  path="/"
  detectLocale={true}
  person={true}
>
  <Occhiello />
  <FasciaNumeri />
  <IlProblema />
  <ComeLavoro />
  <LeProve />
  <BloccoFormazione />
  <DaDoveViene />
  <Contatto />
</BaseLayout>
