// --- LeProve ---
// `projects.ts` contiene ormai anche «Portale ricambi 3D» (task 6/11), ma
// i testi restano scritti qui alla lettera dalla tavola invece di essere
// riletti da lì: i tre corpi di questa sezione sono più corti di quelli
// di /lavori. Gli `href` vengono risolti qui, non più segnaposto
// (bloccante 4, revisione finale del ramo sito-italiano): due portano
// alle schede vere in /lavori, Spannum al prodotto esterno.
const leProve = {
  occhiello: 'Le prove',
  titolo: 'Alcune cose che ho costruito',
  prove: [
    {
      eyebrow: 'Meccanica · commessa reale',
      nome: 'Portale ricambi 3D',
      corpo: 'Il cliente apre il modello 3D della macchina che ha comprato, clicca il pezzo che gli serve, e in azienda la richiesta arriva già associata al codice interno di quel componente.',
