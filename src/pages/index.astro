---
// src/pages/index.astro — la home italiana (rotta `/`).
//
// I componenti in src/components/sezioni/ non importano più i propri
// testi: li ricevono come props da qui (task 2, sito-inglese), così la
// home inglese (task 5) può alimentarli con src/data/en/home.ts senza
// toccare i componenti. Le stringhe restano quelle di sempre, alla
// lettera da tavole/Main.dc.html (testi.md, sezione «/ — home»).
import BaseLayout from '../layouts/BaseLayout.astro';
import Occhiello from '../components/sezioni/Occhiello.astro';
import FasciaNumeri from '../components/sezioni/FasciaNumeri.astro';
import IlProblema from '../components/sezioni/IlProblema.astro';
import ComeLavoro from '../components/sezioni/ComeLavoro.astro';
import LeProve from '../components/sezioni/LeProve.astro';
import BloccoFormazione from '../components/sezioni/BloccoFormazione.astro';
import DaDoveViene from '../components/sezioni/DaDoveViene.astro';
import Contatto from '../components/sezioni/Contatto.astro';
import { localizedPath } from '../i18n/ui';
import { emailContatto } from '../data/legale';
import { site } from '../data/site';

const prenotaMezzoraIt = site.it.prenotaMezzora ?? '';

// --- Occhiello ---
const occhiello = {
  eyebrow: "Consulenza e formazione sull'intelligenza artificiale",
  titolo: "Aiuto le aziende a capire|dove serve|l'intelligenza artificiale e poi la costruisco.",
  intro: "Tre anni di dottorato in computer vision, poi due da CTO di una startup che quella ricerca l'ha portata dentro aziende che producono. Adesso lavoro in proprio.",
  ctaPrimaria: prenotaMezzoraIt,
  hrefPrimaria: `${localizedPath('it', '/')}#parliamone`,
  ctaSecondaria: 'Guarda cosa ho costruito',
  credibilita: "Dottorato in computer vision alla Sapienza · Pubblicato a CVPR, ICCV, IROS · Co-fondatore e CTO di Procedo dal 2024 al 2026",
  hrefProcedo: localizedPath('it', '/lavori'),
};

// --- FasciaNumeri ---
// Non sono gli stessi di `pubblicazioni.numeriFascia` (quell'array è per
// la fascia in cima a /ricerca: ordine, terzo e quarto valore ed
// etichette differiscono — «2 anni da CTO» non esiste in quell'array, e
// «citazioni» qui non porta la data).
const numeri = [
  { numero: '10', etichetta: 'articoli pubblicati' },
  { numero: '533', etichetta: 'citazioni' },
  { numero: '1', etichetta: 'Best Paper Award' },
  { numero: '2', etichetta: 'anni da CTO' },
];

// --- IlProblema ---
const ilProblema = {
  occhiello: 'Il problema',
  titolo: 'Le tre cose che mi vengono raccontate più spesso',
  riquadri: [
    {
      citazione: '«Mi serve questo pezzo.»',
      corpo: 'Arriva una mail con una foto storta. Prima di poter fare un preventivo bisogna capire di quale componente si tratti, e succede che ci si mettano in due per un paio di giorni.',
    },
    {
      citazione: '«Lo sa fare solo Bruno.»',
      corpo: "Quarant'anni di mestiere che stanno nella testa di una persona sola. Nessuno ha mai avuto il tempo di metterli per iscritto, e fra due anni Bruno va in pensione.",
    },
    {
      citazione: '«Abbiamo provato ChatGPT.»',
      corpo: "Qualcuno in ufficio ha cominciato a usarlo per conto suo. Non è chiaro con quali documenti, né se l'azienda sia d'accordo, e finora nessuno ha avuto occasione di parlarne.",
    },
  ],
};

// --- ComeLavoro ---
// I quattro passi sono un riassunto per la home, con nomi e testi propri
// (Ascolto/Diagnosi/Costruisco/Resto): non coincidono con `ingaggi` di
// src/data/servizi.ts (Capire/Decidere/Costruire/Mantenere), che è la
// versione estesa per /servizi.
const comeLavoro = {
  occhiello: 'Come lavoro',
  titolo: 'Come si svolge di solito un lavoro',
  intro: 'Quattro passi. Ci si può fermare dopo ognuno, e quello che è stato fatto fino a lì resta comunque tuo.',
  passi: [
    {
      numero: '01',
      nome: 'Ascolto',
      corpo: "Passo mezza giornata in azienda, insieme alle persone che fanno il lavoro tutti i giorni. Serve a me per capire come funzionate, e a te per farti un'idea di come ragiono.",
      neEsce: 'Una lista dei punti dove si perde tempo, ordinata per quanto costano.',
    },
    {
      numero: '02',
      nome: 'Diagnosi',
      corpo: 'Due o tre settimane per guardare i dati che avete davvero, i gestionali già in uso e chi si occupa di cosa. Alla fine scrivo cosa converrebbe fare, in che ordine, e quali strade lascerei perdere.',
      neEsce: 'Un documento che resta tuo, e che puoi far leggere a chi vuoi.',
    },
    {
      numero: '03',
      nome: 'Costruisco',
      corpo: 'Comincio sempre dalla parte che potrebbe non funzionare, così se qualcosa si rivela impossibile lo scopriamo presto, quando cambiare strada costa ancora poco.',
      neEsce: 'Qualcosa che i tuoi aprono il lunedì mattina e usano davvero.',
    },
    {
      numero: '04',
      nome: 'Resto',
      corpo: 'Un software che nessuno cura smette di essere utile nel giro di qualche mese. Se serve restiamo in contatto: manutenzione, server e le modifiche che vengono fuori strada facendo.',
