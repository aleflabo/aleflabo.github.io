---
// src/pages/index.astro — la home italiana (rotta `/`).
//
// I componenti in src/components/sezioni/ non importano più i propri
// testi: li ricevono come props da qui (task 2, sito-inglese), così la
// home inglese (task 5) può alimentarli con src/data/en/home.ts senza
// toccare i componenti. Le stringhe restano quelle di sempre, alla
// lettera da tavole/Main.dc.html (testi.md, sezione «/ — home»).
import BaseLayout from '../layouts/BaseLayout.astro';
import Testata from '../components/lab/Testata.astro';
import Numeri from '../components/lab/Numeri.astro';
import Porte from '../components/lab/Porte.astro';
import Fascia from '../components/lab/Fascia.astro';
import RigheLavori from '../components/lab/RigheLavori.astro';
import { getProject, projects } from '../data/projects';
import { annoIt } from '../lib/anno';
import { homeLab } from '../data/homeLab';
import Contatto from '../components/sezioni/Contatto.astro';
import { localizedPath } from '../i18n/ui';
import { emailContatto } from '../data/legale';
import { ingaggi } from '../data/servizi';
import { attivita } from '../lib/datiStrutturati';


// --- Contatto ---
// Il modulo resta inerte (nessun `action`): il servizio non è ancora
// collegato. Dei tre canali alternativi WhatsApp e mail hanno un recapito
// vero; il calendario non ha `href` e per questo non viene reso affatto —
// v. il commento in Contatto.astro. L'indirizzo è lo stesso delle
// informative e vive in `emailContatto`, un punto solo per tutto il sito.
const contatto = {
  eyebrow: 'Parliamone',
  titolo: "Mezz'ora per capire se possiamo lavorare insieme",
  intro: 'Se non è il lavoro giusto per me te lo dico subito, e se conosco qualcuno più adatto ti metto in contatto.',
  campoAzienda: { etichetta: 'Azienda', placeholder: 'Ragione sociale' },
  campoContatto: { etichetta: 'Come ti scrivo', placeholder: 'Mail o telefono' },
  campoRichiesta: { etichetta: 'Cosa vorresti smettere di fare a mano', placeholder: 'Bastano due righe, anche buttate lì' },
  legendaUrgenza: 'Quanto è urgente',
  opzioniUrgenza: [
    { valore: 'sto-guardando', etichetta: 'Sto solo guardando' },
    { valore: 'questanno', etichetta: "Quest'anno", checked: true },
    { valore: 'problema-adesso', etichetta: 'Ho un problema adesso' },
  ],
  invia: 'Manda',
  notaInerte: 'Modulo non ancora attivo.',
  introAlternativa: 'Oppure, se preferisci saltare il modulo:',
  canali: [
    { etichetta: 'Scegli tu mezz\'ora sul calendario' },
    { etichetta: 'WhatsApp', href: 'https://wa.me/393467202432' },
    { etichetta: 'Mail', href: `mailto:${emailContatto}` },
  ],
};
// --- Dati strutturati ---
// `ProfessionalService` con i quattro modi di lavorare insieme e le aree
// servite. `Person` e `WebSite` non stanno qui: li mette BaseLayout su ogni
// pagina. Il dominio arriva da `Astro.site`, come il canonico.
const dominio = Astro.site!.toString().replace(/\/$/, '');
const datiStrutturati = [
  attivita({
    site: dominio,
    lang: 'it',
    servizi: ingaggi.map((i) => ({ nome: i.nome, descrizione: i.corpo[0] })),
  }),
];
// --- Lavori a righe (Laboratorio) ---
// Nome, anno e immagine da projects.ts; categoria e descrizione da homeLab
// (prime frasi delle schede approvate). Il contatore si calcola.
const righeLavori = {
  titolo: homeLab.it.lavori.titolo,
  contatore: `4 di ${projects.length} · /lavori`,
  tutti: homeLab.it.lavori.tutti,
  hrefTutti: localizedPath('it', '/lavori'),
  righe: homeLab.it.lavori.righe.map((r) => {
    const p = getProject(r.slug)!;
    return { ...r, nome: p.name, anno: annoIt(p.year), href: localizedPath('it', `/lavori/${r.slug}`), anteprima: p.anteprima };
  }),
};

---

<BaseLayout
  title="Consulenza e formazione AI — Alessandro Flaborea"
  description="Aiuto le aziende a capire dove serve l'intelligenza artificiale e poi la costruisco. Da Venezia, in Veneto e Friuli di persona, altrove da remoto."
  lang="it"
  path="/"
  pathEn="/"
  datiStrutturati={datiStrutturati}
>
  <Testata lang="it" t={homeLab.it} />
  <Numeri numeri={homeLab.it.numeri} />
  <Porte porte={homeLab.it.porte} />
  <RigheLavori {...righeLavori} />
  <Fascia voci={homeLab.it.stack} />
  <Contatto {...contatto} eyebrow={undefined} />
</BaseLayout>
