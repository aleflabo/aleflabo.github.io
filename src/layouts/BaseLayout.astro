---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '../styles/tokens.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ritratto from '../assets/alessandro-flaborea.jpg';
import { localizedPath } from '../i18n/ui';
import { emailContatto } from '../data/legale';
import { persona, sitoWeb } from '../lib/datiStrutturati';
import { descrizioneMeta } from '../lib/descrizione';

interface Props {
  title: string;
  description: string;
  lang: 'en' | 'it';
  path: string;
  // Gemella nell'altra lingua, quando esiste (task 1/bloccante): senza
  // prefisso di lingua, nello stesso formato di `path`. `pathEn` è il
  // percorso della pagina inglese gemella (usato quando `lang` è 'it');
  // `pathIt` è il percorso della pagina italiana gemella (quando `lang` è
  // 'en'). Se assente, niente <link hreflang> verso l'altra lingua e
  // niente interruttore in Nav: molte pagine italiane non hanno ancora un
  // equivalente inglese (solo 17 rotte su altrettante non esistono in
  // /en/), quindi l'alternato va dichiarato esplicitamente pagina per
  // pagina, non calcolato sempre a partire da `path`.
  pathEn?: string;
  pathIt?: string;
  ogType?: 'website' | 'article';
  // Pagina d'errore: sopprime `<link rel="canonical">` e gli `hreflang`.
  // La 404 di GitHub Pages viene servita a ogni indirizzo inesistente, quindi
  // un canonico la dichiarerebbe versione ufficiale di se stessa e un
  // alternato prometterebbe una gemella in un'altra lingua che non esiste —
  // per una pagina che, di sua natura, non ha né l'una né l'altra.
  paginaErrore?: boolean;
  // Dati strutturati propri di questa pagina (FAQPage, ItemList delle
  // pubblicazioni, BreadcrumbList, CreativeWork…), già costruiti dalle
  // funzioni di src/lib/datiStrutturati.ts. `Person` e `WebSite` non stanno
  // qui: li mette il layout su ogni pagina, vedi sotto.
  datiStrutturati?: unknown[];
  attiva?: string;
}
const {
  title,
  description,
  lang,
  path,
  pathEn,
  pathIt,
  ogType = 'website',
  paginaErrore = false,
  datiStrutturati = [],
  attiva,
} = Astro.props;

// La descrizione passa da `descrizioneMeta`, in un punto solo per tutte le
// pagine: quattro dichiaravano più di 240 caratteri — /chi-sono ne dichiarava
// 375 — e Google le tagliava a metà frase. Il taglio avviene per frasi
// intere, quindi quello che resta è testo approvato, solo più corto.
const descrizioneBreve = descrizioneMeta(description);

const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://flaborea.com';
const canonicalUrl = `${site}${localizedPath(lang, path)}`;
// Percorso relativo (senza dominio) verso l'altra lingua: esplicito via
// `pathEn`/`pathIt` quando fornito, altrimenti — solo per la lingua
// corrente, cioè l'autoreferenza — ricavato da `path`.
const relEnUrl = pathEn !== undefined
  ? localizedPath('en', pathEn)
  : lang === 'en'
    ? localizedPath('en', path)
    : undefined;
const relItUrl = pathIt !== undefined
  ? localizedPath('it', pathIt)
  : lang === 'it'
    ? localizedPath('it', path)
    : undefined;
const enUrl = relEnUrl !== undefined ? `${site}${relEnUrl}` : undefined;
const itUrl = relItUrl !== undefined ? `${site}${relItUrl}` : undefined;
// Il percorso da dare al selettore di lingua nel Nav: quello dell'ALTRA
// lingua rispetto a quella corrente. Assente (niente interruttore) quando
// quella pagina non ha una gemella nell'altra lingua.
const hrefAltro = lang === 'it' ? relEnUrl : relItUrl;
const ogImage = `${site}/og.png`;
// L'italiano è la versione da servire a chi non corrisponde a nessun
// `hreflang`: è la lingua predefinita del sito e la sola che copre tutte le
// rotte. Senza `x-default` quella scelta la fa Google per conto suo.
const xDefaultUrl = itUrl ?? canonicalUrl;
const ogLocale = lang === 'it' ? 'it_IT' : 'en_GB';
const ogLocaleAlt = lang === 'it' ? 'en_GB' : 'it_IT';

// `Person` e `WebSite` su ogni pagina, non solo sulle due home. Un motore
// generativo che incontra una scheda di lavoro senza mai passare dalla home
// non ha altrimenti modo di sapere di chi sta leggendo: l'`@id` è l'ancora,
// e ripeterlo costa meno di un kilobyte per pagina.
const comuni = [
  persona({ site, lang, immagine: `${site}${ritratto.src}`, email: emailContatto }),
  sitoWeb({ site, lang }),
];
const blocchiLd = [...comuni, ...datiStrutturati];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={descrizioneBreve} />
    <meta name="author" content="Alessandro Flaborea" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!paginaErrore && <link rel="canonical" href={canonicalUrl} />}
    {!paginaErrore && enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {!paginaErrore && itUrl && <link rel="alternate" hreflang="it" href={itUrl} />}
    {!paginaErrore && <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />}
    {/* Il feed esisteva e non era dichiarato da nessuna parte: era
        raggiungibile solo da chi ne conosceva l'indirizzo a memoria. */}
    <link rel="alternate" type="application/rss+xml" title="Alessandro Flaborea" href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={descrizioneBreve} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Alessandro Flaborea" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={descrizioneBreve} />
    <meta name="twitter:image" content={ogImage} />
    {blocchiLd.map((blocco) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(blocco)} />
    ))}
  </head>
  <body>
    <a class="salta-al-contenuto" href="#contenuto">{lang === 'it' ? 'Salta al contenuto' : 'Skip to content'}</a>
    <Nav lang={lang} hrefAltro={hrefAltro} attiva={attiva} />
    <main id="contenuto"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
