---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '../styles/tokens.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { localizedPath } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: 'en' | 'it';
  path: string;
  ogType?: 'website' | 'article';
  detectLocale?: boolean;
  person?: boolean;
  attiva?: string;
}
const {
  title,
  description,
  lang,
  path,
  ogType = 'website',
  detectLocale = false,
  person = false,
  attiva,
} = Astro.props;

const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://aleflabo.github.io';
const canonicalUrl = `${site}${localizedPath(lang, path)}`;
const enUrl = `${site}${localizedPath('en', path)}`;
const itUrl = `${site}${localizedPath('it', path)}`;
const ogImage = `${site}/og.png`;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Alessandro Flaborea',
  url: 'https://aleflabo.github.io',
  jobTitle: 'AI consultant and trainer',
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Sapienza University of Rome' },
  knowsAbout: [
    'Computer Vision',
    'Large Language Models',
    'Agentic AI',
    'Retrieval-Augmented Generation',
    'Machine Learning',
    'Data Engineering',
  ],
  sameAs: [
    'https://www.linkedin.com/in/alessandro-flaborea',
    'https://github.com/aleflabo',
    'https://scholar.google.com/citations?user=HHDHIVoAAAAJ',
  ],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {detectLocale && (
      <script is:inline>
        (function () {
          try {
            if (localStorage.getItem('lang-chosen')) return;
            var langs = navigator.languages || [navigator.language || ''];
            var pref = null;
            for (var i = 0; i < langs.length; i++) {
              var l = (langs[i] || '').toLowerCase();
              if (l.indexOf('it') === 0) { pref = 'it'; break; }
              if (l.indexOf('en') === 0) { pref = 'en'; break; }
            }
            if (pref === 'en') { location.replace('/en/'); }
          } catch (e) {}
        })();
      </script>
    )}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="it" href={itUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {person && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(personLd)} />
    )}
  </head>
  <body>
    <Nav lang={lang} path={path} attiva={attiva} />
    <main><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
