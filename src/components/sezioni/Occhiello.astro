---
// I testi (e gli href, già risolti per la lingua) arrivano dalla pagina:
// nessun import da src/data/ qui dentro (task 2, sito-inglese).
interface Props {
  eyebrow: string;
  // Titolo con "|" a separare le tre parti: prima|parola-evidenziata|dopo.
  titolo: string;
  intro: string;
  ctaPrimaria: string;
  hrefPrimaria: string;
  ctaSecondaria: string;
  // Contiene la parola "Procedo" (o "Procedo" stesso in inglese): quella
  // parola diventa il link a hrefProcedo, il resto resta testo piano.
  credibilita: string;
  hrefProcedo: string;
}
const { eyebrow, titolo, intro, ctaPrimaria, hrefPrimaria, ctaSecondaria, credibilita, hrefProcedo } = Astro.props;

// Titolo (h1) spezzato in uno <span class="w"> per parola, con ritardi
// progressivi. «dove serve» resta un'unica «parola» del titolo, ma .marker
// va su uno <span> ANNIDATO dentro il .w esterno, non sullo stesso
// elemento: .w e .marker dichiarano entrambe `animation` con la stessa
// specificità, e in global.css .w è definita dopo .marker, quindi sullo
// stesso nodo vincerebbe sempre .w e l'evidenziatore non partirebbe mai
// (difetto trovato in revisione, correzione 1 del task 8 — vedi
// task-8-report.md). Annidare separa le due animazioni: entrata della
// parola sullo span esterno, riempimento dell'evidenziatore su quello
// interno. Testo alla lettera da tavole/Main.dc.html (e testi.md, sezione
// «/ — home»).
const [prima, marcata, dopo] = titolo.split('|');
const parole = [
  ...prima.split(' ').map((testo) => ({ testo, marker: false })),
  { testo: marcata, marker: true },
  ...dopo.split(' ').map((testo) => ({ testo, marker: false })),
];

// Si isola la parola "Procedo" dal resto della frase per farne un link,
// invece di spezzare la frase a mano.
const brandIndex = credibilita.indexOf('Procedo');
const hasBrand = brandIndex >= 0;
const credibilitaPrima = hasBrand ? credibilita.slice(0, brandIndex) : credibilita;
const credibilitaDopo = hasBrand ? credibilita.slice(brandIndex + 'Procedo'.length) : '';
---

<section class="occhiello">
  <div class="alone" aria-hidden="true"></div>
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h1>
      {parole.map((p, i) => (
        <>
          <span class="w" style={`animation-delay: ${0.22 + i * 0.06}s`}>{p.marker ? <span class="marker">{p.testo}</span> : p.testo}</span>{' '}
        </>
      ))}
    </h1>
    <div class="divider"></div>
    <p class="intro">{intro}</p>
    <div class="cta-row">
      {/* href="#" era morto come le tre schede di LeProve (bloccante 4):
          la sezione #parliamone è su questa stessa pagina, come già fanno
          Footer e formazione.astro per lo stesso pulsante (trovato durante
          la centralizzazione del testo, task 9). */}
      <a class="pulsante primaria" href={hrefPrimaria}>{ctaPrimaria} <span class="freccia">&rarr;</span></a>
      <a class="secondaria" href="#le-prove">{ctaSecondaria}</a>
    </div>
    <p class="credibilita">{hasBrand ? (
      <>{credibilitaPrima}<a href={hrefProcedo}>Procedo</a>{credibilitaDopo}</>
    ) : credibilita}</p>
  </div>
</section>

<style>
  .occhiello {
    position: relative;
    overflow: hidden;
    padding: 0;
  }
  .alone {
    position: absolute;
    top: -260px;
    right: -220px;
    width: 700px;
    height: 700px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(168 83 29 / 9%), rgb(168 83 29 / 0%) 70%);
    pointer-events: none;
  }
  .container {
    position: relative;
    padding: 92px 24px 64px;
  }
  .eyebrow {
    font-size: 11.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--azione);
    font-weight: 700;
  }
  h1 {
    margin-top: 26px;
    font-size: 66px;
    max-width: 19ch;
    line-height: 1.04;
  }
  .divider {
    margin: 38px 0;
  }
  .intro {
    font-size: 20px;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 54ch;
  }
  .cta-row {
    display: flex;
    align-items: center;
    gap: 26px;
    margin-top: 40px;
  }
  .primaria {
    background: var(--azione);
    color: var(--surface);
    font-size: 15px;
    font-weight: 600;
    padding: 15px 30px;
    border-radius: var(--radius);
  }
  .secondaria {
    font-size: 15px;
    font-weight: 600;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .credibilita {
    margin-top: 46px;
    font-size: 14px;
    color: #7a736a;
  }
  .credibilita a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .container {
      padding: 44px 20px 40px;
    }
    .eyebrow {
      font-size: 10.5px;
      letter-spacing: 0.18em;
      line-height: 1.5;
      max-width: 22ch;
    }
    h1 {
      margin-top: 18px;
      font-size: 34px;
      max-width: none;
      text-wrap: pretty;
    }
    .divider {
      margin: 26px 0;
    }
    .intro {
      font-size: 16.5px;
      line-height: 1.55;
      max-width: none;
      text-wrap: pretty;
    }
    .cta-row {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
      margin-top: 30px;
    }
    .primaria {
      font-size: 16px;
      padding: 16px 24px;
      text-align: center;
    }
    .secondaria {
      font-size: 15px;
      color: var(--text);
      text-align: center;
      padding: 12px;
      text-underline-offset: 4px;
    }
    .credibilita {
      margin-top: 32px;
      font-size: 13.5px;
      line-height: 1.6;
      color: var(--text-muted);
    }
  }
</style>
