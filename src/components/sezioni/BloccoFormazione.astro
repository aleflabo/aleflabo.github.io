---
// I testi (e l'href, già risolto per la lingua) arrivano dalla pagina
// (task 2, sito-inglese). `ore` e `nome` coincidono con `formati` di
// src/data/formazione.ts, ma il corpo di ogni scheda è un riassunto
// proprio della home, diverso da `formati[].corpo` (la versione estesa è
// per /formazione, task 10).
interface Props {
  occhiello: string;
  titolo: string;
  introduzioni: string[];
  formati: { ore: string; nome: string; corpo: string }[];
  chiusura: string;
  linkChiusura: string;
  hrefChiusura: string;
}
const { occhiello, titolo, introduzioni, formati, chiusura, linkChiusura, hrefChiusura } = Astro.props;
---

<section class="blocco-formazione">
  <div class="container">
    <p class="label">{occhiello}</p>
    <h2 class="section-title">{titolo}</h2>
    {introduzioni.map((intro) => <p class="intro">{intro}</p>)}
    <div class="griglia">
      {formati.map((f) => (
        <div class="scheda">
          <p class="eyebrow">{f.ore}</p>
          <h3>{f.nome}</h3>
          <p class="corpo">{f.corpo}</p>
        </div>
      ))}
    </div>
    <p class="chiusura">{chiusura} <a href={hrefChiusura}>{linkChiusura} <span class="freccia">&rarr;</span></a></p>
  </div>
</section>

<style>
  .blocco-formazione {
    border-top: 1px solid var(--border);
    padding: 0;
  }
  .container {
    padding: 72px 24px;
  }
  .section-title {
    font-size: 32px;
    margin-top: 18px;
    margin-bottom: 14px;
    max-width: 32ch;
  }
  .intro {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 64ch;
    margin-bottom: 18px;
  }
  .intro:last-of-type {
    margin-bottom: 40px;
  }
  .griglia {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }
  .scheda {
    border-left: 1px solid var(--border);
    padding-left: 22px;
  }
  .scheda .eyebrow {
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--azione);
    font-weight: 700;
    margin-bottom: 8px;
  }
  .scheda h3 {
    font-size: 19px;
  }
  .scheda .corpo {
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-muted);
  }
  .chiusura {
    margin-top: 34px;
    font-size: 15px;
    color: var(--text-muted);
  }
  .chiusura a {
    font-weight: 600;
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .container {
      padding: 48px 20px;
    }
    .section-title {
      font-size: 26px;
      margin-top: 14px;
      margin-bottom: 12px;
      max-width: none;
    }
    .intro {
      font-size: 15px;
      max-width: none;
    }
    .intro:last-of-type {
      margin-bottom: 28px;
    }
    .griglia {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .chiusura {
      margin-top: 26px;
    }
  }
</style>
