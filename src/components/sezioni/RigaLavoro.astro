---
// Una riga di /lavori: anno a sinistra, poi occhiello (area · stato), nome,
// corpo e tag. Misure alla lettera da tavole/Lavori.dc.html (testi.md,
// sezione «/lavori»). Se `href` manca la riga non è cliccabile: è il caso di
// Paesello e del video generativo, che non hanno una scheda propria
// (task-11-brief.md, mappa delle rotte: +2 case study soli, non 4).
interface Props {
  anno: string;
  areaStato: string;
  nome: string;
  corpo: string;
  tagIt: string[];
  href?: string;
}
const { anno, areaStato, nome, corpo, tagIt, href } = Astro.props;
const Tag = href ? 'a' : 'div';
// L'etichetta di stato («In costruzione», «In produzione», «Online e
// pubblico»…) ha il bordo verde: è l'informazione che chi legge cerca per
// prima. Le altre etichette restano neutre.
const eStato = (t: string) => /^(In |Online|Live)/.test(t);
---

<Tag class="riga" {...(href ? { href } : {})}>
  <span class="anno mono">{anno}</span>
  <div class="corpo-riga">
    <h3>{nome}</h3>
    <p class="testo">{corpo}</p>
    <div class="tag">
      {tagIt.map((t) => <span class:list={['mono', { stato: eStato(t) }]}>{t}</span>)}
    </div>
    <slot />
  </div>
  <p class="area mono">{areaStato}</p>
</Tag>

<style>
  /* Una riga dei lavori nel Laboratorio: anno, nome e testo, area e stato a
     destra in mono. Niente occhiello sopra il titolo (spec 2026-11-08). La
     classe resta `riga`: il contatore della home conta queste righe. */
  .riga {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr) 190px;
    gap: 18px;
    padding: 22px 0;
    border-top: 1px solid var(--filo);
    align-items: baseline;
  }
  .anno, .area { font-size: 0.75rem; color: var(--muto); }
  .area { text-align: right; text-transform: lowercase; }
  h3 { font-size: 1.875rem; letter-spacing: -0.045em; line-height: 1; transition: color 0.25s; }
  a.riga:hover h3 { color: var(--rilevamento-testo); }
  .testo { margin-top: 8px; font-size: 0.9375rem; line-height: 1.55; color: var(--muto); max-width: 62ch; }
  .tag { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .tag span {
    font-size: 0.6875rem;
    color: var(--muto);
    border: 1px solid var(--filo);
    border-radius: 4px;
    padding: 3px 7px;
    background: var(--bianco);
  }
  .tag .stato { border-color: var(--vivo); color: #0f7a49; }
  @media (max-width: 820px) {
    .riga { grid-template-columns: 1fr; gap: 6px; }
    .area { text-align: left; order: -1; }
  }
</style>
