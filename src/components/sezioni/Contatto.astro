---
import type { Locale } from '../../i18n/ui';
import { moduloContatto } from '../../data/modulo';
import { attributiModulo } from '../../lib/modulo';
// I testi arrivano dalla pagina (task 2, sito-inglese). Il modulo resta
// inerte (nessun `action`) e i pulsanti di prenotazione, WhatsApp e mail
// restano segnaposto (`href="#"`): non è stato scelto nessun servizio
// esterno né inventato un numero, per istruzione esplicita del task 8.
// Che sia inerte è deciso; che simuli l'invio no (bloccante 7, revisione
// finale del ramo sito-italiano): senza `action` un submit fa una GET
// sulla stessa pagina, che si ricarica con i campi in query string, e
// sembra che il messaggio sia partito. `onsubmit="return false"` blocca
// quella GET; il pulsante disabilitato e la nota sotto dicono perché.
interface CampoTesto {
  etichetta: string;
  placeholder: string;
}
interface OpzioneUrgenza {
  valore: string;
  etichetta: string;
  checked?: boolean;
}
interface Props {
  lang: Locale;
  // La riga accanto al pulsante, mostrata solo a modulo acceso.
  linkInformativa: { testo: string; href: string };
  // La riga in mono sopra il titolo («#parliamone»), solo dove c'è testo
  // approvato: in inglese non c'è, e l'àncora italiana non si mostra.
  ancora?: string;
  // Facoltativo (task 14, home-visuale): l'occhiello «Parliamone» sparisce
  // dalla potatura anti-slop (tetto di un occhiello ogni tre sezioni, la
  // home ne aveva nove — una veniva da
  // questa sezione). Il titolo resta e basta.
  // L'id "parliamone" sulla <section>, a cui punta la barra di navigazione,
  // non cambia: sparisce solo l'etichetta visibile, non l'ancora.
  eyebrow?: string;
  titolo: string;
  intro: string;
  campoAzienda: CampoTesto;
  campoContatto: CampoTesto;
  campoRichiesta: CampoTesto;
  legendaUrgenza: string;
  opzioniUrgenza: OpzioneUrgenza[];
  invia: string;
  notaInerte: string;
  introAlternativa: string;
  // Tre canali, ordine fisso: calendario, WhatsApp, mail (le icone restano
  // qui). `href` è facoltativo, e **un canale senza href non viene reso**:
  // prima erano tre pulsanti che puntavano tutti a `href="#"`, cioè tre inviti
  // a fare qualcosa che non succedeva. Meglio offrirne uno che funziona che
  // tre che non funzionano.
  canali: { etichetta: string; href?: string }[];
}
const {
  lang,
  linkInformativa,
  ancora,
  eyebrow,
  titolo,
  intro,
  campoAzienda,
  campoContatto,
  campoRichiesta,
  legendaUrgenza,
  opzioniUrgenza,
  invia,
  notaInerte,
  introAlternativa,
  canali,
} = Astro.props;
const modulo = attributiModulo(moduloContatto, lang, Astro.site!.toString());
const acceso = Boolean(modulo.action);
---

<section class="contatto" id="parliamone">
  <div class="foglio">
    <div class="testa">
      {ancora && <p class="ancora mono" aria-hidden="true">{ancora}</p>}
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 class="titolo">{titolo}</h2>
      <p class="intro">{intro}</p>
    </div>
    <div class="scheda">

    {/* Spento: nessun `action`, il modulo non invia niente. Acceso: POST semplice a
        Web3Forms, senza script (src/data/modulo.ts). */}
    <form class="modulo" action={modulo.action} method={modulo.method} onsubmit={acceso ? undefined : 'return false'}>
      {Object.entries(modulo.nascosti).map(([n, v]) => <input type="hidden" name={n} value={v} />)}
      {acceso && <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />}
      <div class="campo">
        <label for="azienda">{campoAzienda.etichetta}</label>
        <input type="text" id="azienda" name="azienda" placeholder={campoAzienda.placeholder} />
      </div>
      <div class="campo">
        <label for="contatto-mail">{campoContatto.etichetta}</label>
        <input type="text" id="contatto-mail" name="contatto" placeholder={campoContatto.placeholder} required={acceso} />
      </div>
      <div class="campo largo">
        <label for="richiesta">{campoRichiesta.etichetta}</label>
        <textarea id="richiesta" name="richiesta" rows="3" placeholder={campoRichiesta.placeholder} required={acceso}></textarea>
      </div>
      <fieldset class="campo largo urgenza">
        <legend>{legendaUrgenza}</legend>
        <div class="pillole">
          {opzioniUrgenza.map((opzione) => (
            <label class="pillola">
              <input type="radio" name="urgenza" value={opzione.valore} checked={opzione.checked} />
              <span>{opzione.etichetta}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <div class="invia">
        <button type="submit" class="pulsante" disabled={!acceso}>{invia}</button>
        {!acceso && notaInerte && <p class="nota-inerte">{notaInerte}</p>}
        {acceso && <a class="informativa" href={linkInformativa.href}>{linkInformativa.testo}</a>}
      </div>
    </form>

    <div class="alternativa">
      <p class="intro-alt">{introAlternativa}</p>
      <div class="canali">
        {canali[0].href && (
          <a href={canali[0].href} class="canale" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg>
            {canali[0].etichetta}
          </a>
        )}
        {canali[1].href && (
          <a href={canali[1].href} class="canale" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.5 8.5 0 0 1-3.9-.9L3 21l1.9-5a8.4 8.4 0 0 1-.9-3.9 8.4 8.4 0 0 1 8.4-9 8.5 8.5 0 0 1 8.6 8.4Z"></path></svg>
            {canali[1].etichetta}
          </a>
        )}
        {canali[2].href && (
          <a href={canali[2].href} class="canale">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m2 7 10 6 10-6"></path></svg>
            {canali[2].etichetta}
          </a>
        )}
      </div>
    </div>
    </div>
  </div>
</section>

<style>
  /* Il blocco di contatto del Laboratorio (mockup 2026-11-08, scheda «pezzi»):
     sul fondo carta, non più la fascia blu scura. Il modulo è ancora spento:
     Web3Forms arriva con la tappa 3. Contrasti misurati per AA: placeholder
     #626977 su carta 5,2:1, nota e testi secondari in --muto 5,6:1. */
  .contatto { padding: 0; border-bottom: 1px solid var(--filo); }
  .foglio {
    max-width: var(--maxw-lab);
    margin: 0 auto;
    border-inline: 1px solid var(--filo);
    padding: 44px 28px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 40px;
    align-items: start;
  }
  .ancora { font-size: 0.75rem; color: var(--muto); }
  .eyebrow { font-family: var(--font-mono); font-size: 0.75rem; color: var(--muto); }
  .titolo { font-size: clamp(1.625rem, 3.4vw, 2.375rem); margin: 6px 0 12px; }
  .intro { color: var(--muto); line-height: 1.55; max-width: 44ch; }
  .scheda { background: var(--bianco); border: 1px solid var(--filo); border-radius: 10px; padding: 20px; display: grid; gap: 14px; }
  .modulo { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 16px; }
  .campo { display: grid; gap: 6px; min-width: 0; }
  .largo { grid-column: 1 / -1; }
  label, legend { font-family: var(--font-mono); font-size: 0.75rem; color: var(--muto); }
  input[type="text"], textarea {
    font: 400 0.9375rem var(--font-testo);
    color: var(--inchiostro);
    background: var(--carta);
    border: 1px solid var(--filo);
    border-radius: var(--raggio-piccolo);
    padding: 11px 12px;
    width: 100%;
  }
  input::placeholder, textarea::placeholder { color: #626977; }
  textarea { resize: vertical; }
  .urgenza { border: 0; padding: 0; margin: 0; display: grid; gap: 8px; }
  .pillole { display: flex; flex-wrap: wrap; gap: 8px; }
  .pillola {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 12px;
    border: 1px solid var(--filo);
    border-radius: var(--raggio-piccolo);
    font: 400 0.8125rem var(--font-testo);
    color: var(--inchiostro);
    cursor: pointer;
  }
  .pillola:has(input:checked) { border-color: var(--inchiostro); background: var(--carta); }
  .pillola input { accent-color: var(--rilevamento-testo); }
  .invia { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 14px; padding-top: 4px; }
  button {
    font: 500 0.875rem var(--font-testo);
    background: var(--filo);
    color: var(--muto);
    border: 0;
    border-radius: var(--raggio-piccolo);
    padding: 12px 18px;
    min-height: 44px;
  }
  button:disabled { cursor: not-allowed; }
  button:not(:disabled) { background: var(--rilevamento-testo); color: var(--bianco); cursor: pointer; }
  .botcheck { display: none; }
  .informativa { font-family: var(--font-mono); font-size: 0.75rem; color: var(--muto); text-decoration: underline; text-underline-offset: 3px; }
  .nota-inerte { font-family: var(--font-mono); font-size: 0.75rem; color: var(--muto); }
  .alternativa { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; border-top: 1px dashed var(--filo); padding-top: 14px; }
  .intro-alt { font-size: 0.875rem; color: var(--muto); }
  .canali { display: flex; flex-wrap: wrap; gap: 10px; }
  .canale {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--filo);
    border-radius: var(--raggio-piccolo);
    background: var(--bianco);
    font-weight: 500;
    font-size: 0.875rem;
    color: var(--inchiostro);
    transition: border-color 0.2s;
  }
  .canale:hover { border-color: var(--inchiostro); }
  @media (max-width: 820px) {
    .foglio { grid-template-columns: 1fr; padding-inline: 16px; gap: 24px; }
    .modulo { grid-template-columns: 1fr; }
  }
</style>
