---
// I testi arrivano dalla pagina (task 2, sito-inglese). Il modulo resta
// inerte (nessun `action`) e i pulsanti di prenotazione, WhatsApp e mail
// restano segnaposto (`href="#"`): non è stato scelto nessun servizio
// esterno né inventato un numero, per istruzione esplicita del task 8.
// Che sia inerte è deciso; che simuli l'invio no (bloccante 7, revisione
// finale del ramo sito-italiano): senza `action` un submit fa una GET
// sulla stessa pagina, che si ricarica con i campi in query string, e
// sembra che il messaggio sia partito. `onsubmit="return false"` blocca
// quella GET; il pulsante disabilitato e la nota sotto dicono perché.
interface CampoTesto {
  etichetta: string;
  placeholder: string;
}
interface OpzioneUrgenza {
  valore: string;
  etichetta: string;
  checked?: boolean;
}
interface Props {
  eyebrow: string;
  titolo: string;
  intro: string;
  // Il territorio (task 6, home-visuale): la sezione «Dove lavoro» smette di
  // essere una sezione a sé e entra qui sopra, perché chi sta per scrivere
  // è esattamente chi si chiede se si è raggiungibili. **Facoltativa**:
  // `Contatto` la riceve dalla home, ma la usano anche `BaseLayout.astro` e
  // `src/pages/en/notes/index.astro`, che non passano nessun territorio —
  // renderla obbligatoria romperebbe quelle due strade. I testi vengono da
  // `src/data/territorio.ts` (occhiello, titolo, intro, modi): il campo
  // `corpo` di quel file esiste ma la tavola non lo rende qui, quindi non
  // è fra le proprietà che questo componente accetta.
  territorio?: {
    occhiello: string;
    titolo: string;
    intro: string;
    modi: { etichetta: string; dettaglio: string }[];
  };
  campoAzienda: CampoTesto;
  campoContatto: CampoTesto;
  campoRichiesta: CampoTesto;
  legendaUrgenza: string;
  opzioniUrgenza: OpzioneUrgenza[];
  invia: string;
  notaInerte: string;
  introAlternativa: string;
  // Tre canali, ordine fisso: calendario, WhatsApp, mail. Fino alla
  // correzione del task 6 erano pulsanti con un'icona SVG a testa; la
  // tavola del blocco «Parliamone» li rende come pillole di solo testo,
  // uguali nello stile alle pillole dell'urgenza, quindi le icone sono
  // sparite dal markup. `href` resta facoltativo, e **un canale senza
  // href non viene reso**: prima erano tre pulsanti che puntavano tutti
  // a `href="#"`, cioè tre inviti a fare qualcosa che non succedeva.
  // Meglio offrirne uno che funziona che tre che non funzionano.
  canali: { etichetta: string; href?: string }[];
}
const {
  eyebrow,
  titolo,
  intro,
  territorio,
  campoAzienda,
  campoContatto,
  campoRichiesta,
  legendaUrgenza,
  opzioniUrgenza,
  invia,
  notaInerte,
  introAlternativa,
  canali,
} = Astro.props;
---

<section class="contatto" id="parliamone">
  <div class="container">
    {territorio && (
      <div class="territorio">
        <p class="occhiello">{territorio.occhiello}</p>
        <h2 class="luogo">{territorio.titolo}</h2>
        <p class="intro-luogo">{territorio.intro}</p>
        <div class="modi">
          {territorio.modi.map((m) => (
            <p><strong>{m.etichetta}</strong> {m.dettaglio}</p>
          ))}
        </div>
      </div>
    )}
    {/*
      Il blocco «Parliamone» (correzione dopo revisione, ancora task 6): la
      tavola (Main.dc.html, blocco 8) lo rende su una griglia 420px + resto,
      non su un'unica colonna. `.intro-blocco`, `.modulo` e `.alternativa`
      sono tre figli distinti — non due — perché l'ordine cambia con la
      larghezza: sopra i 640px stanno appaiati (testo e "oppure, salta il
      modulo" a sinistra, campi a destra, `.modulo` alto quanto le due
      righe di sinistra messe insieme); sotto i 640px tornano impilati ma
      in un ordine diverso da quello del DOM sopra — prima il testo, poi il
      modulo, e SOLO ALLA FINE «oppure, se preferisci saltare il modulo»
      con i pulsanti (`HomeMobile.dc.html`, stesso blocco). L'ordine nel
      markup segue quello mobile (testo → modulo → alternativa), che è
      anche l'ordine di lettura più sensato senza CSS; le `grid-template-areas`
      qui sotto lo ridispongono per ogni larghezza senza duplicare nulla.
    */}
    <div class="blocco">
      <div class="intro-blocco">
        <p class="eyebrow">{eyebrow}</p>
        <h2 class="titolo">{titolo}</h2>
        <p class="intro">{intro}</p>
      </div>

      <form class="modulo" onsubmit="return false">
        <div class="campo">
          <label for="azienda">{campoAzienda.etichetta}</label>
          <input type="text" id="azienda" name="azienda" placeholder={campoAzienda.placeholder} />
        </div>
        <div class="campo">
          <label for="contatto-mail">{campoContatto.etichetta}</label>
          <input type="text" id="contatto-mail" name="contatto" placeholder={campoContatto.placeholder} />
        </div>
        <div class="campo largo">
          <label for="richiesta">{campoRichiesta.etichetta}</label>
          <textarea id="richiesta" name="richiesta" rows="3" placeholder={campoRichiesta.placeholder}></textarea>
        </div>
        <fieldset class="campo largo urgenza">
          <legend>{legendaUrgenza}</legend>
          <div class="pillole">
            {opzioniUrgenza.map((opzione) => (
              <label class="pillola">
                <input type="radio" name="urgenza" value={opzione.valore} checked={opzione.checked} />
                <span>{opzione.etichetta}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <div class="invia">
          <button type="submit" class="pulsante" disabled>{invia}</button>
          {notaInerte && <p class="nota-inerte">{notaInerte}</p>}
        </div>
      </form>

      <div class="alternativa">
        <p class="intro-alt">{introAlternativa}</p>
        {/*
          La tavola non disegna più le icone dei tre canali (calendario,
          WhatsApp, mail): sono pillole di solo testo, coerenti con le
          pillole dell'urgenza e col pulsante Manda dello stesso blocco.
          Tolgo gli SVG che il componente rendeva finora — l'ordine fisso
          e la guardia `href` (un canale senza recapito non si rende)
          restano quelli di sempre, cambia solo la resa.
        */}
        <div class="canali">
          {canali[0].href && (
            <a href={canali[0].href} class="canale" rel="noopener">{canali[0].etichetta}</a>
          )}
          {canali[1].href && (
            <a href={canali[1].href} class="canale" rel="noopener">{canali[1].etichetta}</a>
          )}
          {canali[2].href && (
            <a href={canali[2].href} class="canale">{canali[2].etichetta}</a>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contatto {
    border-top: 1px solid var(--border);
    background: var(--accent);
    padding: 0;
  }
  .container {
    padding: 72px 24px;
  }

  /* Il territorio (task 6): stessa etichetta e stesso ritmo tipografico
     dell'ex sezione a sé, ma con la palette del fondo scuro — i tre token
     nati col task 2 (--su-accent, --su-accent-forte, --su-accent-debole)
     più --evidenziatore, già in tokens.css, che è lo stesso colore usato
     per l'eyebrow «Parliamone» qui sotto: la tavola le vuole uguali. Chiude
     con un separatore e uno spazio prima del modulo di contatto, che è
     esattamente quanto la tavola (blocco 8) mette fra il divisorio e
     l'eyebrow successivo. */
  .territorio {
    padding-bottom: 34px;
    margin-bottom: 44px;
    border-bottom: 1px solid rgb(255 255 255 / 16%);
  }
  .territorio .occhiello {
    font-size: 11.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--evidenziatore);
    font-weight: 700;
  }
  .territorio .luogo {
    font-size: 26px;
    margin-top: 14px;
    color: var(--surface);
  }
  .territorio .intro-luogo {
    margin-top: 14px;
    margin-bottom: 26px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--su-accent-forte);
    max-width: 66ch;
  }
  .territorio .modi {
    display: flex;
    gap: 56px;
    flex-wrap: wrap;
  }
  .territorio .modi p {
    font-size: 14px;
    color: var(--su-accent);
  }
  .territorio .modi strong {
    color: var(--surface);
    font-weight: 600;
  }
  /* La griglia del blocco «Parliamone» (correzione dopo revisione): la
     tavola la vuole a due colonne — 420px per il testo, il resto per il
     modulo — non a una colonna sola come rendevo prima. `grid-template-areas`
     invece di un semplice `grid-template-columns` perché sopra i 640px
     `.modulo` deve affiancare sia `.intro-blocco` che `.alternativa`
     (spanna le due righe della colonna di sinistra), mentre sotto i 640px
     l'ordine visivo cambia e diventa testo → modulo → alternativa: due
     disposizioni diverse per gli stessi tre elementi, senza duplicare il
     markup. */
  .blocco {
    display: grid;
    grid-template-columns: 420px minmax(0, 1fr);
    grid-template-areas:
      "intro  modulo"
      "alt    modulo";
    column-gap: 64px;
    row-gap: 28px;
    align-items: start;
  }
  .intro-blocco {
    grid-area: intro;
  }
  .alternativa {
    grid-area: alt;
  }
  .eyebrow {
    font-size: 11.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--evidenziatore);
    font-weight: 700;
  }
  .titolo {
    font-size: 32px;
    margin-top: 16px;
    color: var(--surface);
  }
  .intro {
    margin-top: 18px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--su-accent-forte);
  }
  .modulo {
    grid-area: modulo;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }
  .campo {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .campo.largo {
    grid-column: span 2;
  }
  .campo label,
  .urgenza legend {
    font-size: 13px;
    color: var(--su-accent);
  }
  .campo input,
  .campo textarea {
    /* La tavola non rende più i campi come riquadri bianchi pieni: sono
       vetro sul fondo scuro, appena tinti — coerenti con le pillole e coi
       bordi del resto del blocco. */
    background: rgb(255 255 255 / 7%);
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: var(--radius);
    padding: 13px 14px;
    font-size: 14px;
    color: var(--surface);
    font-family: inherit;
  }
  .campo input::placeholder,
  .campo textarea::placeholder {
    color: var(--su-accent-debole);
  }
  .campo textarea {
    resize: vertical;
    min-height: 88px;
  }
  .urgenza {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .pillole {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .pillola {
    position: relative;
    cursor: pointer;
  }
  .pillola input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .pillola span {
    display: inline-block;
    font-size: 13px;
    color: var(--su-accent-forte);
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: var(--radius);
    padding: 9px 14px;
  }
  .pillola input:checked + span {
    color: var(--accent);
    background: var(--evidenziatore);
    border-color: var(--evidenziatore);
    font-weight: 600;
  }
  .pillola input:focus-visible + span {
    outline: 2px solid var(--surface);
    outline-offset: 2px;
  }
  .invia {
    grid-column: span 2;
    margin-top: 14px;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .invia .pulsante {
    display: inline-block;
    background: var(--azione);
    color: var(--surface);
    font-size: 15px;
    font-weight: 600;
    padding: 14px 30px;
    border: none;
    border-radius: var(--radius);
    font-family: inherit;
    cursor: pointer;
  }
  .invia .pulsante:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .nota-inerte {
    font-size: 13px;
    color: var(--su-accent);
  }
  /* `.alternativa` come box (bordo sopra, margine, larghezza massima) è
     sparito: la posizione ora la dà `grid-area: alt` qui sopra, la
     distanza dal blocco di testo il `row-gap` di `.blocco`. */
  .intro-alt {
    font-size: 14px;
    color: var(--su-accent);
  }
  .canali {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 14px;
  }
  .canale {
    display: inline-block;
    border: 1px solid rgb(255 255 255 / 30%);
    border-radius: var(--radius);
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 600;
    color: var(--surface);
  }

  @media (max-width: 640px) {
    .container {
      padding: 48px 20px;
    }
    .territorio {
      padding-bottom: 30px;
      margin-bottom: 34px;
    }
    .territorio .luogo {
      font-size: 24px;
    }
    .territorio .intro-luogo {
      font-size: 15px;
      line-height: 1.6;
    }
    .territorio .modi {
      flex-direction: column;
      gap: 8px;
    }
    /* Sotto i 640px il blocco torna a una colonna, ma con un ordine
       diverso da quello sopra: testo, poi modulo, e SOLO IN FONDO
       «oppure, se preferisci saltare il modulo» — così mostra
       `HomeMobile.dc.html`. Il DOM è già in quest'ordine (vedi il
       commento nel markup), quindi qui basta impilare senza spannare. */
    .blocco {
      grid-template-columns: 1fr;
      grid-template-areas:
        "intro"
        "modulo"
        "alt";
      row-gap: 24px;
      column-gap: 0;
    }
    .titolo {
      font-size: 26px;
    }
    .intro {
      font-size: 15px;
    }
    .modulo {
      grid-template-columns: 1fr;
    }
    .campo.largo {
      grid-column: span 1;
    }
    .invia {
      grid-column: span 1;
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }
    .invia .pulsante {
      width: 100%;
      text-align: center;
    }
    .canali {
      /* La tavola mobile li vuole affiancati, non impilati: due pillole
         di larghezza uguale che riempiono la riga. */
      flex-wrap: nowrap;
    }
    .canale {
      flex: 1;
      font-size: 15px;
      padding: 13px 16px;
      text-align: center;
    }
  }
</style>
