---
// Le tre schede e gli href (già risolti per la lingua) arrivano dalla
// pagina (task 2, sito-inglese). `projects.ts` contiene ormai anche
// «Portale ricambi 3D» (task 6/11), ma i testi restano scritti alla
// lettera dalla tavola invece di essere riletti da lì: i tre corpi di
// questa sezione sono più corti di quelli di /lavori.
//
// `link`/`href` sono opzionali: la scheda di «Portale ricambi 3D» lato
// inglese non ha una pagina di destinazione (quel case study è
// `soloItaliano`, task 9/sito-inglese), quindi resta senza collegamento —
// come già fanno Paesello e il video generativo in RigaLavoro.astro, righe
// di /lavori e /en/work senza `href`.
interface Prova {
  eyebrow: string;
  nome: string;
  corpo: string;
  tag: string[];
  link?: string;
  href?: string;
  esterno?: boolean;
}
interface Props {
  occhiello: string;
  titolo: string;
  prove: Prova[];
  continua: string;
  hrefContinua: string;
}
const { occhiello, titolo, prove, continua, hrefContinua } = Astro.props;
---

<section class="le-prove" id="le-prove">
  <div class="container">
    <p class="label">{occhiello}</p>
    <h2 class="section-title">{titolo}</h2>
    <div class="griglia">
      {prove.map((p) => (
        <div class="scheda">
          <p class="eyebrow">{p.eyebrow}</p>
          <h3>{p.nome}</h3>
          <p class="corpo">{p.corpo}</p>
          <div class="tag">
            {p.tag.map((t) => <span>{t}</span>)}
          </div>
          {p.href && (
            p.esterno ? (
              <a class="link" href={p.href} target="_blank" rel="noopener noreferrer">{p.link} <span class="freccia">&rarr;</span></a>
            ) : (
              <a class="link" href={p.href}>{p.link} <span class="freccia">&rarr;</span></a>
            )
          )}
        </div>
      ))}
    </div>
    <a class="continua" href={hrefContinua}>{continua} <span class="freccia">&rarr;</span></a>
  </div>
</section>

<style>
  .le-prove {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding: 0;
  }
  .container {
    padding: 72px 24px;
  }
  .section-title {
    font-size: 32px;
    margin-top: 18px;
    margin-bottom: 40px;
    max-width: 28ch;
  }
  .griglia {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }
  .scheda {
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-top: 3px solid var(--azione);
    padding-top: 22px;
  }
  .scheda .eyebrow {
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--azione);
    font-weight: 700;
  }
  .scheda h3 {
    font-size: 24px;
  }
  .scheda .corpo {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-muted);
  }
  .tag {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }
  .tag span {
    font-size: 12px;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 5px 10px;
    background: var(--bg);
  }
  .scheda .link {
    font-size: 14px;
    font-weight: 600;
    margin-top: 6px;
  }
  .continua {
    display: inline-block;
    margin-top: 40px;
    font-size: 15px;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .container {
      padding: 44px 20px;
    }
    .section-title {
      font-size: 26px;
      margin-top: 14px;
      margin-bottom: 22px;
      max-width: none;
    }
    .griglia {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .scheda {
      padding-top: 20px;
    }
    .scheda .eyebrow {
      font-size: 10.5px;
      letter-spacing: 0.14em;
    }
    .scheda h3 {
      font-size: 22px;
    }
    .continua {
      display: block;
      margin-top: 30px;
    }
  }
</style>
