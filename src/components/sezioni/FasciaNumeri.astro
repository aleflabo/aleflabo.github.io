---
// I quattro numeri arrivano dalla pagina (task 2, sito-inglese): non sono
// gli stessi di `pubblicazioni.numeriFascia` (quell'array è per la fascia
// in cima a /ricerca: ordine, terzo e quarto valore ed etichette
// differiscono — «2 anni da CTO» non esiste in quell'array, e «citazioni»
// qui non porta la data).
interface Props {
  numeri: { numero: string; etichetta: string }[];
}
const { numeri } = Astro.props;
---

<section class="fascia-numeri">
  <div class="container">
    {numeri.map((n) => (
      <div class="numero">
        <span class="valore">{n.numero}</span>
        <span class="etichetta">{n.etichetta}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .fascia-numeri {
    background: var(--accent);
    padding: 0;
  }
  .container {
    padding: 26px 24px;
    display: flex;
    gap: 56px;
    flex-wrap: wrap;
  }
  .valore {
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 600;
    color: var(--surface);
  }
  .etichetta {
    font-size: 14px;
    font-weight: 500;
    color: #a8c0d6;
    margin-left: 10px;
  }

  @media (max-width: 640px) {
    .container {
      padding: 22px 20px;
      gap: 28px 36px;
    }
  }
</style>
