---
// I testi (e l'href, già risolto per la lingua) arrivano dalla pagina
// (task 2, sito-inglese). Fino a settembre 2026 questo commento diceva
// apposta che i quattro passi non dovevano coincidere con `ingaggi` di
// src/data/servizi.ts: avevano nomi e testi propri
// (Ascolto/Diagnosi/Costruisco/Resto), diversi da Capire/Decidere/Costruire/
// Mantenere. Da task 10 (home-visuale) il corpo di ogni passo è caduto e i
// nomi sono diventati quelli degli ingaggi — la ragione del disaccordo è
// spiegata in src/pages/index.astro, sopra l'oggetto `comeLavoro`. `corpo`
// è quindi facoltativo qui, nel tipo e nel markup: non perché un altro
// componente lo ometta (`grep -rl "import ComeLavoro from" src/` mostra che
// lo importano solo le due home, mai `CorpoChiSono.astro`), ma perché un
// campo vuoto che salta la sua parte è la forma giusta in questo repo.
interface Props {
  occhiello: string;
  titolo: string;
  intro: string;
  passi: { numero: string; nome: string; corpo?: string; neEsce: string }[];
  etichettaNeEsce: string;
  continua: string;
  hrefContinua: string;
}
const { occhiello, titolo, intro, passi, etichettaNeEsce, continua, hrefContinua } = Astro.props;
---

<section class="come-lavoro">
  <div class="container">
    <p class="label">{occhiello}</p>
    <h2 class="section-title">{titolo}</h2>
    <p class="intro">{intro}</p>
    <div class="passi">
      {passi.map((p, i) => (
        <div class:list={['riga', 'passo', { ultimo: i === passi.length - 1, 'senza-corpo': !p.corpo }]}>
          <span class="numero">{p.numero}</span>
          <div class="testo">
            <h3>{p.nome}</h3>
            {p.corpo && <p class="corpo">{p.corpo}</p>}
          </div>
          <div class="ne-esce">
            <p class="etichetta">{etichettaNeEsce}</p>
            <p class="valore">{p.neEsce}</p>
          </div>
        </div>
      ))}
    </div>
    <a class="continua" href={hrefContinua}>{continua} <span class="freccia">&rarr;</span></a>
  </div>
</section>

<style>
  .come-lavoro {
    border-top: 1px solid var(--border);
    padding: 0;
  }
  .container {
    padding: 72px 24px;
  }
  .section-title {
    font-size: 32px;
    margin-top: 18px;
    margin-bottom: 14px;
    max-width: 26ch;
  }
  .intro {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 66ch;
    margin-bottom: 44px;
  }
  .passi {
    display: flex;
    flex-direction: column;
  }
  .passo {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr) 230px;
    gap: 24px;
    padding: 28px 0;
    border-top: 1px solid var(--border);
    align-items: start;
  }
  .passo.ultimo {
    border-bottom: 1px solid var(--border);
  }
  .passo .numero {
    font-family: var(--font-serif);
    font-size: 30px;
    font-weight: 600;
    color: var(--accent);
  }
  .testo h3 {
    font-size: 22px;
  }
  .testo .corpo {
    margin-top: 10px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 56ch;
  }
  .ne-esce .etichetta {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--azione);
    font-weight: 700;
  }
  .ne-esce .valore {
    margin-top: 8px;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text);
  }
  .continua {
    display: inline-block;
    margin-top: 26px;
    font-size: 15px;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .container {
      padding: 48px 20px;
    }
    .section-title {
      font-size: 26px;
      margin-top: 14px;
      margin-bottom: 12px;
      max-width: none;
    }
    .intro {
      font-size: 15px;
      margin-bottom: 30px;
      max-width: none;
    }
    .passo {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 22px 0;
    }
    .passo .numero {
      font-size: 24px;
    }
    .testo .corpo {
      max-width: none;
    }
    .ne-esce {
      margin-top: 4px;
    }
    .ne-esce .valore {
      margin-top: 6px;
    }
    /* Senza corpo (i quattro passi della home, da task 10) numero e nome
       stanno in linea invece che impilati: la riga si accorcia e la sezione
       scende da 1647px a ~947px sul telefono, come in HomeMobile.dc.html.
       `.ne-esce` resta un blocco a parte — non un item del flex — quindi va
       a capo da solo, sotto: `flex-basis: 100%` lo forza a una nuova riga
       del flex-wrap, e il suo `margin-top` torna a zero perché lo spazio
       sopra è già il `gap` del flex. Il padding verticale della riga scende
       da 22px a 18px, come nella tavola, perché senza corpo il ritmo di
       22px lasciava troppo vuoto fra righe corte. */
    .passo.senza-corpo {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 12px;
      padding: 18px 0;
    }
    /* `.numero` è uno <span>, non un h1-h3: eredita da body line-height:1.6
       (src/styles/global.css), molto più alto dell'1.1 che quel foglio dà
       agli h1-h3. In una riga flex allineata a baseline è l'altezza di riga
       più alta a decidere quella della riga intera, quindi lo scarto non è
       cosmetico: senza questa riga il numero da solo aggiungeva più px di
       riquadro vuoto di quanti la cifra ne occupi davvero. */
    .passo.senza-corpo .numero {
      line-height: 1.1;
    }
    .passo.senza-corpo .ne-esce {
      flex-basis: 100%;
      margin-top: 0;
    }
  }
</style>
