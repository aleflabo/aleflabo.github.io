---
// Dove si lavora: la città, le regioni raggiunte di persona, e il fatto che
// il resto si faccia bene anche a distanza.
//
// I testi arrivano come props dalla pagina, come per le altre sezioni della
// home (task 2, sito-inglese); la fonte è src/data/territorio.ts, che è anche
// quella da cui i dati strutturati prendono `areaServed`.
interface Props {
  occhiello: string;
  titolo: string;
  intro: string;
  corpo: string;
  modi: { etichetta: string; dettaglio: string }[];
}
const { occhiello, titolo, intro, corpo, modi } = Astro.props;
---

<section class="territorio">
  <div class="container">
    <p class="label">{occhiello}</p>
    <h2 class="section-title">{titolo}</h2>
    <p class="intro">{intro}</p>
    <p class="corpo">{corpo}</p>
    <div class="modi">
      {modi.map((m) => (
        <div>
          <p class="etichetta">{m.etichetta}</p>
          <p class="dettaglio">{m.dettaglio}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Stesse misure di DaDoveViene, che è la sezione subito sopra: cambia
     solo il fondo, che qui resta quello della pagina — bianco, crema, blu
     è il ritmo con cui la home arriva al modulo di contatto. */
  .territorio {
    border-top: 1px solid var(--border);
    padding: 0;
  }
  .container {
    padding: 72px 24px;
  }
  .section-title {
    font-size: 32px;
    margin-top: 18px;
    margin-bottom: 28px;
    max-width: 28ch;
  }
  .intro {
    font-size: 20px;
    line-height: 1.6;
    color: var(--text);
    max-width: 62ch;
    text-wrap: pretty;
  }
  .corpo {
    margin-top: 22px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 62ch;
  }
  .modi {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    margin-top: 44px;
    border-top: 1px solid var(--border);
    padding-top: 28px;
  }
  .modi .etichetta {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--azione);
    font-weight: 700;
  }
  .modi .dettaglio {
    margin-top: 8px;
    font-family: var(--font-serif);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text);
  }

  @media (max-width: 640px) {
    .container {
      padding: 48px 20px;
    }
    .section-title {
      font-size: 26px;
      margin-top: 14px;
      margin-bottom: 20px;
      max-width: none;
    }
    .intro {
      font-size: 17px;
      max-width: none;
    }
    .corpo {
      margin-top: 18px;
      font-size: 15px;
      max-width: none;
    }
    .modi {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-top: 32px;
      padding-top: 22px;
    }
  }
</style>
