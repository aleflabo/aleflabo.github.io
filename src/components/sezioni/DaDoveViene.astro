---
// I testi (e gli href, già risolti per la lingua) arrivano dalla pagina
// (task 2, sito-inglese).
interface Props {
  occhiello: string;
  titolo: string;
  intro: string;
  corpo: string;
  tappe: { valore: string; etichetta: string }[];
  linkRicerca: string;
  hrefRicerca: string;
  linkChiSono: string;
  hrefChiSono: string;
}
const { occhiello, titolo, intro, corpo, tappe, linkRicerca, hrefRicerca, linkChiSono, hrefChiSono } = Astro.props;
---

<section class="da-dove-viene">
  <div class="container">
    <p class="label">{occhiello}</p>
    <h2 class="section-title">{titolo}</h2>
    <p class="intro">{intro}</p>
    <p class="corpo">{corpo}</p>
    <div class="tappe">
      {tappe.map((t) => (
        <div>
          <p class="valore">{t.valore}</p>
          <p class="etichetta">{t.etichetta}</p>
        </div>
      ))}
    </div>
    <div class="link-row">
      <a href={hrefRicerca}>{linkRicerca} <span class="freccia">&rarr;</span></a>
      <a href={hrefChiSono}>{linkChiSono} <span class="freccia">&rarr;</span></a>
    </div>
  </div>
</section>

<style>
  .da-dove-viene {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding: 0;
  }
  .container {
    padding: 72px 24px;
  }
  .section-title {
    font-size: 32px;
    margin-top: 18px;
    margin-bottom: 28px;
    max-width: 28ch;
  }
  .intro {
    font-size: 20px;
    line-height: 1.6;
    color: var(--text);
    max-width: 62ch;
    text-wrap: pretty;
  }
  .corpo {
    margin-top: 22px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 62ch;
  }
  .tappe {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    margin-top: 44px;
    border-top: 1px solid var(--border);
    padding-top: 28px;
  }
  .tappe .valore {
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 600;
    color: var(--text);
  }
  .tappe .etichetta {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-muted);
  }
  .link-row {
    display: flex;
    gap: 26px;
    margin-top: 30px;
  }
  .link-row a {
    display: inline-block;
    font-size: 15px;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .container {
      padding: 48px 20px;
    }
    .section-title {
      font-size: 26px;
      margin-top: 14px;
      margin-bottom: 20px;
      max-width: none;
    }
    .intro {
      font-size: 17px;
      max-width: none;
    }
    .corpo {
      margin-top: 18px;
      font-size: 15px;
      max-width: none;
    }
    .tappe {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-top: 32px;
      padding-top: 22px;
    }
    .link-row {
      flex-direction: column;
      gap: 12px;
      margin-top: 24px;
    }
  }
</style>
