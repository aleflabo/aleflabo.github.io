---
import type { Ingaggio } from '../../data/servizi';

// Una scheda per uno dei quattro ingaggi di /servizi (o /en/services).
// Testo alla lettera da tavole/Servizi.dc.html (testi.md, sezione
// «/servizi»); i dati vengono da src/data/servizi.ts o src/data/en/servizi.ts
// (task 6), non riscritti qui. `etichetta` è la parola di percorso
// (Capire · Decidere · Costruire · Mantenere), `nome` è il nome proprio
// dell'ingaggio (es. «Audit AI»).
//
// Le tre etichette dei dettagli («Per chi» / «Quanto dura» / «Cosa resta»
// in italiano) erano scritte a mano qui, quindi restavano in italiano anche
// su /en/services (task 6, sito-inglese, giro di correzioni 1). Ora sono
// proprietà obbligatorie, senza valore di riferimento: un default in
// italiano farebbe passare in silenzio la stessa dimenticanza la prossima
// volta che qualcuno riusa questo componente in una lingua nuova.
interface Props {
  ingaggio: Ingaggio;
  etichettaPerChi: string;
  etichettaQuantoDura: string;
  etichettaCosaResta: string;
}
const { ingaggio, etichettaPerChi, etichettaQuantoDura, etichettaCosaResta } = Astro.props;
---

<div class="ingaggio">
  <p class="verbo mono">{ingaggio.etichetta}</p>
  <div class="descrizione">
    <h2>{ingaggio.nome}</h2>
    {ingaggio.corpo.map((p, i) => (
      <p class:list={['corpo', { muto: i === 0 }]}>{p}</p>
    ))}
  </div>
  <dl class="dati-mono">
    <div><dt>{etichettaPerChi}</dt><dd>{ingaggio.perChi}</dd></div>
    <div><dt>{etichettaQuantoDura}</dt><dd>{ingaggio.durata}</dd></div>
    <div><dt>{etichettaCosaResta}</dt><dd>{ingaggio.cosaResta}</dd></div>
  </dl>
</div>

<style>
  /* Una riga del Laboratorio: il verbo in mono, nome e testo, i dati a destra
     (mockup, scheda «A · Pagine interne»). */
  .ingaggio {
    display: grid;
    grid-template-columns: 110px minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 24px;
    padding: 24px 0;
    border-top: 1px solid var(--filo);
  }
  .verbo { font-size: 0.75rem; font-weight: 500; color: var(--rilevamento-testo); text-transform: lowercase; }
  h2 { font-size: 1.375rem; letter-spacing: -0.03em; margin-bottom: 8px; }
  .corpo { font-size: 0.9375rem; line-height: 1.6; }
  .corpo + .corpo { margin-top: 10px; }
  .muto { color: var(--muto); }
  dt { text-transform: lowercase; }
  @media (max-width: 820px) {
    .ingaggio { grid-template-columns: 1fr; gap: 10px; }
  }
</style>
