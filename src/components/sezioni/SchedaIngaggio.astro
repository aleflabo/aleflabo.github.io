---
import type { Ingaggio } from '../../data/servizi';

// Una scheda per uno dei quattro ingaggi di /servizi (o /en/services).
// Testo alla lettera da tavole/Servizi.dc.html (testi.md, sezione
// «/servizi»); i dati vengono da src/data/servizi.ts o src/data/en/servizi.ts
// (task 6), non riscritti qui. `etichetta` è la parola di percorso
// (Capire · Decidere · Costruire · Mantenere), `nome` è il nome proprio
// dell'ingaggio (es. «Audit AI»).
//
// Le tre etichette dei dettagli («Per chi» / «Quanto dura» / «Cosa resta»
// in italiano) erano scritte a mano qui, quindi restavano in italiano anche
// su /en/services (task 6, sito-inglese, giro di correzioni 1). Ora sono
// proprietà obbligatorie, senza valore di riferimento: un default in
// italiano farebbe passare in silenzio la stessa dimenticanza la prossima
// volta che qualcuno riusa questo componente in una lingua nuova.
interface Props {
  ingaggio: Ingaggio;
  etichettaPerChi: string;
  etichettaQuantoDura: string;
  etichettaCosaResta: string;
}
const { ingaggio, etichettaPerChi, etichettaQuantoDura, etichettaCosaResta } = Astro.props;
---

<div class="scheda ingaggio">
  <div class="descrizione">
    <p class="etichetta">{ingaggio.etichetta}</p>
    <h2>{ingaggio.nome}</h2>
    {ingaggio.corpo.map((p, i) => (
      <p class:list={['corpo', { muto: i === 0 }]}>{p}</p>
    ))}
  </div>
  <div class="dettagli">
    <div>
      <p class="dettaglio-etichetta">{etichettaPerChi}</p>
      <p class="dettaglio-valore">{ingaggio.perChi}</p>
    </div>
    <div>
      <p class="dettaglio-etichetta">{etichettaQuantoDura}</p>
      <p class="dettaglio-valore">{ingaggio.durata}</p>
    </div>
    <div>
      <p class="dettaglio-etichetta">{etichettaCosaResta}</p>
      <p class="dettaglio-valore">{ingaggio.cosaResta}</p>
    </div>
  </div>
</div>

<style>
  .ingaggio {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 34px;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 40px;
  }
  .etichetta {
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--azione);
    font-weight: 700;
  }
  .descrizione h2 {
    font-size: 27px;
    margin-top: 12px;
  }
  .descrizione .corpo {
    margin-top: 14px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text);
  }
  .descrizione .corpo.muto {
    color: var(--text-muted);
  }
  .dettagli {
    display: flex;
    flex-direction: column;
    gap: 18px;
    border-left: 1px solid var(--border);
    padding-left: 32px;
  }
  .dettaglio-etichetta {
    font-size: 11.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--azione);
    font-weight: 700;
  }
  .dettaglio-valore {
    margin-top: 6px;
    font-size: 14.5px;
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .ingaggio {
      grid-template-columns: 1fr;
      gap: 22px;
      padding: 26px 22px;
    }
    .descrizione h2 {
      font-size: 23px;
    }
    .dettagli {
      border-left: none;
      padding-left: 0;
      padding-top: 20px;
      border-top: 1px solid var(--border);
    }
  }
</style>
