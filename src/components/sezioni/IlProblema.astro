---
// I testi arrivano dalla pagina (task 2, sito-inglese).
interface Props {
  occhiello: string;
  titolo: string;
  riquadri: { citazione: string; corpo: string }[];
}
const { occhiello, titolo, riquadri } = Astro.props;
---

<section class="il-problema">
  <div class="container">
    <p class="label">{occhiello}</p>
    <h2 class="section-title">{titolo}</h2>
    <div class="griglia">
      {riquadri.map((r) => (
        <div class="scheda">
          <p class="frase">{r.citazione}</p>
          <p class="corpo">{r.corpo}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .il-problema {
    border-top: 1px solid var(--border);
    padding: 0;
  }
  .container {
    padding: 72px 24px;
  }
  .section-title {
    font-size: 32px;
    margin-top: 18px;
    margin-bottom: 40px;
    max-width: 30ch;
  }
  .griglia {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }
  .scheda {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 30px;
  }
  .frase {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.25;
    color: var(--text);
  }
  .corpo {
    margin-top: 16px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .container {
      padding: 48px 20px;
    }
    .section-title {
      font-size: 26px;
      margin-top: 14px;
      margin-bottom: 28px;
      max-width: none;
      text-wrap: pretty;
    }
    .griglia {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .scheda {
      padding: 24px;
    }
    .frase {
      font-size: 19px;
    }
    .corpo {
      margin-top: 12px;
      line-height: 1.6;
    }
  }
</style>
