---
import type { Locale } from '../i18n/ui';
// `href` è già il percorso finale (relativo) verso la gemella nell'altra
// lingua, calcolato da BaseLayout: assente quando quella pagina non ha una
// gemella (task 1/bloccante) — in quel caso niente interruttore, invece di
// un link che porta a un 404.
//
// Qui c'era anche uno script che segnava `lang-chosen` in `localStorage`.
// Serviva solo a zittire il rimbalzo automatico verso /en/ che stava in
// BaseLayout, tolto il 27 agosto 2026: senza quel rimbalzo non c'è più
// niente da ricordare, perché la lingua scelta è semplicemente la pagina su
// cui si è. Il sito ora non scrive nulla nel browser di chi legge — le
// informative lo dicono.
interface Props { lang: Locale; href?: string; }
const { lang, href } = Astro.props;
const other: Locale = lang === 'en' ? 'it' : 'en';
---
{href && (
  <a class="lang" href={href} data-lang-switch aria-label={`Switch to ${other.toUpperCase()}`}>
    <span class:list={[lang === 'en' && 'on']}>EN</span><span aria-hidden="true"> / </span><span class:list={[lang === 'it' && 'on']}>IT</span>
  </a>
)}
<style>
  .lang { font-size: 0.8rem; letter-spacing: 0.05em; color: var(--text-muted); }
  .lang .on { color: var(--text); font-weight: 700; }
</style>
