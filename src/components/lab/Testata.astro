---
// La testata della home «Laboratorio» (spec 2026-11-08, § «La home», punti 2–7).
// Tutto il testo è nel markup: lo script ruota le parole, accende le celle e
// scrive l'ora, ma senza JavaScript la testata è completa (prima parola
// visibile, luogo senza ora).
import type { Locale } from '../../i18n/ui';
import type { HomeLab } from '../../data/homeLab';
import Terminale from './Terminale.astro';
import FotoPosa from './FotoPosa.astro';

interface Props { lang: Locale; t: HomeLab }
const { lang, t } = Astro.props;
const [nome, ...cognome] = t.nome.split(' ');
---

<section class="testata">
  <div class="griglia-lab" aria-hidden="true"></div>
  <div class="celle" aria-hidden="true" data-celle></div>
  <div class="foglio">
    <div class="sinistra">
      <h1 class="nome">{nome}<br />{cognome.join(' ')}<span class="cursore" aria-hidden="true"></span></h1>
      <p class="ruolo mono">
        <span aria-hidden="true">&gt; {t.verbo} <span class="ruota" data-ruota>{t.parole.map((p, i) => <span hidden={i > 0}>{p}</span>)}</span></span>
        <span class="solo-lettori">{t.verbo}: {t.parole.join(', ')}</span>
      </p>
      <Terminale lang={lang} />
      <div class="azioni">
        <a class="primaria pulsante" href={t.hrefPrimaria}>{t.ctaPrimaria} →</a>
        <a class="secondaria" href={t.hrefSecondaria}>{t.ctaSecondaria}</a>
      </div>
      <dl class="info mono">
        <div class="vivo"><dt class="solo-lettori">{t.etichettaOra}</dt><dd>{t.luogo} <time data-ora></time></dd></div>
        {t.info.map((v) => <div><dt>{v.chiave}</dt><dd>{v.valore}</dd></div>)}
      </dl>
    </div>
    <div class="destra">
      <FotoPosa etichettaCard={t.etichettaCard} etichettaPosa={t.etichettaPosa} suggerimento={t.suggerimentoFoto} />
    </div>
  </div>
</section>

<style>
  .testata { position: relative; overflow: hidden; padding: 0; border-bottom: 1px solid var(--filo); }
  .celle { position: absolute; inset: 0; pointer-events: none; }
  .celle :global(i) {
    position: absolute;
    width: 47px;
    height: 47px;
    background: var(--blu-cella);
    opacity: 0;
    animation: cella 4s ease-in-out infinite;
  }
  @keyframes cella { 0%, 100% { opacity: 0; } 50% { opacity: 0.07; } }
  .foglio {
    position: relative;
    max-width: var(--maxw-lab);
    margin: 0 auto;
    border-inline: 1px solid var(--filo);
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
  }
  .sinistra {
    padding: 56px 32px 40px;
    display: grid;
    gap: 22px;
    align-content: start;
    border-right: 1px solid var(--filo);
    min-width: 0;
  }
  .destra { display: grid; align-content: center; padding: 32px 22px; }
  .nome {
    font-size: clamp(2.75rem, 7.4vw, 5.75rem);
    line-height: 0.92;
    letter-spacing: -0.055em;
    font-weight: 600;
    text-wrap: initial;
  }
  .cursore {
    display: inline-block;
    width: 0.08em;
    height: 0.8em;
    margin-left: 0.06em;
    vertical-align: -0.04em;
    background: var(--rilevamento);
    animation: lampeggia 1s steps(1) infinite;
  }
  @keyframes lampeggia { 50% { opacity: 0; } }
  .ruolo { color: var(--muto); font-size: 0.95rem; }
  .ruota { color: var(--inchiostro); display: inline-block; min-width: 18ch; border-bottom: 1px dashed var(--rilevamento); }
  .azioni { display: flex; flex-wrap: wrap; gap: 10px; }
  .azioni a {
    font-weight: 500;
    font-size: 0.875rem;
    padding: 11px 16px;
    border-radius: var(--raggio-piccolo);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .primaria { background: var(--rilevamento-testo); color: var(--bianco); }
  .secondaria { border: 1px solid var(--filo); background: var(--bianco); color: var(--inchiostro); transition: border-color 0.2s; }
  .secondaria:hover { border-color: var(--inchiostro); }
  .secondaria:active { transform: translateY(1px); }
  .info {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--filo);
    border-left: 1px solid var(--filo);
    font-size: 0.8125rem;
    margin: 0;
  }
  .info div { display: flex; gap: 10px; padding: 10px 12px; border-right: 1px solid var(--filo); border-bottom: 1px solid var(--filo); min-width: 0; }
  .info dt { color: var(--muto); }
  .info dd { margin: 0; }
  .vivo::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--vivo);
    align-self: center;
    animation: pulsa 2s infinite;
  }
  @keyframes pulsa { from { box-shadow: 0 0 0 0 rgb(24 178 107 / 50%); } to { box-shadow: 0 0 0 8px rgb(24 178 107 / 0%); } }

  @media (max-width: 820px) {
    .foglio { grid-template-columns: 1fr; }
    .sinistra { border-right: 0; padding: 36px 20px; }
    .destra { border-top: 1px solid var(--filo); }
    .info { grid-template-columns: 1fr; }
  }
</style>

<script>
  const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // L'ora di Venezia. Senza JavaScript resta solo il nome del luogo.
  const ora = new Intl.DateTimeFormat(document.documentElement.lang === 'it' ? 'it-IT' : 'en-GB', {
    hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Rome',
  });
  const scriviOra = () => document.querySelectorAll('[data-ora]').forEach((t) => { t.textContent = ora.format(new Date()); });
  scriviOra();
  setInterval(scriviOra, 15000);

  if (!ridotto) {
    // Le parole che ruotano: sono tutte nel markup, se ne mostra una alla volta.
    document.querySelectorAll<HTMLElement>('[data-ruota]').forEach((r) => {
      const parole = [...r.children] as HTMLElement[];
      let i = 0;
      setInterval(() => {
        parole[i].hidden = true;
        i = (i + 1) % parole.length;
        parole[i].hidden = false;
        parole[i].animate([{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'none' }], { duration: 220 });
      }, 2200);
    });

    // Le celle della griglia che si accendono, sulla stessa griglia di 48px.
    document.querySelectorAll<HTMLElement>('[data-celle]').forEach((contenitore) => {
      for (let n = 0; n < 22; n++) {
        const c = document.createElement('i');
        c.style.left = `${Math.floor(Math.random() * 30) * 48 + 1}px`;
        c.style.top = `${Math.floor(Math.random() * 14) * 48 + 1}px`;
        c.style.animationDelay = `${(Math.random() * 4).toFixed(2)}s`;
        contenitore.append(c);
      }
    });
  }
</script>
