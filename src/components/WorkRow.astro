---
import StackChip from './StackChip.astro';
import { localizedPath, type Locale } from '../i18n/ui';
import type { Project } from '../data/projects';
import { site } from '../data/site';

interface Props { project: Project; lang: Locale; index: number }
const { project, lang, index } = Astro.props;

const num = String(index).padStart(2, '0');
const copy = project[lang];
const eyebrow = `${copy.area} · ${project.role} · ${project.year}`;
const href = localizedPath(lang, '/work/' + project.slug);
---

<a class="row" href={href}>
  <span class="num muted">{num}</span>
  <div class="content">
    <span class="eyebrow accent">{eyebrow}</span>
    <h3>{project.name}</h3>
    <p class="muted summary">{copy.summary}</p>
    <div class="row-footer">
      <div class="chips">
        {project.stack.map((tech) => <StackChip label={tech} />)}
      </div>
      <span class="see-more accent">{site[lang].workSeeMore} →</span>
    </div>
  </div>
</a>

<style>
  .row {
    display: flex;
    gap: 1.5rem;
    padding: 2rem 0;
    border-top: 1px solid var(--border);
  }
  .num {
    font-family: var(--font-serif);
    font-size: 1rem;
    flex-shrink: 0;
    padding-top: 0.2rem;
  }
  .content {
    flex: 1;
    min-width: 0;
  }
  .accent {
    color: var(--accent);
  }
  .eyebrow {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
  }
  h3 {
    margin-top: 0.4rem;
    font-size: 1.3rem;
    transition: color 0.15s ease;
  }
  .summary {
    margin-top: 0.6rem;
    max-width: 60ch;
  }
  .row-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .see-more {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    white-space: nowrap;
    transition: opacity 0.15s ease;
  }
  .row:hover h3 {
    color: var(--accent);
  }

  @media (max-width: 480px) {
    .row {
      flex-direction: column;
      gap: 0.5rem;
    }
    .row-footer {
      gap: 0.5rem;
    }
  }
</style>
