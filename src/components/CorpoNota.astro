---
// src/components/CorpoNota.astro — il corpo di una nota, da Portable Text a
// HTML.
//
// Portable Text è un albero di blocchi, non una stringa di markup: il corpo
// non viene mai reso con `set:html`, quindi non c'è modo che un testo
// scritto nello Studio inietti script nella pagina.
//
// L'unico tipo non testuale ammesso dallo schema è `image`, e viene reso
// qui: senza questo componente un'immagine caricata nello Studio sparirebbe
// dalla pagina senza un errore, che è il modo peggiore di rompersi.
import { PortableText } from 'astro-portabletext';
import type { PortableTextBlock } from '@portabletext/types';
import Immagine from './ImmagineNota.astro';

interface Props {
  valore: PortableTextBlock[];
}
const { valore } = Astro.props;
---

<div class="corpo-nota">
  <PortableText value={valore} components={{ type: { image: Immagine } }} />
</div>

<style>
  .corpo-nota {
    max-width: 68ch;
  }

  .corpo-nota :global(p),
  .corpo-nota :global(li) {
    font-size: 17px;
    line-height: 1.75;
    color: var(--text-muted);
  }

  .corpo-nota :global(p) {
    margin: 0 0 20px;
  }

  .corpo-nota :global(h2) {
    margin: 40px 0 12px;
    font-size: 26px;
  }

  .corpo-nota :global(h3) {
    margin: 32px 0 10px;
    font-size: 20px;
  }

  .corpo-nota :global(ul),
  .corpo-nota :global(ol) {
    margin: 0 0 20px;
    padding-left: 22px;
  }

  .corpo-nota :global(li) {
    margin-bottom: 8px;
  }

  .corpo-nota :global(blockquote) {
    margin: 28px 0;
    padding-left: 20px;
    border-left: 3px solid var(--evidenziatore);
    font-style: italic;
  }

  .corpo-nota :global(a) {
    color: var(--azione);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .corpo-nota :global(code) {
    padding: 2px 5px;
    border-radius: 3px;
    background: var(--surface-warm);
    font-size: 15px;
  }
</style>
