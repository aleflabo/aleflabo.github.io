---
import { localizedPath } from '../../i18n/ui';

// I tre dati, testo alla lettera da tavole/Main.dc.html (testi.md, sezione
// «/ — home»).
const tappe = [
  { valore: '2021–2024', etichetta: 'Dottorato in computer vision, Sapienza — PINlab' },
  { valore: 'CVPR · ICCV · IROS', etichetta: 'Le conferenze principali del settore' },
  { valore: '2024–2026', etichetta: 'Co-fondatore e CTO di Procedo, startup industriale' },
];
---

<section class="da-dove-viene">
  <div class="container">
    <p class="label">Da dove viene quello che so</p>
    <h2 class="section-title">Dalla ricerca alla produzione</h2>
    <p class="intro">Una magistrale in data science, poi un dottorato in computer vision alla Sapienza, con il lavoro pubblicato in conferenze dove viene esaminato a fondo prima di uscire. Sono poi stato due anni CTO di una startup industriale, che è il mestiere in cui si scopre quanto di quella ricerca sopravvive al contatto con un'azienda vera.</p>
    <p class="corpo">Ogni articolo che ho pubblicato esce insieme al codice. È l'abitudine con cui lavoro anche adesso: le decisioni tecniche restano scritte e il software che consegno si apre e si legge.</p>
    <div class="tappe">
      {tappe.map((t) => (
        <div>
          <p class="valore">{t.valore}</p>
          <p class="etichetta">{t.etichetta}</p>
        </div>
      ))}
    </div>
    <div class="link-row">
      <a href={localizedPath('it', '/ricerca')}>La ricerca, per intero <span class="freccia">&rarr;</span></a>
      <a href={localizedPath('it', '/chi-sono')}>Chi sono <span class="freccia">&rarr;</span></a>
    </div>
  </div>
</section>

<style>
  .da-dove-viene {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding: 0;
  }
  .container {
    padding: 72px 24px;
  }
  .section-title {
    font-size: 32px;
    margin-top: 18px;
    margin-bottom: 28px;
    max-width: 28ch;
  }
  .intro {
    font-size: 20px;
    line-height: 1.6;
    color: var(--text);
    max-width: 62ch;
    text-wrap: pretty;
  }
  .corpo {
    margin-top: 22px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 62ch;
  }
  .tappe {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    margin-top: 44px;
    border-top: 1px solid var(--border);
    padding-top: 28px;
  }
  .tappe .valore {
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 600;
    color: var(--text);
  }
  .tappe .etichetta {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-muted);
  }
  .link-row {
    display: flex;
    gap: 26px;
    margin-top: 30px;
  }
  .link-row a {
    display: inline-block;
    font-size: 15px;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .container {
      padding: 48px 20px;
    }
    .section-title {
      font-size: 26px;
      margin-top: 14px;
      margin-bottom: 20px;
      max-width: none;
    }
    .intro {
      font-size: 17px;
      max-width: none;
    }
    .corpo {
      margin-top: 18px;
      font-size: 15px;
      max-width: none;
    }
    .tappe {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-top: 32px;
      padding-top: 22px;
    }
    .link-row {
      flex-direction: column;
      gap: 12px;
      margin-top: 24px;
    }
  }
</style>
