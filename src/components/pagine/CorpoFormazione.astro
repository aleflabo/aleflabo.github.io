---
// src/components/pagine/CorpoFormazione.astro — il corpo di /formazione e
// della gemella /en/training.
//
// Era la coppia più pesante del sito: **297 righe di stile identiche riga per
// riga**, più lo stesso markup. I tre formati, il riquadro sull'AI Act e le
// tre strade restano in src/data/formazione.ts; i testi che erano dentro il
// markup stanno in src/data/formazionePagina.ts.
import TestataPagina from '../TestataPagina.astro';
import { localizedPath, type Locale } from '../../i18n/ui';
import type { TestiFormazionePagina } from '../../data/formazionePagina';
import type { Formato, RiquadroAiAct, Strada } from '../../data/formazione';

interface Props {
  lang: Locale;
  t: TestiFormazionePagina;
  formati: Formato[];
  riquadroAiAct: RiquadroAiAct;
  strade: Strada[];
  prenotaMezzora: string;
}
const { lang, t, formati, riquadroAiAct, strade, prenotaMezzora } = Astro.props;
---

  <section class="intestazione">
    <div class="container">
      <TestataPagina
        occhiello={t.occhiello}
        titolo={t.titolo}
        introduzione={t.introduzione}
      />
    </div>
  </section>

  <section class="avviso-ai-act">
    <div class="container">
      <div class="riquadro">
        <p class="riquadro-label">{riquadroAiAct.titolo}</p>
        {riquadroAiAct.corpo.map((p, i) => (
          <p class:list={['riquadro-corpo', { muto: i > 0 }]}>{p}</p>
        ))}
        <a class="riquadro-link" href={localizedPath('it', riquadroAiAct.link.href)}>{riquadroAiAct.link.testo} <span class="freccia">&rarr;</span></a>
      </div>
    </div>
  </section>

  <section class="elenco-formati">
    <div class="container">
      <div class="schede">
        {formati.map((f) => (
          <div class="scheda formato">
            <div class="descrizione">
              <p class="eyebrow">{f.ore}</p>
              <h2>{f.nome}</h2>
              <p class="corpo">{f.corpo}</p>
            </div>
            <div class="dettagli">
              <div>
                <p class="dettaglio-etichetta">{t.etichettaPerChi}</p>
                <p class="dettaglio-valore">{f.perChi}</p>
              </div>
              <div>
                <p class="dettaglio-etichetta">{t.etichettaServeDaVoi}</p>
                <p class="dettaglio-valore">{f.serveDaVoi}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="come-si-organizza">
    <div class="container">
      <p class="label">{t.labelOrganizza}</p>
      <h2 class="section-title">{t.titoloOrganizza}</h2>
      <div class="griglia-strade">
        {strade.map((s) => (
          <div>
            <h3>{s.titolo}</h3>
            <p class="corpo">{s.testo}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="aula-onesta">
    <div class="container">
      <div class="colonne">
        <div>
          <p class="label">{t.labelCattedra}</p>
          <h2 class="section-title">{t.titoloCattedra}</h2>
          <p class="corpo">{t.corpiCattedra[0]}</p>
          <p class="corpo">{t.corpiCattedra[1]}</p>
        </div>
        <div>
          <p class="label">{t.labelOnesta}</p>
          <h2 class="section-title">{t.titoloOnesta}</h2>
          <div class="righe">
            {t.corpiOnesta.map((p) => (
              <p class="corpo">{p}</p>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-azienda">
    <div class="container">
      <h2>{t.titoloChiusura}</h2>
      <p class="intro">{t.introChiusura}</p>
      <div class="pulsanti">
        <a class="pulsante primario" href={`${localizedPath(lang, '/')}#parliamone`}>{prenotaMezzora}</a>
        <a class="pulsante secondario" href="https://wa.me/393467202432" rel="noopener">{t.etichettaWhatsapp}</a>
      </div>
    </div>
  </section>

<style>
  .container {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 24px;
  }

  /* --- intestazione --- */
  .intestazione {
    padding: 0;
  }
  .intestazione .container {
    padding: 72px 24px 44px;
  }
  /* TestataPagina riproduce il caso maggioritario (22ch): qui la tavola
     vuole 24ch, uno scarto minore, quindi resta come override — solo da
     641px in su (vedi la nota gemella in servizi.astro: sotto i 640px
     ci pensa già il componente ad azzerare max-width). */
  @media (min-width: 641px) {
    .intestazione :global(h1) {
      max-width: 24ch;
    }
  }

  /* --- riquadro AI Act --- */
  .avviso-ai-act {
    padding: 0;
  }
  .avviso-ai-act .container {
    padding: 0 24px 56px;
  }
  .riquadro {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    padding: 30px 34px;
    max-width: 860px;
  }
  .riquadro-label {
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--azione);
    font-weight: 700;
  }
  .riquadro-corpo {
    margin-top: 14px;
    font-size: 16.5px;
    line-height: 1.65;
    color: var(--text);
  }
  .riquadro-corpo.muto {
    color: var(--text-muted);
  }
  .riquadro-link {
    display: inline-block;
    margin-top: 18px;
    font-size: 15px;
    font-weight: 600;
  }

  /* --- i tre formati --- */
  .elenco-formati {
    padding: 0;
  }
  .elenco-formati .container {
    padding: 0 24px 72px;
  }
  .schede {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .formato {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 34px;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 40px;
  }
  .formato .eyebrow {
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--azione);
    font-weight: 700;
  }
  .formato .descrizione h2 {
    font-size: 26px;
    margin-top: 12px;
  }
  .formato .descrizione .corpo {
    margin-top: 14px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-muted);
  }
  .formato .dettagli {
    border-left: 1px solid var(--border);
    padding-left: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .formato .dettaglio-etichetta {
    font-size: 11.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--azione);
    font-weight: 700;
  }
  .formato .dettaglio-valore {
    margin-top: 6px;
    font-size: 14.5px;
    line-height: 1.6;
  }

  /* --- come si organizza --- */
  .come-si-organizza {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding: 0;
  }
  .come-si-organizza .container {
    padding: 72px 24px;
  }
  .section-title {
    font-size: 30px;
    margin-top: 18px;
    margin-bottom: 34px;
    max-width: 26ch;
  }
  .griglia-strade {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  .griglia-strade h3 {
    font-size: 19px;
  }
  .griglia-strade .corpo {
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  /* --- vengo dall'aula / che cosa non è --- */
  .aula-onesta {
    border-top: 1px solid var(--border);
    padding: 0;
  }
  .aula-onesta .container {
    padding: 72px 24px;
  }
  .colonne {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
  }
  .colonne .section-title {
    font-size: 28px;
    margin-bottom: 0;
    max-width: 22ch;
  }
  .colonne .corpo {
    margin-top: 18px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-muted);
  }
  .colonne .righe {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 18px;
  }
  .colonne .righe .corpo {
    margin-top: 0;
  }

  /* --- raccontami che azienda siete --- */
  .cta-azienda {
    border-top: 1px solid var(--border);
    background: var(--accent);
    padding: 0;
  }
  .cta-azienda .container {
    padding: 60px 24px;
  }
  .cta-azienda h2 {
    font-size: 30px;
    color: var(--surface);
    max-width: 26ch;
  }
  .cta-azienda .intro {
    margin-top: 16px;
    font-size: 16px;
    line-height: 1.6;
    color: #cdd9e6;
    max-width: 56ch;
  }
  .pulsanti {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 30px;
    flex-wrap: wrap;
  }
  .pulsante.primario {
    background: var(--surface);
    color: var(--accent);
    font-size: 15px;
    font-weight: 600;
    padding: 14px 30px;
    border-radius: var(--radius);
  }
  .pulsante.secondario {
    font-size: 15px;
    color: var(--surface);
    border: 1px solid #6d8aa8;
    border-radius: var(--radius);
    padding: 13px 24px;
  }

  @media (max-width: 640px) {
    .intestazione .container {
      padding: 44px 20px 36px;
    }
    .avviso-ai-act .container {
      padding: 0 20px 40px;
    }
    .riquadro {
      padding: 24px 22px;
    }
    .elenco-formati .container {
      padding: 0 20px 48px;
    }
    .formato {
      grid-template-columns: 1fr;
      gap: 22px;
      padding: 26px 22px;
    }
    .formato .descrizione h2 {
      font-size: 23px;
    }
    .formato .dettagli {
      border-left: none;
      padding-left: 0;
      padding-top: 20px;
      border-top: 1px solid var(--border);
    }
    .come-si-organizza .container,
    .aula-onesta .container {
      padding: 48px 20px;
    }
    .section-title {
      font-size: 24px;
      margin-bottom: 24px;
      max-width: none;
    }
    .griglia-strade {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .colonne {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .colonne .section-title {
      font-size: 24px;
      max-width: none;
    }
    .cta-azienda .container {
      padding: 44px 20px;
    }
    .cta-azienda h2 {
      font-size: 24px;
      max-width: none;
    }
    .cta-azienda .intro {
      font-size: 15px;
      max-width: none;
    }
    .pulsanti {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }
    .pulsanti a {
      text-align: center;
    }
  }
</style>
