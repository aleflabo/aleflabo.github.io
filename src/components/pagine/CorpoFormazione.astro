---
// src/components/pagine/CorpoFormazione.astro — il corpo di /formazione e di
// /en/training nel Laboratorio (spec formazione 2026-11-08, mockup «A ·
// Formazione»). Due famiglie di corsi, «cosa resta», la policy come servizio a
// parte, le strade per pagare il corso, le FAQ sull'AI Act con le fonti.
// Ogni frase sulla norma porta il link alla sua fonte (src/data/fontiAiAct.ts),
// e src/lib/formazione.test.ts fallisce se una ne resta senza.
import TestataPagina from '../TestataPagina.astro';
import BloccoPolicy from '../sezioni/BloccoPolicy.astro';
import { localizedPath, type Locale } from '../../i18n/ui';
import type { TestiFormazionePagina } from '../../data/formazionePagina';
import type { Corso, DomandaAiAct, RiquadroAiAct, Strada, TestiCorsi } from '../../data/formazione';
import type { Policy } from '../../data/servizi';
import { fontiAiAct } from '../../data/fontiAiAct';

interface Props {
  lang: Locale;
  t: TestiFormazionePagina;
  corsi: Corso[];
  testiCorsi: TestiCorsi;
  riquadroAiAct: RiquadroAiAct;
  dettagliPratici: string[];
  cosaResta: string[];
  faqAiAct: DomandaAiAct[];
  policy: Policy;
  strade: Strada[];
  prenotaMezzora: string;
}
const { lang, t, corsi, testiCorsi, riquadroAiAct, dettagliPratici, cosaResta, faqAiAct, policy, strade, prenotaMezzora } = Astro.props;
const famiglie = (['azienda', 'tecnici'] as const).map((f) => ({ chiave: f, corsi: corsi.filter((c) => c.famiglia === f) }));
---

<section class="intestazione">
  <div class="container">
    <TestataPagina
      percorso={lang === 'it' ? '/formazione' : '/en/training'}
      titolo={t.titolo}
      introduzione={t.introduzione}
    />
  </div>
</section>

<section class="pratico">
  <div class="container mono">
    {dettagliPratici.map((p) => <span>{p}</span>)}
  </div>
</section>

<section class="avviso-ai-act">
  <div class="container">
    <div class="riquadro">
      <p class="riquadro-titolo">{riquadroAiAct.titolo}</p>
      {riquadroAiAct.corpo.map((p) => <p>{p}</p>)}
      <a class="fonte mono" href={fontiAiAct[riquadroAiAct.fonte].href} target="_blank" rel="noopener noreferrer">{testiCorsi.etichettaFonte} ↗</a>
    </div>
  </div>
</section>

{famiglie.map((f) => (
  <section class="famiglia">
    <div class="container">
      <h2 class="titolo-famiglia mono">{testiCorsi.famiglie[f.chiave]}</h2>
      {f.corsi.map((c) => (
        <div class="corso">
          <div class="nome">
            <h3>{c.nome}</h3>
            {c.livelli.length === 1 && <span class="durata mono">{c.livelli[0].durata}</span>}
          </div>
          <div class="livelli" style={`--n:${c.livelli.length}`}>
            {c.livelli.map((l) => (
              <div class="livello">
                {l.nome && <p class="lv mono">{testiCorsi.livelli[l.nome]} <span>{l.durata}</span></p>}
                <dl class="dati-mono">
                  <div><dt>{testiCorsi.perChi}</dt><dd>{l.perChi}</dd></div>
                  <div><dt>{testiCorsi.programma}</dt><dd><ol>{l.moduli.map((m) => <li>{m}</li>)}</ol></dd></div>
                </dl>
              </div>
            ))}
          </div>
          <p class="serve"><span class="mono">{testiCorsi.serveDaVoi}</span> {c.serveDaVoi}</p>
        </div>
      ))}
    </div>
  </section>
))}

<section class="cosa-resta">
  <div class="container">
    <h2 class="titolo-famiglia mono">{testiCorsi.titoloCosaResta}</h2>
    <div class="celle">
      {cosaResta.map((v) => <p>{v}</p>)}
    </div>
    <p class="nota mono">{testiCorsi.notaCosaResta}</p>
  </div>
</section>

<section class="policy-sez">
  <div class="container">
    <BloccoPolicy policy={policy} />
  </div>
</section>

<section class="come-si-organizza">
  <div class="container">
    <h2 class="section-title">{t.titoloOrganizza}</h2>
    <div class="celle">
      {strade.map((s) => (
        <div>
          <h3>{s.titolo}</h3>
          <p class="corpo">{s.testo}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="faq-ai-act">
  <div class="container">
    <h2 class="section-title">{testiCorsi.titoloFaq}</h2>
    <div class="domande">
      {faqAiAct.map((d) => (
        <div class="domanda">
          <h3>{d.domanda}</h3>
          <p>{d.risposta} <a class="fonte mono" href={fontiAiAct[d.fonte].href} target="_blank" rel="noopener noreferrer">{testiCorsi.etichettaFonte} ↗</a></p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="aula-onesta">
  <div class="container">
    <div class="colonne">
      <div>
        <h2 class="section-title">{t.titoloCattedra}</h2>
        {t.corpiCattedra.map((p) => <p class="corpo">{p}</p>)}
      </div>
      <div>
        <h2 class="section-title">{t.titoloOnesta}</h2>
        {t.corpiOnesta.map((p) => <p class="corpo">{p}</p>)}
      </div>
    </div>
  </div>
</section>

<section class="cta-azienda">
  <div class="container">
    <div>
      <h2>{t.titoloChiusura}</h2>
      <p class="intro">{t.introChiusura}</p>
    </div>
    <div class="pulsanti">
      <a class="primario" href={`${localizedPath(lang, '/')}#parliamone`}>{prenotaMezzora}</a>
      <a class="secondario" href="https://wa.me/393467202432" rel="noopener">{t.etichettaWhatsapp}</a>
    </div>
  </div>
</section>

<style>
  section { padding: 0; border-bottom: 1px solid var(--filo); }
  .container {
    max-width: var(--maxw-lab);
    margin: 0 auto;
    border-inline: 1px solid var(--filo);
    padding: 36px 28px;
  }
  .intestazione .container { padding-top: 48px; padding-bottom: 32px; }
  .pratico .container { padding-block: 14px; display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: 0.8125rem; color: var(--muto); }
  .pratico span + span::before { content: "·"; color: var(--rilevamento-testo); margin-right: 24px; }
  .riquadro {
    background: var(--bianco);
    border: 1px solid var(--filo);
    border-left: 3px solid var(--rilevamento-testo);
    border-radius: 6px;
    padding: 18px 20px;
    display: grid;
    gap: 10px;
    max-width: 72ch;
  }
  .riquadro-titolo { font-weight: 600; font-size: 1.0625rem; letter-spacing: -0.02em; }
  .riquadro p { line-height: 1.6; }
  .fonte { font-size: 0.75rem; color: var(--rilevamento-testo); white-space: nowrap; }
  .titolo-famiglia { font-size: 0.75rem; font-weight: 400; letter-spacing: 0; color: var(--muto); margin-bottom: 10px; }
  .corso { display: grid; grid-template-columns: 220px minmax(0, 1fr); border-top: 1px solid var(--filo); }
  .corso:last-child { border-bottom: 1px solid var(--filo); }
  .nome { padding: 22px 20px 22px 0; display: grid; gap: 6px; align-content: start; }
  .nome h3 { font-size: 1.5rem; letter-spacing: -0.035em; line-height: 1.05; }
  .durata { font-size: 0.78rem; font-weight: 500; color: var(--rilevamento-testo); }
  .livelli { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); border-left: 1px solid var(--filo); }
  .livello { padding: 22px 20px; min-width: 0; }
  .livello + .livello { border-left: 1px solid var(--filo); }
  .lv { font-size: 0.75rem; font-weight: 500; margin-bottom: 10px; }
  .lv span { color: var(--rilevamento-testo); margin-left: 8px; }
  ol { margin: 4px 0 0; padding-left: 18px; line-height: 1.5; }
  .serve { grid-column: 2; border-left: 1px solid var(--filo); border-top: 1px dashed var(--filo); padding: 12px 20px; font-size: 0.875rem; }
  .serve span { font-size: 0.72rem; color: var(--muto); margin-right: 8px; }
  .cosa-resta .celle p { color: var(--inchiostro); line-height: 1.5; }
  .nota { margin-top: 10px; font-size: 0.75rem; color: var(--muto); }
  .section-title { font-size: 1.625rem; margin-bottom: 18px; }
  .celle h3 { font-size: 1.0625rem; letter-spacing: -0.02em; margin-bottom: 6px; }
  .corpo { color: var(--muto); line-height: 1.6; }
  .corpo + .corpo { margin-top: 10px; }
  .domande { border-bottom: 1px solid var(--filo); }
  .domanda { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: 8px 32px; padding: 16px 0; border-top: 1px solid var(--filo); }
  .domanda h3 { font-size: 1rem; letter-spacing: -0.015em; }
  .domanda p { color: var(--muto); font-size: 0.9375rem; line-height: 1.6; }
  .colonne { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .cta-azienda .container { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 28px; }
  .cta-azienda h2 { font-size: 1.625rem; }
  .cta-azienda .intro { margin-top: 6px; color: var(--muto); max-width: 52ch; }
  .pulsanti { display: flex; flex-wrap: wrap; gap: 10px; }
  .pulsanti a { font-weight: 500; font-size: 0.875rem; padding: 12px 18px; border-radius: var(--raggio-piccolo); min-height: 44px; display: inline-flex; align-items: center; }
  .primario { background: var(--rilevamento-testo); color: var(--bianco); }
  .secondario { border: 1px solid var(--filo); background: var(--bianco); color: var(--inchiostro); }
  @media (max-width: 820px) {
    .container { padding: 28px 16px; }
    .corso { grid-template-columns: 1fr; }
    .nome { padding-right: 0; }
    .livelli { grid-template-columns: 1fr; border-left: 0; }
    .livello { padding-inline: 0; }
    .livello + .livello { border-left: 0; border-top: 1px solid var(--filo); }
    .serve { grid-column: 1; border-left: 0; padding-inline: 0; }
    .domanda, .colonne { grid-template-columns: 1fr; }
  }
</style>
