---
// src/components/pagine/CorpoChiSono.astro — il corpo di /chi-sono e della
// gemella /en/about.
//
// Le due pagine portavano 223 righe di stile che differivano in **una regola
// sola**: `.segnaposto-nota`, che serve alla nota sulla fotografia — presente
// in italiano, assente in inglese perché quella nota è un'istruzione al
// committente e la tavola dice che non va tradotta. Il resto delle dieci
// righe di scarto erano commenti.
//
// La regola resta nel foglio unico: non fa danni dove l'elemento non c'è, e
// tenerla qui evita di far divergere di nuovo i due stili.
import FotoPosa from '../lab/FotoPosa.astro';
import { homeLab } from '../../data/homeLab';
import TestataPagina from '../TestataPagina.astro';
import { localizedPath, type Locale } from '../../i18n/ui';
import type { TestiChiSonoPagina } from '../../data/chiSonoPagina';
import type { ChiSonoCopy } from '../../data/chiSono';

interface Props {
  lang: Locale;
  t: TestiChiSonoPagina;
  chiSono: ChiSonoCopy;
  hrefLavori: string;
}
const { lang, t, chiSono, hrefLavori } = Astro.props;
---

  <section class="biografia">
    <div class="container">
      <div class="griglia">
        <div class="colonna-foto">
          <FotoPosa etichettaCard={homeLab[lang].etichettaCard} etichettaPosa={homeLab[lang].etichettaPosa} suggerimento={homeLab[lang].suggerimentoFoto} />
          <div class="in-breve">
            <p class="titolo-in-breve mono">{t.labelInBreve}</p>
            {chiSono.inBreve.map((riga) => (
              <p class="riga-in-breve">{riga}</p>
            ))}
          </div>
        </div>

        <div class="colonna-bio">
          <TestataPagina percorso={lang === 'it' ? '/chi-sono' : '/en/about'} titolo={t.titolo} />
          <div class="paragrafi">
            {chiSono.paragrafi.map((p, i) => (
              <p class:list={['corpo', { primo: i === 0 }]}>{p}</p>
            ))}
          </div>
          <div class="cta-row">
            <a class="pulsante primaria" href={`${localizedPath(lang, '/')}#parliamone`}>{t.ctaPrimaria}</a>
            <a class="pulsante secondaria" href={t.hrefCv} download>{t.ctaCurriculum}</a>
            <a class="pulsante secondaria" href={localizedPath(lang, hrefLavori)}>{t.ctaLavori}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Le sezioni arrivate dalla home con il Laboratorio (spec 2026-11-08). */}
  <slot name="dopo-biografia" />

  <section class="abitudini">
    <div class="container">
      {/* Potatura degli occhielli: quattro su tre sezioni. «Come lavoro, in
          concreto» ripeteva il suo h2 «Abitudini che vale la pena sapere prima», e
          «Fuori dal lavoro» non ne aveva uno sotto — la sezione si riconosce dal
          contenuto. Resta «In breve», che non è un occhiello di sezione ma
          l'intestazione dell'elenco di fatti accanto al ritratto. */}
      {t.labelComeLavoro && <p class="label">{t.labelComeLavoro}</p>}
      <h2 class="section-title">{t.titoloAbitudini}</h2>
      <div class="griglia-abitudini">
        {chiSono.abitudini.map((a) => (
          <div>
            <h3>{a.titolo}</h3>
            <p class="corpo">{a.testo}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="fuori-dal-lavoro">
    <div class="container">
      {t.labelFuori && <p class="label">{t.labelFuori}</p>}
      <p class="corpo">{t.corpoFuori}</p>
    </div>
  </section>

<style>
  /* Chi sono nel Laboratorio: la stessa card con la posa della home, «in
     breve» in mono sotto, abitudini in celle (scheda «A · Pagine interne»). */
  section { padding: 0; border-bottom: 1px solid var(--filo); }
  .container {
    max-width: var(--maxw-lab);
    margin: 0 auto;
    border-inline: 1px solid var(--filo);
    padding: 36px 28px;
  }
  .biografia .container { padding: 0; }
  .griglia { display: grid; grid-template-columns: 300px minmax(0, 1fr); }
  .colonna-foto { padding: 36px 22px; border-right: 1px solid var(--filo); display: grid; align-content: start; gap: 22px; }
  .in-breve { display: grid; gap: 4px; font-family: var(--font-mono); font-size: 0.78rem; color: var(--muto); }
  .titolo-in-breve { color: var(--inchiostro); font-weight: 500; }
  .colonna-bio { padding: 48px 32px 40px; min-width: 0; }
  .paragrafi { margin-top: 20px; display: grid; gap: 14px; max-width: 64ch; }
  .corpo { line-height: 1.6; color: var(--muto); }
  .primo { color: var(--inchiostro); }
  .cta-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  .cta-row a {
    font-weight: 500;
    font-size: 0.875rem;
    padding: 11px 16px;
    border-radius: var(--raggio-piccolo);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .primaria { background: var(--rilevamento-testo); color: var(--bianco); }
  .secondaria { border: 1px solid var(--filo); background: var(--bianco); color: var(--inchiostro); }
  .secondaria:hover { border-color: var(--inchiostro); }
  .section-title { font-size: 1.625rem; margin-bottom: 18px; }
  .griglia-abitudini {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--filo);
    border-left: 1px solid var(--filo);
  }
  .griglia-abitudini > div { padding: 20px; border-right: 1px solid var(--filo); border-bottom: 1px solid var(--filo); }
  .griglia-abitudini h3 { font-size: 1.0625rem; letter-spacing: -0.02em; margin-bottom: 8px; }
  .griglia-abitudini .corpo { font-size: 0.9375rem; }
  .fuori-dal-lavoro .corpo { max-width: 66ch; }
  @media (max-width: 820px) {
    .container { padding: 28px 16px; }
    .griglia { grid-template-columns: 1fr; }
    .colonna-foto { border-right: 0; border-bottom: 1px solid var(--filo); padding: 28px 16px; }
    .colonna-bio { padding: 28px 16px; }
    .griglia-abitudini { grid-template-columns: 1fr; }
  }
</style>
