---
// La pagina dopo l'invio del modulo (/grazie, /en/thanks). Testi approvati l'8
// novembre 2026 (testi.md, «Modulo di contatto acceso»). Raggiungibile solo dal
// reindirizzo di Web3Forms: niente indice, niente sitemap.
interface Props { titolo: string; testo: string; link: { testo: string; href: string } }
const { titolo, testo, link } = Astro.props;
---

<section class="conferma">
  <div class="container">
    <h1>{titolo}</h1>
    <p class="testo">{testo}</p>
    <a class="link" href={link.href}>{link.testo}</a>
  </div>
</section>

<style>
  .conferma { padding: 0; border-bottom: 1px solid var(--filo); }
  .container {
    max-width: var(--maxw-lab);
    margin: 0 auto;
    border-inline: 1px solid var(--filo);
    padding: 72px 28px;
    display: grid;
    gap: 14px;
  }
  h1 { font-size: clamp(2.125rem, 5.4vw, 4rem); line-height: 0.98; letter-spacing: -0.05em; }
  .testo { color: var(--muto); font-size: 1.0625rem; max-width: 52ch; }
  .link { font-weight: 500; margin-top: 8px; }
  @media (max-width: 820px) { .container { padding: 48px 16px; } }
</style>
