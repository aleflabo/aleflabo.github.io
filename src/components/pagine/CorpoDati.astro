---
// src/components/pagine/CorpoDati.astro — il corpo di /i-vostri-dati e della
// gemella /en/your-data.
//
// Le due pagine portavano **277 righe di stile identiche riga per riga**,
// più lo stesso markup. Ora il corpo sta qui; il contenuto vero (risposta
// corta, situazioni, impegni) resta in src/data/dati.ts, e i testi che erano
// scritti dentro il markup in src/data/datiPagina.ts.
import TestataPagina from '../TestataPagina.astro';
import { localizedPath, type Locale } from '../../i18n/ui';
import type { TestiDatiPagina } from '../../data/datiPagina';
import type {
  QuelloCheNonPossoGarantirvi,
  RispostaCorta,
  Situazione,
  SuQuestoHoLavoratoDavvero,
} from '../../data/dati';

interface Props {
  lang: Locale;
  t: TestiDatiPagina;
  situazioniDati: Situazione[];
  rispostaCorta: RispostaCorta;
  quelloCheNonPossoGarantirvi: QuelloCheNonPossoGarantirvi;
  suQuestoHoLavoratoDavvero: SuQuestoHoLavoratoDavvero;
}
const {
  lang,
  t,
  situazioniDati,
  rispostaCorta,
  quelloCheNonPossoGarantirvi,
  suQuestoHoLavoratoDavvero,
} = Astro.props;
---

  <section class="intestazione">
    <div class="container">
      <TestataPagina
        percorso={lang === 'it' ? '/i-vostri-dati' : '/en/your-data'}
        titolo={t.titolo}
        introduzione={rispostaCorta.intro}
      />
    </div>
  </section>

  <section class="risposta-corta">
    <div class="container">
      <div class="riquadro">
        <p class="riquadro-label">{rispostaCorta.titolo}</p>
        <p class="riquadro-testo">{rispostaCorta.testo}</p>
        <p class="riquadro-nota">{rispostaCorta.nota}</p>
      </div>
    </div>
  </section>

  <section class="situazioni-intro">
    <div class="container">
      <h2 class="section-title">{t.titoloSituazioni}</h2>
      <p class="intro">{t.introSituazioni}</p>
    </div>
  </section>

  <section class="situazioni">
    <div class="container">
      <div class="elenco">
        {situazioniDati.map((s) => (
          <div class="scheda situazione">
            <span class="numero">{s.numero}</span>
            <div>
              <h3>{s.titolo}</h3>
              {s.corpo.map((p) => (
                <p class="corpo">{p}</p>
              ))}
              {s.punti && (
                <div class="punti">
                  {s.punti.map((punto) => (
                    <p class="punto"><strong>{punto.titolo}</strong> {punto.testo}</p>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="onesta">
    <div class="container">
      <div class="colonne">
        <div>
          {/* Potatura degli occhielli: quattro su sei sezioni. «Onestà» — lo stesso su
              tre pagine — e «Perché mi credete» cadono, i loro h2 («Quello che non posso
              garantirvi», «Su questo ho lavorato davvero») dicono già la stessa cosa.
              Resta «La risposta corta», che dice al lettore che può fermarsi lì. */}
          {t.labelOnesta && <p class="label">{t.labelOnesta}</p>}
          <h2 class="section-title">{quelloCheNonPossoGarantirvi.titolo}</h2>
          <div class="righe">
            {quelloCheNonPossoGarantirvi.punti.map((p) => (
              <p class="corpo">{p}</p>
            ))}
          </div>
        </div>
        <div>
          {t.labelCredete && <p class="label">{t.labelCredete}</p>}
          <h2 class="section-title">{suQuestoHoLavoratoDavvero.titolo}</h2>
          <div class="righe">
            {suQuestoHoLavoratoDavvero.corpo.map((p) => (
              <p class="corpo">{p}</p>
            ))}
          </div>
          <div class="link-row">
            {suQuestoHoLavoratoDavvero.link.map((l) => (
              <a class="link-rimando" href={localizedPath('it', l.href)}>{l.testo} <span class="freccia">&rarr;</span></a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="domanda-aperta">
    <div class="container">
      <div>
        <h2>{t.titoloDomanda}</h2>
        <p class="intro">{t.introDomanda}</p>
      </div>
      <a class="pulsante scrivimi" href={`${localizedPath(lang, "/")}#parliamone`}>{t.etichettaScrivimi}</a>
    </div>
  </section>

<style>
  /* «Che fine fanno i vostri dati» nel Laboratorio: la risposta corta in un
     riquadro chiaro (non più blu scuro), le situazioni a righe numerate — sono
     una sequenza vera di casi —, la chiusura sul fondo carta. */
  section { padding: 0; border-bottom: 1px solid var(--filo); }
  .container {
    max-width: var(--maxw-lab);
    margin: 0 auto;
    border-inline: 1px solid var(--filo);
    padding: 36px 28px;
  }
  .intestazione .container { padding-top: 48px; padding-bottom: 32px; }
  .riquadro {
    background: var(--bianco);
    border: 1px solid var(--filo);
    border-left: 3px solid var(--rilevamento-testo);
    border-radius: 6px;
    padding: 20px 22px;
    display: grid;
    gap: 10px;
    max-width: 72ch;
  }
  .riquadro-label { font-family: var(--font-mono); font-size: 0.75rem; color: var(--muto); }
  .riquadro-testo { font-size: 1.125rem; line-height: 1.5; letter-spacing: -0.01em; }
  .riquadro-nota { color: var(--muto); font-size: 0.9375rem; }
  .section-title { font-size: 1.625rem; margin-bottom: 10px; }
  .intro { color: var(--muto); max-width: 62ch; }
  .situazioni-intro { border-bottom: 0; }
  .situazioni-intro .container { padding-bottom: 8px; }
  .situazioni .container { padding-top: 8px; }
  .elenco { border-bottom: 1px solid var(--filo); }
  .situazione {
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr);
    gap: 18px;
    padding: 22px 0;
    border-top: 1px solid var(--filo);
  }
  .numero { font-family: var(--font-mono); font-size: 1.5rem; font-weight: 500; color: var(--rilevamento-testo); line-height: 1; }
  .situazione h3 { font-size: 1.1875rem; letter-spacing: -0.02em; margin-bottom: 8px; }
  .corpo { color: var(--muto); line-height: 1.6; max-width: 66ch; }
  .corpo + .corpo { margin-top: 10px; }
  .punti { display: grid; gap: 8px; margin-top: 12px; }
  .punto { color: var(--muto); font-size: 0.9375rem; line-height: 1.55; }
  .punto strong { color: var(--inchiostro); font-weight: 600; }
  .colonne { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .righe { display: grid; gap: 10px; }
  .link-row { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: 16px; font-weight: 500; font-size: 0.9375rem; }
  .domanda-aperta .container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 28px;
  }
  .domanda-aperta h2 { font-size: 1.625rem; }
  .domanda-aperta .intro { margin-top: 6px; }
  .scrivimi {
    background: var(--rilevamento-testo);
    color: var(--bianco);
    font-weight: 500;
    font-size: 0.875rem;
    padding: 12px 18px;
    border-radius: var(--raggio-piccolo);
  }
  @media (max-width: 820px) {
    .container { padding: 28px 16px; }
    .situazione { grid-template-columns: 1fr; gap: 6px; }
    .colonne { grid-template-columns: 1fr; }
  }
</style>
