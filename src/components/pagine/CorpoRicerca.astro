---
// src/components/pagine/CorpoRicerca.astro — il corpo di /ricerca e della sua
// gemella /en/research.
//
// Le due pagine avevano lo stesso markup e **249 righe di stile identiche
// riga per riga**: due copie da tenere allineate a mano, senza che nessuna
// verifica potesse accorgersi di una divergenza. Ora il corpo sta qui, i
// testi in src/data/ricerca.ts e src/data/en/ricerca.ts, e le pagine sono
// due gusci.
//
// `lang` serve solo a costruire il collegamento interno alla scheda Procedo:
// tutto il resto arriva dai testi.
import TestataPagina from '../TestataPagina.astro';
import { localizedPath, type Locale } from '../../i18n/ui';
import { arxivDi } from '../../data/pubblicazioni';
import type { TestiRicerca } from '../../data/ricerca';
import type { Pubblicazione } from '../../data/pubblicazioni';

interface Props {
  lang: Locale;
  t: TestiRicerca;
  pubblicazioni: Pubblicazione[];
  numeriFascia: { numero: string; etichetta: string }[];
}
const { lang, t, pubblicazioni, numeriFascia } = Astro.props;

const SCHOLAR = 'https://scholar.google.com/citations?user=HHDHIVoAAAAJ';
const GITHUB = 'https://github.com/aleflabo';
---

  <section class="intestazione">
    <div class="container">
      <TestataPagina
        percorso={lang === 'it' ? '/ricerca' : '/en/research'}
        titolo={t.titolo}
        introduzione={t.introduzione}
      />
    </div>
  </section>

  <section class="fascia-numeri">
    <div class="container">
      <div class="griglia-numeri">
        {numeriFascia.map((n) => (
          <div>
            <p class="valore">{n.numero}</p>
            <p class="etichetta">{n.etichetta}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cosa-centra">
    <div class="container">
      <div class="riquadro">
        {/* Potatura degli occhielli: due su cinque sezioni. Cade «Cosa c'entra con la
            tua azienda», e con lui se ne va una delle quattordici violazioni della
            regola del «voi» (`.claude/rules/copy-e-tono.md`) — senza scrivere copy
            nuova, che è il modo giusto di chiuderne una. */}
        {t.riquadroLabel && <p class="riquadro-label">{t.riquadroLabel}</p>}
        <p class="riquadro-corpo">{t.riquadroCorpo}</p>
        <p class="riquadro-corpo muto">{t.riquadroCorpoMuto}</p>
        <a class="riquadro-link" href={localizedPath(lang, t.hrefRiquadro)}>{t.riquadroLink} &rarr;</a>
      </div>
    </div>
  </section>

  <section class="elenco-pubblicazioni">
    <div class="container">
      <h2>{t.titoloPubblicazioni}</h2>
      <p class="intro-elenco">{t.introElenco}</p>
      <div class="righe">
        {pubblicazioni.map((p) => (
          <div class="riga">
            <span class="anno">{p.anno}</span>
            <div class="testo-riga">
              {/* Il titolo diventa un link quando la pubblicazione ha un
                  arXiv (src/data/pubblicazioni.ts). Prima le dieci voci non
                  ne avevano nessuno: la pagina che regge la credibilità
                  tecnica del sito citava dieci articoli senza dare modo di
                  verificarne uno. «arXiv» si scrive uguale nelle due lingue,
                  quindi non serve un'etichetta tradotta. */}
              <h3>
                {arxivDi(p.titolo) ? (
                  <a class="verso-arxiv" href={arxivDi(p.titolo)} target="_blank" rel="noopener noreferrer">
                    {p.titolo} <span class="arxiv">arXiv &#8599;</span>
                  </a>
                ) : (
                  p.titolo
                )}
              </h3>
              <p class="descrizione">{p.descrizione}</p>
            </div>
            <div class="metadati">
              <span class="sede">{p.sede}</span>
              <span class="metriche">{p.metriche}</span>
            </div>
          </div>
        ))}
      </div>
      <div class="link-esterni">
        <a href={SCHOLAR} target="_blank" rel="noopener noreferrer">{t.linkScholar} &rarr;</a>
        <a href={GITHUB} target="_blank" rel="noopener noreferrer">{t.linkGithub} &rarr;</a>
      </div>
    </div>
  </section>

  <section class="perche-il-codice">
    <div class="container">
      <h2>{t.titoloCodice}</h2>
      <p class="corpo">{t.corpoCodice}</p>
    </div>
  </section>

<style>
  /* Ricerca nel Laboratorio (mockup, scheda «A · Pagine interne»): numeri in
     mono a filo, pubblicazioni a righe con anno, titolo e sede in mono. */
  section { padding: 0; border-bottom: 1px solid var(--filo); }
  .container {
    max-width: var(--maxw-lab);
    margin: 0 auto;
    border-inline: 1px solid var(--filo);
    padding: 36px 28px;
  }
  .intestazione .container { padding-top: 48px; padding-bottom: 32px; }
  .fascia-numeri .container { padding: 0; }
  .griglia-numeri { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .griglia-numeri > div { padding: 20px 24px; border-right: 1px solid var(--filo); }
  .griglia-numeri > div:last-child { border-right: 0; }
  .valore { font-family: var(--font-mono); font-size: 2.125rem; font-weight: 500; letter-spacing: -0.04em; line-height: 1.1; }
  .etichetta { font-size: 0.8125rem; color: var(--muto); }
  .riquadro {
    background: var(--bianco);
    border: 1px solid var(--filo);
    border-left: 3px solid var(--rilevamento-testo);
    border-radius: 6px;
    padding: 18px 20px;
    display: grid;
    gap: 10px;
    max-width: 72ch;
  }
  .riquadro-label { font-family: var(--font-mono); font-size: 0.75rem; color: var(--muto); }
  .riquadro-corpo { line-height: 1.6; }
  .muto { color: var(--muto); }
  .riquadro-link { font-weight: 500; font-size: 0.9375rem; }
  h2 { font-size: 1.625rem; }
  .intro-elenco { margin-top: 6px; color: var(--muto); font-size: 0.9375rem; }
  .righe { margin-top: 16px; border-bottom: 1px solid var(--filo); }
  .riga {
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr) 210px;
    gap: 18px;
    padding: 16px 0;
    border-top: 1px solid var(--filo);
    align-items: baseline;
  }
  .anno { font-family: var(--font-mono); font-size: 0.75rem; color: var(--muto); }
  h3 { font-size: 1rem; letter-spacing: -0.015em; line-height: 1.35; font-weight: 600; }
  .verso-arxiv { color: inherit; }
  .verso-arxiv:hover { color: var(--rilevamento-testo); }
  .arxiv { font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 400; color: var(--rilevamento-testo); white-space: nowrap; }
  .descrizione { margin-top: 4px; font-size: 0.875rem; color: var(--muto); line-height: 1.5; }
  .metadati { display: grid; gap: 2px; text-align: right; font-family: var(--font-mono); font-size: 0.75rem; color: var(--muto); }
  .sede { color: var(--inchiostro); }
  .link-esterni { display: flex; flex-wrap: wrap; gap: 12px 26px; margin-top: 18px; font-weight: 500; font-size: 0.9375rem; }
  .corpo { margin-top: 10px; color: var(--muto); line-height: 1.6; max-width: 66ch; }
  @media (max-width: 820px) {
    .container { padding: 28px 16px; }
    .griglia-numeri { grid-template-columns: 1fr 1fr; }
    .griglia-numeri > div:nth-child(2) { border-right: 0; }
    .griglia-numeri > div:nth-child(-n + 2) { border-bottom: 1px solid var(--filo); }
    .riga { grid-template-columns: 1fr; gap: 4px; }
    .metadati { text-align: left; }
  }
</style>
