---
// src/components/pagine/CorpoRicerca.astro — il corpo di /ricerca e della sua
// gemella /en/research.
//
// Le due pagine avevano lo stesso markup e **249 righe di stile identiche
// riga per riga**: due copie da tenere allineate a mano, senza che nessuna
// verifica potesse accorgersi di una divergenza. Ora il corpo sta qui, i
// testi in src/data/ricerca.ts e src/data/en/ricerca.ts, e le pagine sono
// due gusci.
//
// `lang` serve solo a costruire il collegamento interno alla scheda Procedo:
// tutto il resto arriva dai testi.
import TestataPagina from '../TestataPagina.astro';
import { localizedPath, type Locale } from '../../i18n/ui';
import type { TestiRicerca } from '../../data/ricerca';
import type { Pubblicazione } from '../../data/pubblicazioni';

interface Props {
  lang: Locale;
  t: TestiRicerca;
  pubblicazioni: Pubblicazione[];
  numeriFascia: { numero: string; etichetta: string }[];
}
const { lang, t, pubblicazioni, numeriFascia } = Astro.props;

const SCHOLAR = 'https://scholar.google.com/citations?user=HHDHIVoAAAAJ';
const GITHUB = 'https://github.com/aleflabo';
---

  <section class="intestazione">
    <div class="container">
      <TestataPagina
        occhiello={t.occhiello}
        titolo={t.titolo}
        introduzione={t.introduzione}
      />
    </div>
  </section>

  <section class="fascia-numeri">
    <div class="container">
      <div class="griglia-numeri">
        {numeriFascia.map((n) => (
          <div>
            <p class="valore">{n.numero}</p>
            <p class="etichetta">{n.etichetta}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cosa-centra">
    <div class="container">
      <div class="riquadro">
        <p class="riquadro-label">{t.riquadroLabel}</p>
        <p class="riquadro-corpo">{t.riquadroCorpo}</p>
        <p class="riquadro-corpo muto">{t.riquadroCorpoMuto}</p>
        <a class="riquadro-link" href={localizedPath(lang, t.hrefRiquadro)}>{t.riquadroLink} &rarr;</a>
      </div>
    </div>
  </section>

  <section class="elenco-pubblicazioni">
    <div class="container">
      <h2>{t.titoloPubblicazioni}</h2>
      <p class="intro-elenco">{t.introElenco}</p>
      <div class="righe">
        {pubblicazioni.map((p) => (
          <div class="riga">
            <span class="anno">{p.anno}</span>
            <div class="testo-riga">
              <h3>{p.titolo}</h3>
              <p class="descrizione">{p.descrizione}</p>
            </div>
            <div class="metadati">
              <span class="sede">{p.sede}</span>
              <span class="metriche">{p.metriche}</span>
            </div>
          </div>
        ))}
      </div>
      <div class="link-esterni">
        <a href={SCHOLAR} target="_blank" rel="noopener noreferrer">{t.linkScholar} &rarr;</a>
        <a href={GITHUB} target="_blank" rel="noopener noreferrer">{t.linkGithub} &rarr;</a>
      </div>
    </div>
  </section>

  <section class="perche-il-codice">
    <div class="container">
      <h2>{t.titoloCodice}</h2>
      <p class="corpo">{t.corpoCodice}</p>
    </div>
  </section>

<style>
  .container {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 24px;
  }

  /* --- intestazione --- */
  .intestazione {
    padding: 0;
  }
  .intestazione .container {
    padding: 72px 24px 40px;
  }
  /* TestataPagina riproduce il caso maggioritario (62ch): qui la tavola
     vuole 64ch, uno scarto minore, quindi resta come override — solo da
     641px in su (vedi la nota gemella in servizi.astro: sotto i 640px
     ci pensa già il componente ad azzerare max-width). */
  @media (min-width: 641px) {
    .intestazione :global(.intro) {
      max-width: 64ch;
    }
  }

  /* --- fascia numeri --- */
  .fascia-numeri {
    padding: 0;
  }
  .fascia-numeri .container {
    padding: 0 24px 56px;
  }
  .griglia-numeri {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 30px 0;
  }
  .valore {
    font-family: var(--font-serif);
    font-size: 34px;
    font-weight: 600;
  }
  .etichetta {
    margin-top: 4px;
    font-size: 13.5px;
    color: var(--text-muted);
  }

  /* --- cosa c'entra con la tua azienda --- */
  .cosa-centra {
    padding: 0;
  }
  .cosa-centra .container {
    padding: 0 24px 60px;
  }
  .riquadro {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    padding: 32px 36px;
    max-width: 860px;
  }
  .riquadro-label {
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--azione);
    font-weight: 700;
  }
  .riquadro-corpo {
    margin-top: 14px;
    font-size: 17.5px;
    line-height: 1.65;
    color: var(--text);
  }
  .riquadro-corpo.muto {
    font-size: 16px;
    color: var(--text-muted);
  }
  .riquadro-link {
    display: inline-block;
    margin-top: 18px;
    font-size: 15px;
    font-weight: 600;
  }

  /* --- le pubblicazioni --- */
  .elenco-pubblicazioni {
    padding: 0;
  }
  .elenco-pubblicazioni .container {
    padding: 0 24px 24px;
  }
  .elenco-pubblicazioni h2 {
    font-size: 28px;
    margin-bottom: 12px;
  }
  .intro-elenco {
    font-size: 15px;
    color: var(--text-muted);
    margin-bottom: 24px;
  }
  .righe {
    display: flex;
    flex-direction: column;
  }
  .riga {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr) 260px;
    gap: 28px;
    padding: 26px 0;
    border-top: 1px solid var(--border);
    align-items: start;
  }
  .anno {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    color: var(--accent);
  }
  .testo-riga h3 {
    font-size: 19px;
    line-height: 1.3;
  }
  .descrizione {
    margin-top: 8px;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .metadati {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
    min-width: 0;
  }
  .sede {
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--azione);
    font-weight: 700;
  }
  .metriche {
    font-size: 13.5px;
    color: var(--text-muted);
  }
  .link-esterni {
    display: flex;
    gap: 28px;
    margin-top: 34px;
    flex-wrap: wrap;
  }
  .link-esterni a {
    font-size: 15px;
    font-weight: 600;
  }

  /* --- perché ogni articolo esce con il codice --- */
  .perche-il-codice {
    border-top: 1px solid var(--border);
    background: var(--surface);
    margin-top: 60px;
    padding: 0;
  }
  .perche-il-codice .container {
    padding: 60px 24px;
  }
  .perche-il-codice h2 {
    font-size: 26px;
    max-width: 26ch;
  }
  .perche-il-codice .corpo {
    margin-top: 16px;
    font-size: 16.5px;
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 62ch;
  }

  @media (max-width: 640px) {
    .intestazione .container {
      padding: 44px 20px 36px;
    }
    .fascia-numeri .container {
      padding: 0 20px 40px;
    }
    .griglia-numeri {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
      padding: 24px 0;
    }
    .valore {
      font-size: 28px;
    }
    .cosa-centra .container {
      padding: 0 20px 44px;
    }
    .riquadro {
      padding: 24px 22px;
    }
    .riquadro-corpo {
      font-size: 16.5px;
    }
    .riquadro-corpo.muto {
      font-size: 15px;
    }
    .elenco-pubblicazioni .container {
      padding: 0 20px 20px;
    }
    .elenco-pubblicazioni h2 {
      font-size: 24px;
    }
    .riga {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 22px 0;
    }
    .metadati {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px 16px;
    }
    .link-esterni {
      flex-direction: column;
      gap: 14px;
      margin-top: 26px;
    }
    .perche-il-codice {
      margin-top: 44px;
    }
    .perche-il-codice .container {
      padding: 44px 20px;
    }
    .perche-il-codice h2 {
      font-size: 22px;
      max-width: none;
    }
    .perche-il-codice .corpo {
      font-size: 15.5px;
      max-width: none;
    }
  }
</style>
