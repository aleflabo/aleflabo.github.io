---
// src/components/pagine/CorpoServizi.astro — il corpo di /servizi e della
// gemella /en/services.
//
// Le due pagine portavano **157 righe di stile identiche** e lo stesso
// markup. Il contenuto vero resta in src/data/servizi.ts; i testi che erano
// scritti dentro il markup stanno in src/data/serviziPagina.ts.
//
// `hrefLavori` è un parametro perché la rotta cambia nome fra le lingue:
// `/lavori` in italiano, `/work` in inglese — non basta prefissare.
import TestataPagina from '../TestataPagina.astro';
import SchedaIngaggio from '../sezioni/SchedaIngaggio.astro';
import Faq from '../sezioni/Faq.astro';
import { localizedPath, type Locale } from '../../i18n/ui';
import type { TestiServiziPagina } from '../../data/serviziPagina';
import type { Domanda, Ingaggio } from '../../data/servizi';

interface Props {
  lang: Locale;
  t: TestiServiziPagina;
  ingaggi: Ingaggio[];
  faq: Domanda[];
  perChiNonSono: string[];
  hrefLavori: string;
}
const { lang, t, ingaggi, faq, perChiNonSono, hrefLavori } = Astro.props;
---

  <section class="intestazione">
    <div class="container">
      <TestataPagina
        percorso={lang === 'it' ? '/servizi' : '/en/services'}
        titolo={t.titolo}
        introduzione={t.introduzione}
      />
    </div>
  </section>

  {/* Le sezioni arrivate dalla home con il Laboratorio (spec 2026-11-08). */}
  <slot name="apertura" />

  <section class="elenco-ingaggi">
    <div class="container">
      <div class="schede">
        {ingaggi.map((ingaggio) => (
          <SchedaIngaggio
            ingaggio={ingaggio}
            etichettaPerChi={t.etichettaPerChi}
            etichettaQuantoDura={t.etichettaQuantoDura}
            etichettaCosaResta={t.etichettaCosaResta}
          />
        ))}
      </div>
      <a class="continua" href={localizedPath(lang, hrefLavori)}>{t.linkLavori} <span class="freccia">&rarr;</span></a>
    </div>
  </section>

  <section class="per-chi-non-sono">
    <div class="container">
      {/* Potatura degli occhielli: tre su cinque sezioni. Cadono «Onestà», sopra
          «Per chi non sono», e «Domande», sopra «Quelle che mi vengono fatte quasi
          sempre»: in tutti e due i casi l'h2 dice già cosa c'è sotto. */}
      {t.labelOnesta && <p class="label">{t.labelOnesta}</p>}
      <h2 class="section-title">{t.titoloOnesta}</h2>
      <div class="griglia">
        {perChiNonSono.map((riga) => (
          <p class="riga-testo">{riga}</p>
        ))}
      </div>
    </div>
  </section>

  <section class="domande">
    <div class="container">
      {t.labelDomande && <p class="label">{t.labelDomande}</p>}
      <h2 class="section-title">{t.titoloDomande}</h2>
      <Faq domande={faq} />
    </div>
  </section>

  <section class="come-si-comincia">
    <div class="container">
      <div>
        <h2>{t.titoloChiusura}</h2>
        <p class="intro">{t.introChiusura}</p>
      </div>
      <a class="pulsante cta" href={`${localizedPath(lang, '/')}#parliamone`}>{t.etichettaCta}</a>
    </div>
  </section>

<style>
  /* Servizi nel Laboratorio: ogni sezione nel foglio a filo da 1040px, niente
     fondi caldi né fasce scure (spec 2026-11-08, scheda «A · Pagine interne»). */
  section { padding: 0; border-bottom: 1px solid var(--filo); }
  .container {
    max-width: var(--maxw-lab);
    margin: 0 auto;
    border-inline: 1px solid var(--filo);
    padding: 36px 28px;
  }
  .intestazione .container { padding-top: 48px; padding-bottom: 32px; }
  .schede { border-bottom: 1px solid var(--filo); }
  .continua { display: inline-block; margin-top: 18px; font-weight: 500; font-size: 0.9375rem; }
  .section-title { font-size: 1.625rem; margin-bottom: 18px; }
  .griglia {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--filo);
    border-left: 1px solid var(--filo);
  }
  .riga-testo {
    padding: 18px 20px;
    border-right: 1px solid var(--filo);
    border-bottom: 1px solid var(--filo);
    color: var(--muto);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .come-si-comincia .container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 28px;
  }
  .come-si-comincia h2 { font-size: 1.625rem; }
  .come-si-comincia .intro { color: var(--muto); max-width: 52ch; margin-top: 6px; }
  .cta {
    background: var(--rilevamento-testo);
    color: var(--bianco);
    font-weight: 500;
    font-size: 0.875rem;
    padding: 12px 18px;
    border-radius: var(--raggio-piccolo);
  }
  @media (max-width: 820px) {
    .container { padding: 28px 16px; }
    .griglia { grid-template-columns: 1fr; }
  }
</style>
