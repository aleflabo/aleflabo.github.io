---
// src/components/pagine/CorpoServizi.astro — il corpo di /servizi e della
// gemella /en/services.
//
// Le due pagine portavano **157 righe di stile identiche** e lo stesso
// markup. Il contenuto vero resta in src/data/servizi.ts; i testi che erano
// scritti dentro il markup stanno in src/data/serviziPagina.ts.
//
// `hrefLavori` è un parametro perché la rotta cambia nome fra le lingue:
// `/lavori` in italiano, `/work` in inglese — non basta prefissare.
import TestataPagina from '../TestataPagina.astro';
import SchedaCompetenza from '../sezioni/SchedaCompetenza.astro';
import Faq from '../sezioni/Faq.astro';
import BloccoPolicy from '../sezioni/BloccoPolicy.astro';
import { localizedPath, type Locale } from '../../i18n/ui';
import type { TestiServiziPagina } from '../../data/serviziPagina';
import type { Competenza, Domanda, Policy } from '../../data/servizi';

interface Props {
  lang: Locale;
  t: TestiServiziPagina;
  competenze: Competenza[];
  faq: Domanda[];
  hrefLavori: string;
  policy: Policy;
}
const { lang, t, competenze, faq, hrefLavori, policy } = Astro.props;
const numero = (i: number) => String(i + 1).padStart(2, '0');
---

  <section class="intestazione">
    <div class="container">
      <TestataPagina
        percorso={lang === 'it' ? '/servizi' : '/en/services'}
        titolo={t.titolo}
        introduzione={t.introduzione}
      />
    </div>
  </section>

  {/* Le sezioni arrivate dalla home con il Laboratorio (spec 2026-11-08). */}
  <slot name="apertura" />

  {/* Le quattro competenze con l'indice fisso a sinistra: un riquadro di
      rilevamento, lo stesso segno della foto in home, segue la competenza che
      si sta leggendo (scelta del 2026-11-22, variante D). Senza JavaScript
      l'indice resta un elenco di link alle quattro schede, senza riquadro. */}
  <section class="elenco-competenze">
    <div class="container">
      <div class="rilievo" data-rilievo>
        <nav class="indice" aria-label={t.etichettaIndice}>
          <ol>
            {competenze.map((c, i) => (
              <li><a href={`#c-${c.chiave}`}><span class="mono numero">{numero(i)} · {c.etichetta}</span>{c.nome}</a></li>
            ))}
          </ol>
          <div class="riquadro" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
          <div class="avanzamento" aria-hidden="true"><span></span></div>
        </nav>
        <div class="schede">
          {competenze.map((c, i) => (
            <SchedaCompetenza
              competenza={c}
              numero={numero(i)}
              etichettaPerChi={t.etichettaPerChi}
              etichettaQuantoDura={t.etichettaQuantoDura}
              etichettaCosaResta={t.etichettaCosaResta}
              etichettaProve={t.etichettaProve}
            />
          ))}
        </div>
      </div>
      <a class="continua" href={localizedPath(lang, hrefLavori)}>{t.linkLavori} <span class="freccia">&rarr;</span></a>
    </div>
  </section>

  {/* Servizio a parte, dopo le quattro competenze e non come quinta. */}
  <section class="policy-sez">
    <div class="container">
      <BloccoPolicy policy={policy} />
    </div>
  </section>

  <section class="domande">
    <div class="container">
      {t.labelDomande && <p class="label">{t.labelDomande}</p>}
      <h2 class="section-title">{t.titoloDomande}</h2>
      <Faq domande={faq} />
    </div>
  </section>

  <section class="come-si-comincia">
    <div class="container">
      <div>
        <h2>{t.titoloChiusura}</h2>
        <p class="intro">{t.introChiusura}</p>
      </div>
      <a class="pulsante cta" href={`${localizedPath(lang, '/')}#parliamone`}>{t.etichettaCta}</a>
    </div>
  </section>

<style>
  /* Servizi nel Laboratorio: ogni sezione nel foglio a filo da 1040px, niente
     fondi caldi né fasce scure (spec 2026-11-08, scheda «A · Pagine interne»). */
  section { padding: 0; border-bottom: 1px solid var(--filo); }
  .container {
    max-width: var(--maxw-lab);
    margin: 0 auto;
    border-inline: 1px solid var(--filo);
    padding: 36px 28px;
  }
  .intestazione .container { padding-top: 48px; padding-bottom: 32px; }
  .schede { border-bottom: 1px solid var(--filo); }
  .rilievo { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 36px; }
  .indice { position: sticky; top: 104px; align-self: start; font-size: 0.8125rem; }
  .indice ol { margin: 0; padding: 0; list-style: none; }
  .indice a { display: block; padding: 12px 14px; color: var(--muto); text-decoration: none; transition: color 0.3s; }
  .indice .numero { display: block; font-size: 0.6875rem; }
  .indice li.attiva a { color: var(--inchiostro); }
  .indice li.attiva .numero { color: var(--rilevamento-testo); }
  /* Il riquadro esiste solo quando lo script l'ha posizionato (`.pronto`). */
  .riquadro {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    border: 1.5px solid var(--rilevamento);
    border-radius: 4px;
    pointer-events: none;
    transition: transform 0.5s cubic-bezier(0.22, 0.8, 0.3, 1), height 0.5s cubic-bezier(0.22, 0.8, 0.3, 1);
  }
  .riquadro::after {
    content: attr(data-etichetta);
    position: absolute;
    right: -1.5px;
    top: -20px;
    background: var(--rilevamento-testo);
    color: var(--bianco);
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 3px 3px 0 0;
    white-space: nowrap;
  }
  .riquadro i { position: absolute; width: 8px; height: 8px; border: 0 solid var(--rilevamento-testo); }
  .riquadro i:nth-child(1) { left: -4px; top: -4px; border-width: 2px 0 0 2px; }
  .riquadro i:nth-child(2) { right: -4px; top: -4px; border-width: 2px 2px 0 0; }
  .riquadro i:nth-child(3) { left: -4px; bottom: -4px; border-width: 0 0 2px 2px; }
  .riquadro i:nth-child(4) { right: -4px; bottom: -4px; border-width: 0 2px 2px 0; }
  .avanzamento { display: none; height: 2px; margin-top: 16px; background: var(--filo); border-radius: 2px; overflow: hidden; }
  .avanzamento span { display: block; height: 100%; background: var(--rilevamento); transform-origin: 0 50%; transform: scaleX(var(--avanzamento, 0)); }
  .indice { --avanzamento: 0; }
  .pronto .indice { position: sticky; }
  .pronto .riquadro, .pronto .avanzamento { display: block; }
  .pronto .indice ol { position: relative; }
  .pronto .riquadro { position: absolute; }
  /* Le schede non attive si attenuano solo con lo script attivo. */
  .pronto .schede :global(.competenza) { opacity: 0.45; transition: opacity 0.4s; }
  .pronto .schede :global(.competenza.attiva) { opacity: 1; }
  .continua { display: inline-block; margin-top: 18px; font-weight: 500; font-size: 0.9375rem; }
  .section-title { font-size: 1.625rem; margin-bottom: 18px; }
  .come-si-comincia .container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 28px;
  }
  .come-si-comincia h2 { font-size: 1.625rem; }
  .come-si-comincia .intro { color: var(--muto); max-width: 52ch; margin-top: 6px; }
  .cta {
    background: var(--rilevamento-testo);
    color: var(--bianco);
    font-weight: 500;
    font-size: 0.875rem;
    padding: 12px 18px;
    border-radius: var(--raggio-piccolo);
  }
  @media (max-width: 820px) {
    .container { padding: 28px 16px; }
    .rilievo { display: block; }
    .indice { display: none; }
    .pronto .schede :global(.competenza) { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .riquadro, .indice a, .pronto .schede :global(.competenza) { transition: none; }
  }
</style>

<script>
  // Il riquadro di rilevamento dell'indice. La competenza «attiva» è l'ultima
  // il cui bordo superiore ha passato il 40% dell'altezza dello schermo.
  // Una sola funzione, chiamata a ogni scroll in un requestAnimationFrame:
  // quattro schede, nessun bisogno di un observer per ciascuna.
  const rilievo = document.querySelector<HTMLElement>('[data-rilievo]');
  if (rilievo) {
    const schede = [...rilievo.querySelectorAll<HTMLElement>('.competenza')];
    const voci = [...rilievo.querySelectorAll<HTMLElement>('.indice li')];
    const riquadro = rilievo.querySelector<HTMLElement>('.riquadro')!;
    const indice = rilievo.querySelector<HTMLElement>('.indice')!;
    const contenitore = rilievo.querySelector<HTMLElement>('.schede')!;
    const ridotto = matchMedia('(prefers-reduced-motion: reduce)');

    // I tag di ogni scheda compaiono quando la scheda entra in vista.
    if (!ridotto.matches && 'IntersectionObserver' in window) {
      const osservatore = new IntersectionObserver((elenco) => {
        elenco.forEach((v) => {
          if (!v.isIntersecting) return;
          v.target.classList.remove('attende');
          osservatore.unobserve(v.target);
        });
      }, { threshold: 0.35 });
      schede.forEach((s) => { s.classList.add('attende'); osservatore.observe(s); });
    }

    let attiva = -1;
    let inAttesa = false;
    const aggiorna = () => {
      inAttesa = false;
      const linea = innerHeight * 0.4;
      let k = 0;
      schede.forEach((s, i) => { if (s.getBoundingClientRect().top < linea) k = i; });
      if (k !== attiva) {
        attiva = k;
        schede.forEach((s, i) => s.classList.toggle('attiva', i === k));
        voci.forEach((v, i) => v.classList.toggle('attiva', i === k));
        riquadro.dataset.etichetta = schede[k].dataset.etichetta ?? '';
      }
      const li = voci[k];
      riquadro.style.transform = `translateY(${li.offsetTop}px)`;
      riquadro.style.height = `${li.offsetHeight}px`;
      const r = contenitore.getBoundingClientRect();
      const p = Math.max(0, Math.min(1, (linea - r.top) / r.height));
      indice.style.setProperty('--avanzamento', p.toFixed(3));
    };
    const pianifica = () => { if (!inAttesa) { inAttesa = true; requestAnimationFrame(aggiorna); } };

    rilievo.classList.add('pronto');
    aggiorna();
    addEventListener('scroll', pianifica, { passive: true });
    addEventListener('resize', pianifica);
  }
</script>
