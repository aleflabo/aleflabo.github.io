---
// src/components/pagine/CorpoServizi.astro — il corpo di /servizi e della
// gemella /en/services.
//
// Le due pagine portavano **157 righe di stile identiche** e lo stesso
// markup. Il contenuto vero resta in src/data/servizi.ts; i testi che erano
// scritti dentro il markup stanno in src/data/serviziPagina.ts.
//
// `hrefLavori` è un parametro perché la rotta cambia nome fra le lingue:
// `/lavori` in italiano, `/work` in inglese — non basta prefissare.
import TestataPagina from '../TestataPagina.astro';
import SchedaIngaggio from '../sezioni/SchedaIngaggio.astro';
import Faq from '../sezioni/Faq.astro';
import { localizedPath, type Locale } from '../../i18n/ui';
import type { TestiServiziPagina } from '../../data/serviziPagina';
import type { Domanda, Ingaggio } from '../../data/servizi';

interface Props {
  lang: Locale;
  t: TestiServiziPagina;
  ingaggi: Ingaggio[];
  faq: Domanda[];
  perChiNonSono: string[];
  hrefLavori: string;
}
const { lang, t, ingaggi, faq, perChiNonSono, hrefLavori } = Astro.props;
---

  <section class="intestazione">
    <div class="container">
      <TestataPagina
        occhiello={t.occhiello}
        titolo={t.titolo}
        introduzione={t.introduzione}
      />
    </div>
  </section>

  <section class="elenco-ingaggi">
    <div class="container">
      <div class="schede">
        {ingaggi.map((ingaggio) => (
          <SchedaIngaggio
            ingaggio={ingaggio}
            etichettaPerChi={t.etichettaPerChi}
            etichettaQuantoDura={t.etichettaQuantoDura}
            etichettaCosaResta={t.etichettaCosaResta}
          />
        ))}
      </div>
      <a class="continua" href={localizedPath(lang, hrefLavori)}>{t.linkLavori} <span class="freccia">&rarr;</span></a>
    </div>
  </section>

  <section class="per-chi-non-sono">
    <div class="container">
      <p class="label">{t.labelOnesta}</p>
      <h2 class="section-title">{t.titoloOnesta}</h2>
      <div class="griglia">
        {perChiNonSono.map((riga) => (
          <p class="riga-testo">{riga}</p>
        ))}
      </div>
    </div>
  </section>

  <section class="domande">
    <div class="container">
      <p class="label">{t.labelDomande}</p>
      <h2 class="section-title">{t.titoloDomande}</h2>
      <Faq domande={faq} />
    </div>
  </section>

  <section class="come-si-comincia">
    <div class="container">
      <h2>{t.titoloChiusura}</h2>
      <p class="intro">{t.introChiusura}</p>
      <a class="pulsante cta" href={`${localizedPath(lang, '/')}#parliamone`}>{t.etichettaCta}</a>
    </div>
  </section>

<style>
  .container {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 24px;
  }

  /* --- intestazione --- */
  .intestazione {
    padding: 0;
  }
  .intestazione .container {
    padding: 72px 24px 44px;
  }
  /* TestataPagina riproduce il caso maggioritario (62ch): qui la tavola
     vuole 60ch, uno scarto minore, quindi resta come override — solo da
     641px in su, perché sotto i 640px il componente stesso azzera già
     max-width a "none" (@media nel componente): un override senza
     @media qui vincerebbe anche lì per specificità, sovrascrivendo
     quell'azzeramento e rompendo il mobile (bug trovato e corretto nel
     giro di correzioni 1, vedi task-1-report.md). */
  @media (min-width: 641px) {
    .intestazione :global(.intro) {
      max-width: 60ch;
    }
  }

  /* --- schede degli ingaggi --- */
  .elenco-ingaggi {
    padding: 0;
  }
  .elenco-ingaggi .container {
    padding: 0 24px 72px;
  }
  .schede {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .continua {
    display: inline-block;
    margin-top: 26px;
    font-size: 15px;
    font-weight: 600;
  }

  /* --- per chi non sono --- */
  .per-chi-non-sono {
    border-top: 1px solid var(--border);
    padding: 0;
  }
  .per-chi-non-sono .container {
    padding: 72px 24px;
  }
  .section-title {
    font-size: 32px;
    margin-top: 18px;
    margin-bottom: 30px;
    max-width: 24ch;
  }
  .griglia {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 44px;
    max-width: 900px;
  }
  .riga-testo {
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-muted);
  }

  /* --- domande --- */
  .domande {
    border-top: 1px solid var(--border);
    padding: 0;
  }
  .domande .container {
    padding: 72px 24px;
  }
  .domande .section-title {
    max-width: 30ch;
  }

  /* --- come si comincia --- */
  .come-si-comincia {
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding: 0;
  }
  .come-si-comincia .container {
    padding: 64px 24px;
  }
  .come-si-comincia h2 {
    font-size: 28px;
    max-width: 24ch;
  }
  .come-si-comincia .intro {
    margin-top: 18px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 58ch;
    text-wrap: pretty;
  }
  .come-si-comincia .cta {
    display: inline-block;
    margin-top: 30px;
    background: var(--azione);
    color: var(--surface);
    font-size: 15px;
    font-weight: 600;
    padding: 14px 28px;
    border-radius: var(--radius);
  }

  @media (max-width: 640px) {
    .intestazione .container {
      padding: 44px 20px 36px;
    }
    .elenco-ingaggi .container {
      padding: 0 20px 48px;
    }
    .schede {
      gap: 18px;
    }
    .per-chi-non-sono .container,
    .domande .container {
      padding: 48px 20px;
    }
    .section-title {
      font-size: 26px;
      margin-bottom: 20px;
      max-width: none;
    }
    .griglia {
      grid-template-columns: 1fr;
      gap: 18px;
      max-width: none;
    }
    .come-si-comincia .container {
      padding: 44px 20px;
    }
    .come-si-comincia h2 {
      font-size: 24px;
      max-width: none;
    }
    .come-si-comincia .intro {
      font-size: 15.5px;
      max-width: none;
    }
    .come-si-comincia .cta {
      display: block;
      text-align: center;
    }
  }
</style>
