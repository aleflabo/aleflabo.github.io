---
// src/components/TestataPagina.astro — l'apertura di ogni pagina interna nel
// Laboratorio (spec 2026-11-08, scheda «A · Pagine interne»): il percorso in
// mono al posto dell'occhiello maiuscolo, il titolo grande, l'introduzione.
// Niente filetto rosso. `percorso` è il percorso della pagina senza dominio e
// senza barra finale («/servizi», «/en/services», «← /note»): è un'etichetta,
// non un link.
interface Props {
  percorso: string;
  titolo: string;
  introduzione?: string;
}
const { percorso, titolo, introduzione } = Astro.props;
---

<p class="percorso mono">{percorso}</p>
<h1>{titolo}</h1>
{introduzione && <p class="intro">{introduzione}</p>}

<style>
  .percorso { font-size: 0.78rem; color: var(--muto); }
  h1 {
    margin-top: 14px;
    font-size: clamp(2.125rem, 5.4vw, 4rem);
    line-height: 0.98;
    letter-spacing: -0.05em;
    max-width: 18ch;
  }
  .intro {
    margin-top: 18px;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--muto);
    max-width: 60ch;
    text-wrap: pretty;
  }
</style>
