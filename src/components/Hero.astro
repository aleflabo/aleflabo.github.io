---
import { site } from '../data/site';
import type { Locale } from '../i18n/ui';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const hero = site[lang].hero;

// "Co-Founder of Procedo" / "Co-Founder di Procedo" both end with the brand
// name, so split on it to turn just that mention into a link — keeps the
// credibility copy fully locale-driven instead of hardcoding an EN sentence.
const brand = 'Procedo';
const brandIndex = hero.credibility.lastIndexOf(brand);
const hasBrandLink = brandIndex >= 0;
const credibilityBefore = hasBrandLink ? hero.credibility.slice(0, brandIndex) : hero.credibility;
const credibilityAfter = hasBrandLink ? hero.credibility.slice(brandIndex + brand.length) : '';
---

<section class="hero">
  <div class="container">
    <p class="label">{hero.label}</p>
    <h1>{hero.name}</h1>
    <div class="divider"></div>
    <p class="tagline muted">{hero.tagline}</p>
    <div class="cta-row">
      <a class="btn-primary" href="#contact">{hero.ctaPrimary}</a>
      <a class="btn-secondary" href="#work">{hero.ctaSecondary}</a>
    </div>
    <p class="credibility muted">
      {hasBrandLink ? (
        <>
          {credibilityBefore}<a href="https://procederai.com" target="_blank" rel="noopener noreferrer">{brand}</a>{credibilityAfter}
        </>
      ) : (
        hero.credibility
      )}
    </p>
  </div>
</section>

<style>
  .hero {
    padding-top: 5.5rem;
    padding-bottom: 3.5rem;
  }
  h1 {
    margin-top: 1rem;
    font-size: clamp(2.6rem, 6vw, 4rem);
  }
  .divider {
    margin: 1.75rem 0;
  }
  .tagline {
    font-size: 1.15rem;
    line-height: 1.5;
    max-width: 34ch;
  }
  .cta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.75rem;
    margin-top: 2.25rem;
  }
  .btn-primary {
    background: var(--text);
    color: var(--surface);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.85rem 1.75rem;
    border-radius: var(--radius);
  }
  .btn-primary:hover {
    opacity: 0.85;
  }
  .btn-secondary {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .btn-secondary:hover {
    color: var(--accent);
  }
  .credibility {
    margin-top: 2.75rem;
    font-size: 0.9rem;
  }
  .credibility a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .credibility a:hover {
    color: var(--accent);
  }
</style>
