---
import { localizedPath, type Locale } from '../i18n/ui';
import { site } from '../data/site';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Locale;
  path: string;
  attiva?: string;
}
const { lang, path, attiva } = Astro.props;
const nav = site[lang].nav;

// Le sette voci del menu italiano: la `chiave` (per lo stato attivo) e la
// rotta sono fisse qui; il testo viene da site.it.menu (task 6), nello
// stesso ordine, così non si riscrive a mano in questo componente.
const rotteMenuIt: Array<{ chiave: string; rotta: string }> = [
  { chiave: 'servizi', rotta: '/servizi' },
  { chiave: 'formazione', rotta: '/formazione' },
  { chiave: 'lavori', rotta: '/lavori' },
  { chiave: 'ricerca', rotta: '/ricerca' },
  { chiave: 'chi-sono', rotta: '/chi-sono' },
  { chiave: 'note', rotta: '/note' },
];
const etichetteMenuIt = site.it.menu ?? [];
const menuIt = rotteMenuIt.map((voce, i) => ({ ...voce, etichetta: etichetteMenuIt[i] ?? '' }));
const nomeIt = site.it.hero.name;
// «Parliamone» è anche il titolo della sezione di contatto (site.it.contact.title):
// letto da lì invece di riscritto a mano, per non andare in deriva se cambia.
const parliamoneIt = site.it.contact.title;
---

<nav class="nav">
  <div class:list={['inner', lang === 'it' && 'it']}>
    {lang === 'it' ? (
      <>
        <a class="brand" href={localizedPath('it', '/')} aria-label={`${nomeIt} — home`}>{nomeIt}</a>
        <div class="links">
          {menuIt.map((voce) => (
            <a href={localizedPath('it', voce.rotta)} class:list={[voce.chiave === attiva && 'attiva']}>
              {voce.etichetta}
            </a>
          ))}
          <a class="cta pulsante" href={`${localizedPath('it', '/')}#parliamone`}>{parliamoneIt}</a>
          <LangSwitch lang={lang} path={path} />
        </div>
      </>
    ) : (
      <>
        <a class="brand" href={localizedPath('en', '/')} aria-label="Alessandro Flaborea — home">AF</a>
        <div class="links">
          <a href={`${localizedPath('en', '/')}#work`}>{nav.work}</a>
          <a href={`${localizedPath('en', '/')}#research`}>{nav.research}</a>
          <a href={`${localizedPath('en', '/')}#about`}>{nav.about}</a>
          <a class="cta" href={`${localizedPath('en', '/')}#contact`}>{nav.cta}</a>
          <LangSwitch lang={lang} path={path} />
        </div>
      </>
    )}
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .inner {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text);
  }
  .links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 1.5rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--text);
  }
  .links a {
    color: var(--text-muted);
  }
  .links a:hover {
    color: var(--text);
  }
  .links a.cta {
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--surface);
  }
  .links a.cta:hover {
    color: var(--surface);
    opacity: 0.9;
  }

  /* --- menu italiano: misure alla lettera da tavole/Main.dc.html --- */
  .inner.it {
    padding: 22px 24px;
  }
  .inner.it .brand {
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.01em;
  }
  .inner.it .links {
    gap: 24px;
    font-size: 14px;
  }
  .inner.it .links a {
    color: var(--text);
  }
  .inner.it .links a:hover {
    color: var(--azione);
  }
  .inner.it .links a.attiva {
    border-bottom: 2px solid var(--azione);
    font-weight: 600;
    padding-bottom: 2px;
  }
  .inner.it .links a.cta {
    background: transparent;
    color: var(--azione);
    border: 1px solid var(--azione);
    border-radius: var(--radius);
    padding: 8px 16px;
  }
  .inner.it .links a.cta:hover {
    color: var(--azione);
    opacity: 1;
  }

  @media (max-width: 640px) {
    .links {
      gap: 0.9rem;
      font-size: 0.8rem;
    }
    .links a.cta {
      padding: 0.35rem 0.6rem;
    }
    .inner.it .links {
      gap: 0.9rem;
      font-size: 0.8rem;
    }
  }

  @media (max-width: 400px) {
    .inner {
      flex-wrap: wrap;
      padding: 0.85rem 1rem;
    }
    .links {
      width: 100%;
      row-gap: 0.5rem;
      justify-content: center;
    }
  }
</style>
