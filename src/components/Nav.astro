---
import { localizedPath, type Locale } from '../i18n/ui';
import { site } from '../data/site';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Locale;
  // Percorso (relativo, senza dominio) verso la gemella di questa pagina
  // nell'altra lingua, se esiste — passato a LangSwitch. Assente su una
  // pagina senza equivalente nell'altra lingua: niente interruttore
  // (task 1/bloccante).
  hrefAltro?: string;
  attiva?: string;
}
const { lang, hrefAltro, attiva } = Astro.props;

// Le sette voci del menu italiano: la `chiave` (per lo stato attivo) e la
// rotta sono fisse qui; il testo viene da site.it.menu (task 6), nello
// stesso ordine, così non si riscrive a mano in questo componente.
const rotteMenuIt: Array<{ chiave: string; rotta: string }> = [
  { chiave: 'servizi', rotta: '/servizi' },
  { chiave: 'formazione', rotta: '/formazione' },
  { chiave: 'lavori', rotta: '/lavori' },
  { chiave: 'ricerca', rotta: '/ricerca' },
  { chiave: 'chi-sono', rotta: '/chi-sono' },
  { chiave: 'note', rotta: '/note' },
];
const etichetteMenuIt = site.it.menu ?? [];
const menuIt = rotteMenuIt.map((voce, i) => ({ ...voce, etichetta: etichetteMenuIt[i] ?? '' }));
const nomeIt = site.it.hero.name;

// Le sei voci del menu inglese, stesso schema di rotteMenuIt: la `chiave`
// (per lo stato attivo, uguale al valore di `attiva` passato da ogni
// pagina inglese) e la rotta sono fisse qui, nello stesso ordine di
// site.en.menu (task 9, sito-inglese) — prima il menu inglese portava a
// frammenti della home (`#work`, `#research`, `#about`) rimasti dal
// vecchio sito a una pagina sola: le sezioni con quegli id non esistono
// più da quando /en/ ha preso la struttura della home italiana.
const rotteMenuEn: Array<{ chiave: string; rotta: string }> = [
  { chiave: 'services', rotta: '/services' },
  { chiave: 'training', rotta: '/training' },
  { chiave: 'work', rotta: '/work' },
  { chiave: 'research', rotta: '/research' },
  { chiave: 'about', rotta: '/about' },
  { chiave: 'notes', rotta: '/notes' },
];
const etichetteMenuEn = site.en.menu ?? [];
const menuEn = rotteMenuEn.map((voce, i) => ({ ...voce, etichetta: etichetteMenuEn[i] ?? '' }));
// Il nome intero, non più «AF»: l'àncora ha già aria-label="Alessandro
// Flaborea — home", il testo visibile deve dire lo stesso nome (task
// finale, blocco 4).
const nomeEn = site.en.hero.name;

// Una sola lista per la lingua della pagina: le due testate avevano markup
// identico salvo voci e rotte, e due copie dello stesso stile sono già
// costate una sottolineatura doppia (CLAUDE.md, trappole).
const menu = lang === 'it' ? menuIt : menuEn;
// Il marchio del Laboratorio: il nome in minuscolo, col punto nel colore della
// detection. L'`aria-label` resta il nome scritto per intero.
const [marchioNome, ...marchioCognome] = site[lang].hero.name.toLowerCase().split(' ');

// Testo del pulsante di testata: `nav.cta` quando esiste (inglese, «Contact
// me»), altrimenti il titolo della sezione di contatto (italiano,
// «Parliamone» da `contact.title`) — un'unica espressione per entrambe le
// lingue, così ciascuna smette di tenere un valore morto nel campo che
// legge l'altra (task finale, blocco 5).
const ctaTesto = site[lang].nav.cta ?? site[lang].contact.title;

// Menu a scomparsa sotto i 720px (task: tavole/HomeMobile.dc.html).
// Le due etichette dell'aria-label — a riposo e ad aperto — sono nella
// lingua della pagina; il piccolo script in fondo le scambia leggendo
// questi due data-attribute, così resta lui stesso senza stringhe fisse.
const etichetteToggle =
  lang === 'it'
    ? { chiuso: 'Apri il menu di navigazione', aperto: 'Chiudi il menu di navigazione' }
    : { chiuso: 'Open navigation menu', aperto: 'Close navigation menu' };
---

<nav class="nav">
  <div class="inner">
    <a class="brand mono" href={localizedPath(lang, '/')} aria-label={`${lang === 'it' ? nomeIt : nomeEn} — home`}>{marchioNome}<b aria-hidden="true">.</b>{marchioCognome.join(' ')}</a>
    <button
      type="button"
      class="menu-toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="nav-links"
      aria-label={etichetteToggle.chiuso}
      data-label-chiuso={etichetteToggle.chiuso}
      data-label-aperto={etichetteToggle.aperto}
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
    <div class="links" id="nav-links">
      {menu.map((voce) => (
        <a href={localizedPath(lang, voce.rotta)} class:list={['voce', voce.chiave === attiva && 'attiva']} aria-current={voce.chiave === attiva ? 'page' : undefined}>
          {voce.etichetta}<span class="rotta mono" aria-hidden="true">{voce.rotta}</span>
        </a>
      ))}
      <a class="cta" href={`${localizedPath(lang, '/')}#parliamone`}>{ctaTesto}</a>
      <LangSwitch lang={lang} href={hrefAltro} />
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--carta) 88%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--filo);
  }
  .inner {
    max-width: var(--maxw-lab);
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand { font-size: 0.8125rem; font-weight: 500; letter-spacing: -0.02em; color: var(--inchiostro); }
  .brand b { color: var(--rilevamento-testo); font-weight: 500; }
  .links { display: flex; align-items: center; gap: 20px; font-size: 0.875rem; }
  .voce { position: relative; color: var(--muto); transition: color 0.2s; }
  .voce:hover { color: var(--inchiostro); }
  /* La voce attiva: sottolineatura che segue il testo (`text-decoration`, non
     un bordo, così resta attaccata alla parola anche quando su un touch la
     scatola del link è alta 44px). Una regola sola per le due lingue. */
  .voce.attiva {
    color: var(--inchiostro);
    text-decoration: underline;
    text-decoration-color: var(--rilevamento);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .rotta { display: none; }
  .cta {
    font-weight: 500;
    font-size: 0.8125rem;
    background: var(--inchiostro);
    color: var(--carta);
    padding: 8px 14px;
    border-radius: var(--raggio-piccolo);
    transition: opacity 0.2s;
  }
  .cta:hover { opacity: 0.88; }
  .cta:active { transform: translateY(1px); }

  /* Pulsante a due trattini: nascosto finché lo script non aggiunge
     `.js-ready` — senza JS il menu resta una riga che va a capo, sempre
     raggiungibile. */
  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    border: 1px solid var(--filo);
    border-radius: var(--raggio-piccolo);
    background: var(--bianco);
    cursor: pointer;
  }
  .menu-toggle span { display: block; width: 18px; height: 1.5px; background: var(--inchiostro); transition: transform 0.2s; }
  .nav.menu-open .menu-toggle { border-color: var(--inchiostro); }
  .nav.menu-open .menu-toggle span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .nav.menu-open .menu-toggle span:last-child { transform: translateY(-3.75px) rotate(-45deg); }

  @media (max-width: 720px) {
    .inner { padding: 12px 20px; }
    .nav.js-ready .inner { flex-wrap: wrap; }
    .nav.js-ready .menu-toggle { display: inline-flex; }
    .nav.js-ready .links {
      display: none;
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-top: 8px;
    }
    .nav.js-ready.menu-open .links { display: flex; }
    .nav.js-ready .voce {
      display: flex;
      justify-content: space-between;
      align-items: center;
      min-height: 48px;
      border-bottom: 1px solid var(--filo);
      font-size: 1.0625rem;
      letter-spacing: -0.02em;
      color: var(--inchiostro);
    }
    .nav.js-ready .voce.attiva { color: var(--rilevamento-testo); text-decoration: none; }
    .nav.js-ready .rotta { display: inline; font-size: 0.6875rem; color: var(--muto); }
    .nav.js-ready .cta {
      align-self: flex-start;
      margin-top: 16px;
      padding: 12px 16px;
      background: var(--rilevamento-testo);
      color: var(--bianco);
      font-size: 0.875rem;
    }
    /* :global sul tag perché LangSwitch è un componente a parte, con il suo
       scope-id: un selettore scoped normale non lo raggiungerebbe. */
    /* `block` + `align-content`, non `flex`: in un contenitore flex i tre
       <span> di «EN / IT» perdono gli spazi (CLAUDE.md, regola 8). Visto. */
    .nav.js-ready .links :global(.lang) { display: block; align-content: center; min-height: 44px; margin-top: 8px; }
  }

  /* Sopra i 720px, su touch, anche le voci in riga arrivano a 44px.
     `pointer: coarse` e non la larghezza: conta se tocca un dito.
     `inline-block` + `align-content` e non `inline-flex`, che rompeva gli
     spazi dentro «EN / IT» (CLAUDE.md, regola 8). */
  @media (pointer: coarse) and (min-width: 721px) {
    .links :global(a) {
      display: inline-block;
      min-height: 44px;
      align-content: center;
    }
  }

  /* Il marchio è un link di navigazione, non un link in linea: 44px su touch
     a qualsiasi larghezza. */
  @media (pointer: coarse) {
    .brand {
      display: inline-block;
      min-height: 44px;
      align-content: center;
    }
  }

  @media (max-width: 900px) and (min-width: 721px) {
    .links { gap: 14px; font-size: 0.8125rem; }
  }

  @media print {
    .menu-toggle { display: none !important; }
    .nav.js-ready .links { display: flex !important; }
  }
</style>

<script is:inline>
  (function () {
    var toggle = document.getElementById('nav-toggle');
    var nav = toggle ? toggle.closest('.nav') : null;
    if (!toggle || !nav) return;

    // Presente solo qui: se questo script non parte, `.js-ready` non
    // compare mai e il CSS sopra non nasconde niente (vedi commento
    // su .menu-toggle) — il menu resta quello di oggi, sempre raggiungibile.
    nav.classList.add('js-ready');

    function setOpen(open) {
      nav.classList.toggle('menu-open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      var label = toggle.getAttribute(open ? 'data-label-aperto' : 'data-label-chiuso');
      if (label) toggle.setAttribute('aria-label', label);
    }

    toggle.addEventListener('click', function () {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  })();
</script>
