---
import { localizedPath, type Locale } from '../i18n/ui';
import { frasePresentazione, site } from '../data/site';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const copy = site[lang];
const nome = copy.hero.name;
const piePagina = copy.piePagina ?? [];
const prenotaMezzora = copy.prenotaMezzora ?? '';

// Riga finale. La partita IVA non c'è ancora: finché non è aperta, la voce
// resta fuori invece di stare in pagina come «[DA INSERIRE]», che si leggeva
// su tutte e trentacinque le pagine. Quando arriva, si rimette qui —
// `testi-en.md` dice che in inglese si etichetta «VAT no.».
const rigaFinale: Record<Locale, string> = {
  it: '© 2026 Alessandro Flaborea',
  en: '© 2026 Alessandro Flaborea',
};

// Privacy e Cookie: testi-en.md le scrive «Privacy · Cookies» (plurale),
// testi.md «Privacy · Cookie» (singolare).
const legale: Record<Locale, { privacy: string; cookie: string; hrefPrivacy: string; hrefCookie: string }> = {
  it: {
    privacy: 'Privacy',
    cookie: 'Cookie',
    hrefPrivacy: localizedPath('it', '/privacy'),
    hrefCookie: localizedPath('it', '/cookie'),
  },
  en: {
    privacy: 'Privacy',
    cookie: 'Cookies',
    hrefPrivacy: localizedPath('en', '/privacy'),
    hrefCookie: localizedPath('en', '/cookies'),
  },
};

// Colonne del piè di pagina: il testo (titoli e voci) viene da
// site[lang].piePagina; qui viviamo solo la rotta o l'URL a cui ogni voce
// punta. Sdoppiata per lingua perché le etichette inglesi sono chiavi
// diverse dalle italiane, e le rotte di destinazione pure.
const rottePiePagina: Record<Locale, Record<string, string>> = {
  it: {
    Servizi: localizedPath('it', '/servizi'),
    Formazione: localizedPath('it', '/formazione'),
    'Che fine fanno i vostri dati': localizedPath('it', '/i-vostri-dati'),
    Lavori: localizedPath('it', '/lavori'),
    Ricerca: localizedPath('it', '/ricerca'),
    'Chi sono': localizedPath('it', '/chi-sono'),
    Note: localizedPath('it', '/note'),
    LinkedIn: 'https://www.linkedin.com/in/alessandro-flaborea',
    GitHub: 'https://github.com/aleflabo',
    'Google Scholar': 'https://scholar.google.com/citations?user=HHDHIVoAAAAJ',
    'English site': localizedPath('en', '/'),
  },
  en: {
    Services: localizedPath('en', '/services'),
    Training: localizedPath('en', '/training'),
    'Where your data ends up': localizedPath('en', '/your-data'),
    Work: localizedPath('en', '/work'),
    Research: localizedPath('en', '/research'),
    About: localizedPath('en', '/about'),
    Notes: localizedPath('en', '/notes'),
    LinkedIn: 'https://www.linkedin.com/in/alessandro-flaborea',
    GitHub: 'https://github.com/aleflabo',
    'Google Scholar': 'https://scholar.google.com/citations?user=HHDHIVoAAAAJ',
    'Italian site': localizedPath('it', '/'),
  },
};
const vociEsterne = new Set(['LinkedIn', 'GitHub', 'Google Scholar']);
const rotte = rottePiePagina[lang];
---

<footer class="footer-it">
  <div class="colonne">
    <div class="presentazione">
      <p class="nome">{nome}</p>
      <p class="frase">{frasePresentazione[lang]}</p>
      <a class="pulsante prenota" href={`${localizedPath(lang, '/')}#parliamone`}>{prenotaMezzora}</a>
    </div>
    {piePagina.map((colonna) => (
      <div class="colonna">
        <p class="titolo-colonna">{colonna.titolo}</p>
        {colonna.voci.map((voce) => {
          const href = rotte[voce] ?? '#';
          const esterno = vociEsterne.has(voce);
          return esterno ? (
            <a href={href} target="_blank" rel="noopener noreferrer">{voce}</a>
          ) : (
            <a href={href}>{voce}</a>
          );
        })}
      </div>
    ))}
  </div>
  <div class="barra">
    <span>{rigaFinale[lang]}</span>
    <div class="legale">
      <a href={legale[lang].hrefPrivacy}>{legale[lang].privacy}</a>
      <a href={legale[lang].hrefCookie}>{legale[lang].cookie}</a>
    </div>
  </div>
</footer>

<style>
  /* --- piè di pagina: misure alla lettera da tavole/Servizi.dc.html --- */
  .footer-it {
    border-top: 1px solid var(--border);
    background: var(--surface-warm);
  }
  .colonne {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 52px 24px 24px;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    gap: 40px;
  }
  .presentazione .nome {
    font-family: var(--font-serif);
    font-size: 19px;
    font-weight: 600;
  }
  .presentazione .frase {
    margin-top: 12px;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--text-muted);
    max-width: 34ch;
  }
  .presentazione .prenota {
    display: inline-block;
    margin-top: 18px;
    background: var(--azione);
    color: var(--surface);
    font-size: 14.5px;
    font-weight: 600;
    padding: 12px 22px;
    border-radius: var(--radius);
  }
  .colonna {
    display: flex;
    flex-direction: column;
  }
  .titolo-colonna {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--azione);
    font-weight: 700;
    margin-bottom: 10px;
  }
  .colonna a {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 2;
  }
  .colonna a:hover {
    color: var(--text);
  }
  .barra {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 20px 24px 34px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }
  .barra span {
    font-size: 13px;
    color: var(--text-faint);
  }
  .legale {
    display: flex;
    gap: 20px;
  }
  .legale a {
    font-size: 13px;
    color: var(--text-faint);
  }
  .legale a:hover {
    color: var(--text);
  }

  @media (max-width: 800px) {
    .colonne {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 480px) {
    .colonne {
      grid-template-columns: 1fr;
    }
  }
</style>
