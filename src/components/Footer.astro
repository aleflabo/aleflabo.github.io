---
import { site } from '../data/site';
import type { Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const contact = site[lang].contact;
const name = site[lang].hero.name;
---

<footer class="footer">
  <div class="inner">
    <p class="name">{name} &copy; 2026</p>
    <div class="links">
      <a href={`mailto:${contact.email}`}>Email</a>
      <a href="https://www.linkedin.com/in/alessandro-flaborea" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="https://github.com/aleflabo" target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: var(--bg);
  }
  .inner {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .links {
    display: flex;
    gap: 1.25rem;
  }
  .links a:hover {
    color: var(--text);
  }
</style>
