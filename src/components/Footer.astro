---
import { localizedPath, type Locale } from '../i18n/ui';
import { frasePresentazione, site } from '../data/site';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const copy = site[lang];
const nome = copy.hero.name;
const piePagina = copy.piePagina ?? [];
// Il marchio del Laboratorio, come nella barra (Nav.astro).
const [marchioNome, ...marchioCognome] = nome.toLowerCase().split(' ');

// Riga finale. La partita IVA non c'è ancora: finché non è aperta, la voce
// resta fuori invece di stare in pagina come «[DA INSERIRE]», che si leggeva
// su tutte e trentacinque le pagine. Quando arriva, si rimette qui —
// `testi-en.md` dice che in inglese si etichetta «VAT no.».
const rigaFinale: Record<Locale, string> = {
  it: '© 2026 Alessandro Flaborea',
  en: '© 2026 Alessandro Flaborea',
};

// Privacy e Cookie: testi-en.md le scrive «Privacy · Cookies» (plurale),
// testi.md «Privacy · Cookie» (singolare).
const legale: Record<Locale, { privacy: string; cookie: string; hrefPrivacy: string; hrefCookie: string }> = {
  it: {
    privacy: 'Privacy',
    cookie: 'Cookie',
    hrefPrivacy: localizedPath('it', '/privacy'),
    hrefCookie: localizedPath('it', '/cookie'),
  },
  en: {
    privacy: 'Privacy',
    cookie: 'Cookies',
    hrefPrivacy: localizedPath('en', '/privacy'),
    hrefCookie: localizedPath('en', '/cookies'),
  },
};

// Colonne del piè di pagina: il testo (titoli e voci) viene da
// site[lang].piePagina; qui viviamo solo la rotta o l'URL a cui ogni voce
// punta. Sdoppiata per lingua perché le etichette inglesi sono chiavi
// diverse dalle italiane, e le rotte di destinazione pure.
const rottePiePagina: Record<Locale, Record<string, string>> = {
  it: {
    Servizi: localizedPath('it', '/servizi'),
    Formazione: localizedPath('it', '/formazione'),
    'Che fine fanno i vostri dati': localizedPath('it', '/i-vostri-dati'),
    Lavori: localizedPath('it', '/lavori'),
    Ricerca: localizedPath('it', '/ricerca'),
    'Chi sono': localizedPath('it', '/chi-sono'),
    Note: localizedPath('it', '/note'),
    LinkedIn: 'https://www.linkedin.com/in/alessandro-flaborea',
    GitHub: 'https://github.com/aleflabo',
    'Google Scholar': 'https://scholar.google.com/citations?user=HHDHIVoAAAAJ',
    'English site': localizedPath('en', '/'),
  },
  en: {
    Services: localizedPath('en', '/services'),
    Training: localizedPath('en', '/training'),
    'Where your data ends up': localizedPath('en', '/your-data'),
    Work: localizedPath('en', '/work'),
    Research: localizedPath('en', '/research'),
    About: localizedPath('en', '/about'),
    Notes: localizedPath('en', '/notes'),
    LinkedIn: 'https://www.linkedin.com/in/alessandro-flaborea',
    GitHub: 'https://github.com/aleflabo',
    'Google Scholar': 'https://scholar.google.com/citations?user=HHDHIVoAAAAJ',
    'Italian site': localizedPath('it', '/'),
  },
};
const vociEsterne = new Set(['LinkedIn', 'GitHub', 'Google Scholar']);
const rotte = rottePiePagina[lang];
---

<footer class="footer-it">
  <div class="colonne">
    <div class="presentazione">
      <p class="nome mono">{marchioNome}<b aria-hidden="true">.</b>{marchioCognome.join(' ')}</p>
      <p class="frase">{frasePresentazione[lang]}</p>
    </div>
    {piePagina.map((colonna) => (
      <div class="colonna">
        <p class="titolo-colonna mono">{colonna.titolo}</p>
        {colonna.voci.map((voce) => {
          const href = rotte[voce] ?? '#';
          const esterno = vociEsterne.has(voce);
          return esterno ? (
            <a class="esterno" href={href} target="_blank" rel="noopener noreferrer">{voce}<span aria-hidden="true"> ↗</span></a>
          ) : (
            <a href={href}>{voce}</a>
          );
        })}
      </div>
    ))}
  </div>
  <div class="barra">
    <span>{rigaFinale[lang]}</span>
    <div class="legale">
      <a href={legale[lang].hrefPrivacy}>{legale[lang].privacy}</a>
      <a href={legale[lang].hrefCookie}>{legale[lang].cookie}</a>
    </div>
  </div>
</footer>

<style>
  /* Il piè di pagina del Laboratorio (mockup 2026-11-08, scheda «pezzi»):
     fondo carta, colonne a filo, marchio in mono. */
  .footer-it {
    border-top: 1px solid var(--filo);
    background: var(--carta);
  }
  .colonne {
    max-width: var(--maxw-lab);
    margin: 0 auto;
    padding: 40px 28px 20px;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) repeat(3, minmax(0, 1fr));
    gap: 28px;
    border-inline: 1px solid var(--filo);
  }
  .presentazione .nome { font-size: 0.875rem; font-weight: 500; }
  .presentazione .nome b { color: var(--rilevamento); font-weight: 500; }
  .presentazione .frase { margin-top: 8px; font-size: 0.875rem; line-height: 1.5; color: var(--muto); max-width: 34ch; }
  .colonna { display: flex; flex-direction: column; gap: 6px; }
  .titolo-colonna { font-size: 0.75rem; color: var(--muto); margin-bottom: 4px; }
  .colonna a { font-size: 0.875rem; color: var(--inchiostro); transition: color 0.2s; }
  .colonna a:hover { color: var(--rilevamento-testo); }
  .esterno span { color: var(--muto); }
  .barra {
    max-width: var(--maxw-lab);
    margin: 0 auto;
    padding: 16px 28px 26px;
    border-top: 1px solid var(--filo);
    border-inline: 1px solid var(--filo);
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muto);
  }
  .legale { display: flex; gap: 16px; }
  .legale a { color: var(--muto); text-decoration: underline; text-underline-offset: 3px; }
  .legale a:hover { color: var(--inchiostro); }

  /* Il piè di pagina era tredici dei quindici bersagli sotto i 44px che
     restavano a 390px, ed è l'ultimo debito della PR #32 su questo fronte:
     le voci delle colonne stavano a 28px (14px per interlinea 2) e Privacy
     e Cookie a 20,8. Nessuna delle due regole scritte altrove lo copriva —
     `global.css` parla di `main`, `Nav.astro` di `nav` — e lo script del
     telefono li riportava apposta invece di escluderli.

     Il costo è dichiarato: sedici pixel per voce, ~+190px di piè di pagina
     su un telefono. È il prezzo del bersaglio, e si paga solo dove c'è un
     dito. Il link «Procedo» dentro la frase di presentazione non è qui
     dentro: sta in un <p> di prosa, ed è esente per WCAG 2.5.8. */
  @media (pointer: coarse) {
    .colonna a,
    .legale a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }

  @media (max-width: 820px) {
    .colonne { grid-template-columns: repeat(2, minmax(0, 1fr)); padding-inline: 16px; }
    .presentazione { grid-column: 1 / -1; }
    .barra { padding-inline: 16px; }
  }
</style>
