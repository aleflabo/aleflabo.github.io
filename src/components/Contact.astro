---
import { site } from '../data/site';
import type { Locale } from '../i18n/ui';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const contact = site[lang].contact;
---

<section id="contact" class="contact">
  <div class="container">
    <h2 class="section-title">{contact.title}</h2>
    <p class="muted body">{contact.body}</p>
    <a class="btn-primary" href={`mailto:${contact.email}`}>{contact.email}</a>
    <div class="socials">
      <a href="https://www.linkedin.com/in/alessandro-flaborea" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="https://github.com/aleflabo" target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
  </div>
</section>

<style>
  .body {
    max-width: 60ch;
    font-size: 1.05rem;
    margin-bottom: 2.25rem;
  }
  .btn-primary {
    display: inline-block;
    background: var(--text);
    color: var(--surface);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1rem;
    padding: 0.95rem 2rem;
    border-radius: var(--radius);
  }
  .btn-primary:hover {
    opacity: 0.85;
  }
  .socials {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.75rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
  }
  .socials a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .socials a:hover {
    color: var(--accent);
  }
</style>
