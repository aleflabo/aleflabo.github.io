---
import WorkRow from './WorkRow.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';
import type { Locale } from '../i18n/ui';

interface Props { lang: Locale }
const { lang } = Astro.props;

// Sul lato inglese, i progetti `soloItaliano` (Portale ricambi, Tire Hub)
// non hanno un testo inglese approvato (§10 della spec): fuori dall'elenco
// (decisione nella revisione finale del ramo sito-italiano). Questo
// componente è usato solo con lang="en" (src/pages/en/index.astro), ma il
// filtro resta condizionato a `lang` nel caso venga riusato.
const sortedProjects = [...projects]
  .filter((p) => lang !== 'en' || !p.soloItaliano)
  .sort((a, b) => a.order - b.order);
---

<section id="work" class="work">
  <div class="container">
    <h2 class="label">{site[lang].workTitle}</h2>
    <div class="rows">
      {sortedProjects.map((project, i) => (
        <WorkRow project={project} lang={lang} index={i + 1} />
      ))}
    </div>
  </div>
</section>
