---
interface Props { label: string; }
const { label } = Astro.props;
---
<span class="chip">{label}</span>
<style>
  /* Etichetta in mono, come quelle delle righe dei lavori. */
  .chip { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--muto); border: 1px solid var(--filo); background: var(--bianco); padding: 3px 7px; border-radius: 4px; white-space: nowrap; }
</style>
